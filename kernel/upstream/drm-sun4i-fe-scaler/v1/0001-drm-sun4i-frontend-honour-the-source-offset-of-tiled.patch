From: "D.R.racer" <drracer@seznam.cz>
Date: Tue, 20 Oct 2026 06:39:43 +0200
Subject: [PATCH 1/3] drm/sun4i: frontend: honour the source offset of tiled
 semi-planar buffers
To: Chen-Yu Tsai <wens@kernel.org>,
    Maxime Ripard <mripard@kernel.org>
Cc: Jernej Skrabec <jernej.skrabec@gmail.com>,
    Samuel Holland <samuel@sholland.org>,
    Maarten Lankhorst <maarten.lankhorst@linux.intel.com>,
    Thomas Zimmermann <tzimmermann@suse.de>,
    David Airlie <airlied@gmail.com>,
    Simona Vetter <simona@ffwll.ch>,
    dri-devel@lists.freedesktop.org,
    Paul Kocialkowski <paulk@sys-base.io>,
    linux-arm-kernel@lists.infradead.org,
    linux-sunxi@lists.linux.dev,
    linux-kernel@vger.kernel.org

For DRM_FORMAT_MOD_ALLWINNER_TILED buffers the frontend start address is
the linear offset from drm_fb_dma_get_gem_addr(), and only the column of
the last pixel in the end tile (TB_OFF X1) is programmed. Any source not
starting at (0,0) is then read from the wrong tiles, e.g. when a video
player crops the source of a window that is partly off the screen.

For two-plane (semi-planar) tiled formats, program the start address of
each plane at the first row of the source inside its first tile, plus
the in-tile column and row (TB_OFF X0/Y0) and the end-tile column (X1),
the way the Allwinner 3.4 display driver does (de_fe.c,
DISP_MOD_MB_UV_COMBINED). Clear the tile offsets when a linear buffer
follows (their reset value), and the third plane's registers when a
semi-planar tiled one does. Three-plane tiled formats keep the old code.

Tested on a Cubieboard2 (A20) with Armbian's 6.18.56: synthetic tiled
NV12 test pictures on an overlay plane at source offsets x = 1, 33 and
y = 0, 1, 16, 32, 33, 34; the programmed addresses and tile offsets
(DRM debug log) match the expected values, the pictures show no
artefacts, and a single line at buffer row 16 reaches the top edge
exactly at y = 16. In daily use since with cedrus-decoded video on a
Cubietruck (A20) with 6.18.56. Not tested on other SoCs.

Fixes: 9042e3fb7e22 ("drm/sun4i: Add buffer stride and offset configuration for tiling mode")
Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/sun4i/sun4i_frontend.c | 62 ++++++++++++++++++++++++++
 drivers/gpu/drm/sun4i/sun4i_frontend.h |  3 ++
 2 files changed, 65 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun4i_frontend.c b/drivers/gpu/drm/sun4i/sun4i_frontend.c
index 5e9c4b97c..7fc734d1a 100644
--- a/drivers/gpu/drm/sun4i/sun4i_frontend.c
+++ b/drivers/gpu/drm/sun4i/sun4i_frontend.c
@@ -154,6 +154,38 @@ static bool sun4i_frontend_format_supports_tiling(uint32_t fmt)
 	}
 }
 
+/*
+ * Start address and in-tile offsets of the cropped source in one plane of a
+ * 32x32-tiled semi-planar buffer (DRM_FORMAT_MOD_ALLWINNER_TILED), as the
+ * Allwinner display driver programs them: the address points to the source's
+ * first row inside its first tile, the TB_OFF register gives the column and
+ * row inside that tile and the column of the last pixel in the end tile.
+ */
+static dma_addr_t sun4i_frontend_tiled_plane(struct drm_framebuffer *fb,
+					     struct drm_plane_state *state,
+					     unsigned int plane, u32 *tb_off)
+{
+	unsigned int hsub = plane ? fb->format->hsub : 1;
+	unsigned int vsub = plane ? fb->format->vsub : 1;
+	unsigned int cpp = fb->format->cpp[plane];
+	/* The input size (sun4i_frontend_update_coord) uses src_w/src_h too. */
+	unsigned int x = (state->src_x >> 16) / hsub * cpp;	/* bytes */
+	unsigned int y = (state->src_y >> 16) / vsub;
+	/* Rounded up and at least one sample, like the input size. */
+	unsigned int width = max(DIV_ROUND_UP(state->src_w >> 16, hsub), 1U) * cpp;
+	struct drm_gem_dma_object *gem = drm_fb_dma_get_gem_obj(fb, plane);
+	dma_addr_t addr = gem->dma_addr + fb->offsets[plane];
+
+	addr += fb->pitches[plane] * (y & ~31U) + ((y & 31) << 5) +
+		((x & ~31U) << 5);
+
+	*tb_off = SUN4I_FRONTEND_TB_OFF_X0(x & 31) |
+		  SUN4I_FRONTEND_TB_OFF_Y0(y & 31) |
+		  SUN4I_FRONTEND_TB_OFF_X1(((x & 31) + width - 1) & 31);
+
+	return addr;
+}
+
 void sun4i_frontend_update_buffer(struct sun4i_frontend *frontend,
 				  struct drm_plane *plane)
 {
@@ -164,6 +196,31 @@ void sun4i_frontend_update_buffer(struct sun4i_frontend *frontend,
 	dma_addr_t dma_addr;
 	bool swap;
 
+	if (fb->modifier == DRM_FORMAT_MOD_ALLWINNER_TILED &&
+	    fb->format->num_planes <= 2) {
+		u32 tb_off;
+
+		/* Semi-planar (NV12 and friends, e.g. from cedrus). */
+		for (unsigned int i = 0; i < fb->format->num_planes; i++) {
+			dma_addr = sun4i_frontend_tiled_plane(fb, state, i,
+							      &tb_off);
+			regmap_write(frontend->regs,
+				     SUN4I_FRONTEND_TB_OFF_REG(i), tb_off);
+			regmap_write(frontend->regs,
+				     SUN4I_FRONTEND_LINESTRD_REG(i),
+				     SUN4I_FRONTEND_LINESTRD_TILED(fb->pitches[i]));
+			regmap_write(frontend->regs,
+				     SUN4I_FRONTEND_BUF_ADDR_REG(i), dma_addr);
+			DRM_DEBUG_DRIVER("Tiled plane %u: address %pad, tile offsets %#x\n",
+					 i, &dma_addr, tb_off);
+		}
+		/* No third plane: clear what a previous format may have left. */
+		regmap_write(frontend->regs, SUN4I_FRONTEND_BUF_ADDR2_REG, 0);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_LINESTRD2_REG, 0);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_TB_OFF2_REG, 0);
+		return;
+	}
+
 	if (fb->modifier == DRM_FORMAT_MOD_ALLWINNER_TILED) {
 		unsigned int width = state->src_w >> 16;
 		unsigned int offset;
@@ -196,6 +253,11 @@ void sun4i_frontend_update_buffer(struct sun4i_frontend *frontend,
 				     SUN4I_FRONTEND_TB_OFF_X1(offset));
 		}
 	} else {
+		/* Tile offsets of a previous tiled buffer must not linger. */
+		regmap_write(frontend->regs, SUN4I_FRONTEND_TB_OFF0_REG, 0);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_TB_OFF1_REG, 0);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_TB_OFF2_REG, 0);
+
 		strides[0] = fb->pitches[0];
 
 		if (fb->format->num_planes > 1)
diff --git a/drivers/gpu/drm/sun4i/sun4i_frontend.h b/drivers/gpu/drm/sun4i/sun4i_frontend.h
index 61c240887..526335eec 100644
--- a/drivers/gpu/drm/sun4i/sun4i_frontend.h
+++ b/drivers/gpu/drm/sun4i/sun4i_frontend.h
@@ -25,10 +25,12 @@
 #define SUN4I_FRONTEND_BUF_ADDR0_REG		0x020
 #define SUN4I_FRONTEND_BUF_ADDR1_REG		0x024
 #define SUN4I_FRONTEND_BUF_ADDR2_REG		0x028
+#define SUN4I_FRONTEND_BUF_ADDR_REG(i)		(0x020 + 4 * (i))
 
 #define SUN4I_FRONTEND_TB_OFF0_REG		0x030
 #define SUN4I_FRONTEND_TB_OFF1_REG		0x034
 #define SUN4I_FRONTEND_TB_OFF2_REG		0x038
+#define SUN4I_FRONTEND_TB_OFF_REG(i)		(0x030 + 4 * (i))
 #define SUN4I_FRONTEND_TB_OFF_X1(x1)			((x1) << 16)
 #define SUN4I_FRONTEND_TB_OFF_Y0(y0)			((y0) << 8)
 #define SUN4I_FRONTEND_TB_OFF_X0(x0)			(x0)
@@ -36,6 +38,7 @@
 #define SUN4I_FRONTEND_LINESTRD0_REG		0x040
 #define SUN4I_FRONTEND_LINESTRD1_REG		0x044
 #define SUN4I_FRONTEND_LINESTRD2_REG		0x048
+#define SUN4I_FRONTEND_LINESTRD_REG(i)		(0x040 + 4 * (i))
 
 /*
  * In tiled mode, the stride is defined as the distance between the start of the
