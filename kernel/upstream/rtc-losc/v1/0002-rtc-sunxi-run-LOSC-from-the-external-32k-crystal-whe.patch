From 53876108cb5a361e67f1ace428eca7d61ac3358d Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Sat, 17 Oct 2026 15:57:50 +0200
Subject: [PATCH 2/4] rtc: sunxi: run LOSC from the external 32k crystal when
 present

The driver leaves the 32 kHz low-speed oscillator (LOSC) on the
internal RC oscillator, also on boards that have a 32.768 kHz crystal.
On a Cubietruck the RTC then runs 3.2 % slow (LOSC at about 31.7 kHz),
so a free-running RTC loses about 46 minutes a day; from the crystal
it runs at -28 ppm. Both were measured against an NTP-synced system
clock.

LOSC is also the clock behind the CLK_OUT_A/B pins, which boards use as
the 32 kHz low-power clock of their WiFi/Bluetooth module, so those get
the RC frequency as well.

Select the crystal when the device tree provides it, similar to what
the A31 RTC driver does. The value written leaves LOSC_CTRL at 0x9
(crystal, drive strength 2, all other control bits clear), which is
what the vendor 3.4 kernel leaves in the register. Only write it when
the register does not already hold that setting, to avoid needless
rewrites of a running oscillator (e.g. on a warm reboot). The hardware
falls back to the RC oscillator by itself when the crystal stops or
fails to start (LOSC_CTRL bit 13 then reads as set), so the RTC keeps
running, if inaccurately.

Tested on a Cubietruck (A20, 2 GiB) with 6.18.56: from a cold power-on
the driver selects the crystal (LOSC_CTRL 0x9), the RTC holds
ext_osc32k and runs at -28 ppm. Boards that do not reference the
crystal are unaffected.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/rtc/rtc-sunxi.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/rtc/rtc-sunxi.c b/drivers/rtc/rtc-sunxi.c
index 5cab9953c..e3a4e7b2a 100644
--- a/drivers/rtc/rtc-sunxi.c
+++ b/drivers/rtc/rtc-sunxi.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2013, Carlo Caione <carlo.caione@gmail.com>
  */
 
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/fs.h>
@@ -19,8 +20,17 @@
 #include <linux/types.h>
 
 #define SUNXI_LOSC_CTRL				0x0000
+#define SUNXI_LOSC_CTRL_KEY			(0x16aa << 16)
 #define SUNXI_LOSC_CTRL_RTC_HMS_ACC		BIT(8)
 #define SUNXI_LOSC_CTRL_RTC_YMD_ACC		BIT(7)
+#define SUNXI_LOSC_CTRL_EXT_GSM(x)		((x) << 2)	/* 2 bits */
+#define SUNXI_LOSC_CTRL_EXT_OSC			BIT(0)
+#define SUNXI_LOSC_CTRL_AUTO_SWT		BIT(14)
+#define SUNXI_LOSC_CTRL_SETTING_MASK		(SUNXI_LOSC_CTRL_AUTO_SWT | \
+						 SUNXI_LOSC_CTRL_EXT_GSM(3) | \
+						 SUNXI_LOSC_CTRL_EXT_OSC)
+#define SUNXI_LOSC_CTRL_SETTING			(SUNXI_LOSC_CTRL_EXT_GSM(2) | \
+						 SUNXI_LOSC_CTRL_EXT_OSC)
 
 #define SUNXI_RTC_YMD				0x0004
 
@@ -420,6 +430,7 @@ MODULE_DEVICE_TABLE(of, sunxi_rtc_dt_ids);
 static int sunxi_rtc_probe(struct platform_device *pdev)
 {
 	struct sunxi_rtc_dev *chip;
+	struct clk *ext_osc;
 	int ret;
 
 	chip = devm_kzalloc(&pdev->dev, sizeof(*chip), GFP_KERNEL);
@@ -453,6 +464,22 @@ static int sunxi_rtc_probe(struct platform_device *pdev)
 		return -ENODEV;
 	}
 
+	ext_osc = devm_clk_get_optional_enabled(&pdev->dev, NULL);
+	if (IS_ERR(ext_osc))
+		return dev_err_probe(&pdev->dev, PTR_ERR(ext_osc),
+				     "Could not get the external oscillator\n");
+
+	/*
+	 * Run LOSC from the external crystal, with the drive strength the
+	 * vendor kernel uses, and clear bit 14 like the vendor kernel does.
+	 * Leave the register alone if it already holds this setting, so a
+	 * warm reboot does not disturb an already running crystal.
+	 */
+	if (ext_osc && (readl(chip->base + SUNXI_LOSC_CTRL) &
+			SUNXI_LOSC_CTRL_SETTING_MASK) != SUNXI_LOSC_CTRL_SETTING)
+		writel(SUNXI_LOSC_CTRL_KEY | SUNXI_LOSC_CTRL_SETTING,
+		       chip->base + SUNXI_LOSC_CTRL);
+
 	/* clear the alarm count value */
 	writel(0, chip->base + SUNXI_ALRM_DHMS);
 
