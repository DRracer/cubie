From 7b709162b26903829d985231f75a7327484e4ecf Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Sat, 17 Oct 2026 15:57:50 +0200
Subject: [PATCH 4/4] ARM: dts: sun7i: cubietruck: run the RTC from the 32k
 crystal

The Cubietruck has a 32.768 kHz crystal on the A20's 32 kHz oscillator
pins. Hand it to the RTC so that it runs LOSC from it instead of from
the internal RC oscillator, which is 3.2 % slow on this board.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts b/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
index be9b31d0f..fcd9e04af 100644
--- a/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
+++ b/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
@@ -296,6 +296,10 @@ &reg_usb2_vbus {
 	status = "okay";
 };
 
+&rtc {
+	clocks = <&ext_osc32k>;
+};
+
 &spdif {
 	pinctrl-names = "default";
 	pinctrl-0 = <&spdif_tx_pin>;
-- 
