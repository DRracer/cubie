--- a/drivers/gpu/drm/sun4i/sun4i_framebuffer.c
+++ b/drivers/gpu/drm/sun4i/sun4i_framebuffer.c
@@ -32,6 +32,10 @@ void sun4i_framebuffer_init(struct drm_device *drm)
 	drm->mode_config.max_height = 8192;
