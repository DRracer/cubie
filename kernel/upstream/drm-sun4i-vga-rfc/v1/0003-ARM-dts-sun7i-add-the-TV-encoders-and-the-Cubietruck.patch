From 9e1c3db16b1bec9f3e1b10054403655a2f3d31f8 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Sun, 18 Oct 2026 16:10:30 +0200
Subject: [RFC PATCH 3/3] ARM: dts: sun7i: add the TV encoders and the
 Cubietruck VGA output
To: Chen-Yu Tsai <wens@kernel.org>,
    Maxime Ripard <mripard@kernel.org>,
    Jernej Skrabec <jernej.skrabec@gmail.com>,
    Samuel Holland <samuel@sholland.org>
Cc: Maarten Lankhorst <maarten.lankhorst@linux.intel.com>,
    Thomas Zimmermann <tzimmermann@suse.de>,
    David Airlie <airlied@gmail.com>,
    Simona Vetter <simona@ffwll.ch>,
    Rob Herring <robh@kernel.org>,
    Krzysztof Kozlowski <krzk+dt@kernel.org>,
    Conor Dooley <conor+dt@kernel.org>,
    Philipp Zabel <p.zabel@pengutronix.de>,
    dri-devel@lists.freedesktop.org,
    devicetree@vger.kernel.org,
    linux-arm-kernel@lists.infradead.org,
    linux-sunxi@lists.linux.dev,
    linux-kernel@vger.kernel.org

Add the A20's two TV encoders, each fed by channel 1 of the TCON with
the same index, disabled by default. VGA works without touching their
reset bits (as with the vendor driver), so no resets are given yet.

The Cubietruck has a VGA connector: TVOUT0-2 carry G, B and R from TV
encoder 0, PD26/PD27 carry HSYNC/VSYNC from TCON0 channel 1, and the
monitor's DDC is on I2C2. Describe it and enable the TV encoder.

Based on Chen-Yu Tsai's 2019 device tree work for the same board.

Tested on a Cubietruck (A20, 2 GiB) with 6.18.56. TV encoder 1 is
described but untested.

Link: https://github.com/wens/linux/tree/sun4i-drm-tve-vga-wip
Assisted-by: Claude:claude-opus-5-5
---
 .../dts/allwinner/sun7i-a20-cubietruck.dts    | 31 ++++++++++
 arch/arm/boot/dts/allwinner/sun7i-a20.dtsi    | 60 +++++++++++++++++++
 2 files changed, 91 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts b/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
index be9b31d0f..fdac0ae1d 100644
--- a/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
+++ b/arch/arm/boot/dts/allwinner/sun7i-a20-cubietruck.dts
@@ -72,6 +72,18 @@ hdmi_con_in: endpoint {
 		};
 	};
 
+	vga-connector {
+		compatible = "vga-connector";
+		label = "vga";
+		ddc-i2c-bus = <&i2c2>;
+
+		port {
+			vga_con_in: endpoint {
+				remote-endpoint = <&tve0_out_vga>;
+			};
+		};
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -235,6 +247,25 @@ &pio {
 	/* Pin outputs low power clock for WiFi and BT */
 	pinctrl-0 = <&clk_out_a_pin>;
 	pinctrl-names = "default";
+
+	/* VGA H/VSYNC, driven by TCON0 channel 1 */
+	lcd0_sync_pins: lcd0-sync-pins {
+		pins = "PD26", "PD27";
+		function = "lcd0";
+	};
+};
+
+/* VGA: TVOUT0-2 carry G, B and R */
+&tve0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&lcd0_sync_pins>;
+	status = "okay";
+};
+
+&tve0_out {
+	tve0_out_vga: endpoint {
+		remote-endpoint = <&vga_con_in>;
+	};
 };
 
 &pwm {
diff --git a/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi b/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
index 5f44f09c5..f7b054010 100644
--- a/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
@@ -402,6 +402,30 @@ mdio: mdio@1c0b080 {
 			#size-cells = <0>;
 		};
 
+		tve0: tv-encoder@1c0a000 {
+			compatible = "allwinner,sun4i-a10-tv-encoder";
+			reg = <0x01c0a000 0x1000>;
+			clocks = <&ccu CLK_AHB_TVE0>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					tve0_in_tcon0: endpoint {
+						remote-endpoint = <&tcon0_out_tve0>;
+					};
+				};
+
+				tve0_out: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
 		tcon0: lcd-controller@1c0c000 {
 			compatible = "allwinner,sun7i-a20-tcon0",
 				     "allwinner,sun7i-a20-tcon";
@@ -449,6 +473,12 @@ tcon0_out_hdmi: endpoint@1 {
 						remote-endpoint = <&hdmi_in_tcon0>;
 						allwinner,tcon-channel = <1>;
 					};
+
+					tcon0_out_tve0: endpoint@2 {
+						reg = <2>;
+						remote-endpoint = <&tve0_in_tcon0>;
+						allwinner,tcon-channel = <1>;
+					};
 				};
 			};
 		};
@@ -500,6 +530,12 @@ tcon1_out_hdmi: endpoint@1 {
 						remote-endpoint = <&hdmi_in_tcon1>;
 						allwinner,tcon-channel = <1>;
 					};
+
+					tcon1_out_tve1: endpoint@2 {
+						reg = <2>;
+						remote-endpoint = <&tve1_in_tcon1>;
+						allwinner,tcon-channel = <1>;
+					};
 				};
 			};
 		};
@@ -710,6 +746,30 @@ ahci: sata@1c18000 {
 			status = "disabled";
 		};
 
+		tve1: tv-encoder@1c1b000 {
+			compatible = "allwinner,sun4i-a10-tv-encoder";
+			reg = <0x01c1b000 0x1000>;
+			clocks = <&ccu CLK_AHB_TVE1>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					tve1_in_tcon1: endpoint {
+						remote-endpoint = <&tcon1_out_tve1>;
+					};
+				};
+
+				tve1_out: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
 		ehci1: usb@1c1c000 {
 			compatible = "allwinner,sun7i-a20-ehci", "generic-ehci";
 			reg = <0x01c1c000 0x100>;
-- 
