From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Tue, 20 Oct 2026 06:34:11 +0200
Subject: [PATCH] ARM: dts: sun7i: add the mixer processor

Add the 2D engine of the A20. Its module clock runs from pll-ddr-other
at up to 240 MHz like with the legacy 3.4 kernel; the video PLLs follow
the display modes. The user manual lists the MP interrupt as vector 78,
which is SPI 46.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm/boot/dts/allwinner/sun7i-a20.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi b/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
index 566023209..b098f8d79 100644
--- a/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun7i-a20.dtsi
@@ -1778,5 +1778,19 @@ be0_out_tcon1: endpoint@1 {
 				};
 			};
 		};
+
+		mixer-processor@1e80000 {
+			compatible = "allwinner,sun7i-a20-mixer-processor",
+				     "allwinner,sun4i-a10-mixer-processor";
+			reg = <0x01e80000 0x20000>;
+			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_AHB_MP>, <&ccu CLK_DE_MP>,
+				 <&ccu CLK_DRAM_MP>;
+			clock-names = "ahb", "mod", "ram";
+			resets = <&ccu RST_DE_MP>;
+			assigned-clocks = <&ccu CLK_DE_MP>;
+			assigned-clock-parents = <&ccu CLK_PLL_DDR_OTHER>;
+			assigned-clock-rates = <240000000>;
+		};
 	};
 };
