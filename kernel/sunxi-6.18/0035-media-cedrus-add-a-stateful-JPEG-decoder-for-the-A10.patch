+		return 0;
+	}
 	if (ret) {
-		v4l2_err(v4l2_dev, "failed to configure engine job: %d\n", ret);
+		/* -EBADMSG: a broken frame, reported through the buffer only. */
+		if (ret != -EBADMSG)
+			v4l2_err(v4l2_dev, "failed to configure engine job: %d\n",
+				 ret);
 		goto error_ctrl;
 	}
 
@@ -379,7 +513,7 @@ int cedrus_context_job_run(struct cedrus_context *ctx)
 	/* Schedule the global watchdog. */
 
 	schedule_delayed_work(&cedrus_dev->watchdog_work,
-			      msecs_to_jiffies(2000));
+			      cedrus_context_job_timeout(ctx));
 
 	/* Trigger engine job. */
 
