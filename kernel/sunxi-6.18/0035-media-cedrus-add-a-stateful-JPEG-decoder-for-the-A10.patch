+		return -EINVAL;
+	}
+
 	/* Also catches DMABUF imports the VE could not reach. */
 	if (!cedrus_dma_in_window(ctx->proc->dev,
 				  vb2_dma_contig_plane_dma_addr(vb2_buffer, 0),
@@ -578,9 +720,15 @@ static void cedrus_context_buffer_queue(struct vb2_buffer *vb2_buffer)
 	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
 
 	if (cedrus_proc_format_type(ctx->proc, vb2_buffer->type) ==
-	    CEDRUS_FORMAT_TYPE_CODED)
-		cedrus_engine_buffer_coded_queue(ctx,
-						 cedrus_buffer_from_vb2(vb2_buffer));
+	    CEDRUS_FORMAT_TYPE_CODED) {
+		struct cedrus_buffer *buffer = cedrus_buffer_from_vb2(vb2_buffer);
+
+		cedrus_engine_buffer_coded_queue(ctx, buffer);
+
+		if (ctx->proc->ops->buffer_coded_queue &&
+		    ctx->proc->ops->buffer_coded_queue(ctx, buffer))
+			return;
+	}
 
 	if (ctx->proc->stateful &&
 	    V4L2_TYPE_IS_CAPTURE(vb2_buffer->vb2_queue->type) &&
@@ -761,6 +909,10 @@ static int cedrus_context_queue_init(void *private, struct vb2_queue *src_queue,
 	src_queue->dma_attrs = CEDRUS_HW_BUF_ATTRS;
 	src_queue->drv_priv = ctx;
 
+	/* The kernel parses the bitstream through its own mapping. */
+	if (proc->coded_cpu_access)
+		src_queue->dma_attrs = 0;
+
 	/* Stateless decoding passes every frame's parameters in a request. */
 	src_queue->requires_requests = !proc->stateful;
 
@@ -798,6 +950,13 @@ int cedrus_context_setup(struct cedrus_proc *proc, struct cedrus_context *ctx,
 
 	ctx->proc = proc;
 	ctx->engine = proc->engines[0];
+	spin_lock_init(&ctx->state_lock);
+
+	if (proc->ops->context_setup) {
+		ret = proc->ops->context_setup(ctx);
+		if (ret)
+			return ret;
+	}
 
 	/* V4L2 File Handler */
 
@@ -810,7 +969,8 @@ int cedrus_context_setup(struct cedrus_proc *proc, struct cedrus_context *ctx,
 	if (IS_ERR(fh->m2m_ctx)) {
 		v4l2_err(v4l2_dev, "failed to initialize V4L2 M2M context\n");
 		v4l2_fh_exit(fh);
-		return PTR_ERR(fh->m2m_ctx);
+		ret = PTR_ERR(fh->m2m_ctx);
+		goto error_proc;
