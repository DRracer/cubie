+#include <linux/dma-buf.h>
 #include <linux/ktime.h>
 #include <linux/reset.h>
 #include <linux/pm_runtime.h>
@@ -231,19 +232,65 @@ static void cedrus_context_streaming_update(struct cedrus_context *ctx,
 	if (!ctx->proc->stateful)
 		return;
 
+	if (ctx->proc->ops->queue_streaming)
+		ctx->proc->ops->queue_streaming(ctx, queue, start);
+
 	if (start) {
 		v4l2_m2m_update_start_streaming_state(m2m_ctx, queue);
 		return;
 	}
 
+	/* No job runs now: m2m cancelled it before stopping the queue. */
 	v4l2_m2m_update_stop_streaming_state(m2m_ctx, queue);
 
+	if (ctx->hold) {
+		if (V4L2_TYPE_IS_CAPTURE(queue->type)) {
+			cedrus_context_hold_resume(ctx, false);
+		} else {
+			/* A seek drops the change; the next frame announces. */
+			v4l2_m2m_clear_state(m2m_ctx);
+			vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(m2m_ctx));
+			ctx->hold = false;
+			ctx->hold_drain = false;
+		}
+	}
+
 	if (V4L2_TYPE_IS_OUTPUT(queue->type) && v4l2_m2m_has_stopped(m2m_ctx))
 		cedrus_context_eos(ctx);
 }
 
+/* CPU access to coded buffers (proc coded_cpu_access) */
+
+/*
+ * Brackets kernel reads of a coded buffer: imported DMA-BUFs may be cached
+ * on the exporter's side. Process context (may sleep).
+ */
+int cedrus_context_coded_cpu_begin(struct vb2_buffer *vb2_buffer)
+{
+	if (vb2_buffer->memory != VB2_MEMORY_DMABUF)
+		return 0;
+
+	return dma_buf_begin_cpu_access(vb2_buffer->planes[0].dbuf,
+					DMA_FROM_DEVICE);
+}
+
+void cedrus_context_coded_cpu_end(struct vb2_buffer *vb2_buffer)
+{
+	if (vb2_buffer->memory == VB2_MEMORY_DMABUF)
+		dma_buf_end_cpu_access(vb2_buffer->planes[0].dbuf,
+				       DMA_FROM_DEVICE);
+}
+
 /* Job */
 
+unsigned long cedrus_context_job_timeout(struct cedrus_context *ctx)
+{
+	if (ctx->job.timeout_ms)
+		return msecs_to_jiffies(ctx->job.timeout_ms);
+
+	return cedrus_engine_timeout(ctx->engine);
+}
+
 void cedrus_context_job_finish(struct cedrus_context *ctx, int state)
 {
 	struct cedrus_proc *proc = ctx->proc;
@@ -257,18 +304,98 @@ void cedrus_context_job_finish(struct cedrus_context *ctx, int state)
 	if (proc->stateful) {
 		struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(m2m_ctx);
 		struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(m2m_ctx);
+		unsigned long flags;
 
+		spin_lock_irqsave(&ctx->state_lock, flags);
 		if (src && dst &&
 		    v4l2_m2m_is_last_draining_src_buf(m2m_ctx, src)) {
 			dst->flags |= V4L2_BUF_FLAG_LAST;
 			cedrus_context_eos(ctx);
 			v4l2_m2m_mark_stopped(m2m_ctx);
 		}
+		spin_unlock_irqrestore(&ctx->state_lock, flags);
 	}
 
 	v4l2_m2m_buf_done_and_job_finish(m2m_dev, m2m_ctx, state);
 }
 
+/*
+ * Dynamic resolution change: the job's frame needs another picture format.
+ * Every frame before it has completed (one job per context at a time); the
+ * frame stays queued, the next picture buffer goes back empty with LAST, and
+ * the context stays stopped until the client resumes it.
+ */
+static void cedrus_context_job_hold(struct cedrus_context *ctx)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
+	struct vb2_v4l2_buffer *dst;
+	unsigned long flags;
+
+	ctx->proc->ops->job_hold(ctx, ctx->job.buffer_picture);
+
+	spin_lock_irqsave(&ctx->state_lock, flags);
+	ctx->hold = true;
+	/* last_buffer_done() ends a drain begun before: resume it later. */
+	ctx->hold_drain = m2m_ctx->is_draining;
+	dst = v4l2_m2m_dst_buf_remove(m2m_ctx);
+	/* No frame: drop what job_run copied from the waiting one. */
+	dst->vb2_buf.timestamp = 0;
+	dst->vb2_buf.copied_timestamp = 0;
+	dst->flags &= ~(V4L2_BUF_FLAG_TIMECODE | V4L2_BUF_FLAG_KEYFRAME |
+			V4L2_BUF_FLAG_PFRAME | V4L2_BUF_FLAG_BFRAME);
+	vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+	v4l2_m2m_last_buffer_done(m2m_ctx, dst);
+	spin_unlock_irqrestore(&ctx->state_lock, flags);
+
+	memset(&ctx->job, 0, sizeof(ctx->job));
+	v4l2_m2m_job_finish(ctx->proc->dev->v4l2.m2m_dev, m2m_ctx);
+}
+
+/*
+ * The client resumes after a hold: CAPTURE STREAMOFF (command false; the m2m
+ * state was cleared) or V4L2_DEC_CMD_START (command true; the picture buffers
+ * must fit the new format). The picture format follows the stream again.
+ */
+int cedrus_context_hold_resume(struct cedrus_context *ctx, bool command)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
+	struct vb2_queue *queue = v4l2_m2m_get_dst_vq(m2m_ctx);
+	struct v4l2_format format;
+	unsigned long flags;
+	unsigned int i;
+
+	if (!ctx->hold)
+		return 0;
+
+	if (command) {
+		ctx->proc->ops->format_picture_get(ctx, &format);
+		for (i = 0; i < queue->max_num_buffers; i++) {
+			struct vb2_buffer *vb2_buffer = vb2_get_buffer(queue, i);
+
+			if (vb2_buffer && vb2_plane_size(vb2_buffer, 0) <
+			    format.fmt.pix.sizeimage)
+				return -EINVAL;
+		}
+	}
+
+	ctx->proc->ops->format_picture_adopt(ctx);
+
+	spin_lock_irqsave(&ctx->state_lock, flags);
+	if (command)
+		m2m_ctx->has_stopped = false;
+	m2m_ctx->is_draining = ctx->hold_drain;
+	ctx->hold = false;
+	ctx->hold_drain = false;
+	spin_unlock_irqrestore(&ctx->state_lock, flags);
+
+	if (command) {
+		vb2_clear_last_buffer_dequeued(queue);
+		v4l2_m2m_try_schedule(m2m_ctx);
+	}
+
+	return 0;
+}
+
 int cedrus_context_job_run(struct cedrus_context *ctx)
 {
 	struct cedrus_proc *proc = ctx->proc;
@@ -362,8 +489,15 @@ int cedrus_context_job_run(struct cedrus_context *ctx)
 	/* Configure engine job. */
 
 	ret = cedrus_engine_job_configure(ctx);
+	if (ret == -EAGAIN && proc->ops->job_hold) {
