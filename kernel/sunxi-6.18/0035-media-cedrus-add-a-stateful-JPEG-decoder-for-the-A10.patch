+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * Cedrus Video Engine Driver: decoder uAPI.
+ *
+ * Driver-private pixel formats of the decoded pictures.
+ */
+
+#ifndef _UAPI_CEDRUS_DEC_H_
+#define _UAPI_CEDRUS_DEC_H_
+
+#include <linux/videodev2.h>
+
+/*
+ * Y/CbCr 4:2:2 in 32x32 tiles: the luma plane as in V4L2_PIX_FMT_NV12_32L32,
+ * followed by an interleaved CbCr plane of the same height and tiling (one
+ * chroma row per luma row). Width and height are multiples of 32; the plane
+ * stride is bytesperline. Output of the A10/A20 JPEG decoder for 4:2:2 JPEGs.
+ */
+#define V4L2_PIX_FMT_CEDRUS_NV16_32L32	v4l2_fourcc('S', 'T', '1', '6')
+
