diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.c
new file mode 100644
index 000000000..8490c2239
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.c
@@ -0,0 +1,475 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Stateful JPEG decoder node (cedrus-jpeg), following
+ * Documentation/userspace-api/media/v4l/dev-decoder.rst: the driver reads the
+ * picture size from the frames, signals it with V4L2_EVENT_SOURCE_CHANGE and
+ * decodes into MB32-tiled pictures (NV12 for 4:2:0, the driver-private NV16
+ * layout for 4:2:2 and 4:4:4, whose chroma the VE halves horizontally by
+ * averaging column pairs). Broken frames come back with V4L2_BUF_FLAG_ERROR.
+ */
+
+#include <linux/slab.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-mem2mem.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_dec.h"
+#include "cedrus_dec_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_jpeg.h"
+#include "cedrus_proc.h"
+#include "cedrus_regs.h"
+#include "uapi/cedrus-dec.h"
+
+/* Format */
+
+static const struct cedrus_format cedrus_jpeg_formats[] = {
+	{
+		.pixelformat	= V4L2_PIX_FMT_NV12_32L32,
+		.type		= CEDRUS_FORMAT_TYPE_PICTURE,
+	},
+	{
+		.pixelformat	= V4L2_PIX_FMT_CEDRUS_NV16_32L32,
+		.type		= CEDRUS_FORMAT_TYPE_PICTURE,
+		.description	= "Y/UV 4:2:2 (32x32 Tiles)",
+	},
+};
+
+u32 cedrus_jpeg_picture_fourcc(unsigned int format)
+{
+	return format == CEDRUS_JPEG_FMT_420 ? V4L2_PIX_FMT_NV12_32L32 :
+					       V4L2_PIX_FMT_CEDRUS_NV16_32L32;
+}
+
+/*
+ * The client's colorimetry wins; without one, the V4L2_COLORSPACE_JPEG
+ * shorthand (the other fields stay 0).
+ */
+static void cedrus_jpeg_colorimetry(struct v4l2_pix_format *pix_format)
+{
+	pix_format->field = V4L2_FIELD_NONE;
+
+	if (pix_format->colorspace != V4L2_COLORSPACE_DEFAULT)
+		return;
+
+	pix_format->colorspace = V4L2_COLORSPACE_JPEG;
+	pix_format->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+	pix_format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix_format->quantization = V4L2_QUANTIZATION_DEFAULT;
+}
+
+static void cedrus_jpeg_picture_fill(struct cedrus_context *ctx,
+				     struct v4l2_pix_format *pix_format,
+				     unsigned int width, unsigned int height,
+				     u32 pixelformat)
+{
+	struct v4l2_pix_format *pix_format_coded =
+		&ctx->v4l2.format_coded.fmt.pix;
+
+	unsigned int stride = ALIGN(width, 32);
+	unsigned int rows = ALIGN(height, 32);
+
+	pix_format->pixelformat = pixelformat;
+	pix_format->width = stride;
+	pix_format->height = rows;
+	pix_format->bytesperline = stride;
+
+	if (pixelformat == V4L2_PIX_FMT_NV12_32L32)
+		/* As the other decoders: chroma rows rounded to 64. */
+		pix_format->sizeimage = stride * rows +
+					stride * ALIGN(rows, 64) / 2;
+	else
+		/* Full-height chroma; the VE never writes past it (J2). */
+		pix_format->sizeimage = 2 * stride * rows;
+
+	/*
+	 * Allocations of one page or less bypass the CMA pool and may land
+	 * outside the VE's DMA window (refused by buf_prepare).
+	 */
+	pix_format->sizeimage = max_t(u32, pix_format->sizeimage,
+				      2 * PAGE_SIZE);
+
+	/* Colorimetry follows the coded format; JPEG means sRGB, 601, full. */
+	pix_format->field = V4L2_FIELD_NONE;
+	if (pix_format_coded->colorspace == V4L2_COLORSPACE_JPEG) {
+		pix_format->colorspace = V4L2_COLORSPACE_SRGB;
+		pix_format->xfer_func = V4L2_XFER_FUNC_SRGB;
+		pix_format->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix_format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	} else {
+		pix_format->colorspace = pix_format_coded->colorspace;
+		pix_format->xfer_func = pix_format_coded->xfer_func;
+		pix_format->ycbcr_enc = pix_format_coded->ycbcr_enc;
+		pix_format->quantization = pix_format_coded->quantization;
+	}
+}
+
+/* Size and fourcc the picture queue should have now. */
+static void cedrus_jpeg_picture_target(struct cedrus_context *ctx,
+				       unsigned int *width,
+				       unsigned int *height, u32 *pixelformat)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	struct v4l2_pix_format *pix_format_coded =
+		&ctx->v4l2.format_coded.fmt.pix;
+	unsigned long flags;
+
+	spin_lock_irqsave(&jpeg_ctx->lock, flags);
+	if (jpeg_ctx->announced) {
+		*width = jpeg_ctx->width;
+		*height = jpeg_ctx->height;
+		*pixelformat = jpeg_ctx->pixelformat;
+	} else {
+		*width = pix_format_coded->width;
+		*height = pix_format_coded->height;
+	}
+	spin_unlock_irqrestore(&jpeg_ctx->lock, flags);
+}
+
+int cedrus_jpeg_format_coded_prepare(struct cedrus_context *ctx,
+				     struct v4l2_format *format)
+{
+	struct v4l2_pix_format *pix_format = &format->fmt.pix;
+
+	v4l2_apply_frmsize_constraints(&pix_format->width, &pix_format->height,
+				       ctx->engine->frmsize);
+
+	/*
+	 * Room for a frame at 12 bits per pixel, up to 8 MiB: at 4096x4096
+	 * that floor alone would take 24 MiB per buffer of the CMA pool.
+	 * Clients with bigger frames ask for more.
+	 */
+	pix_format->bytesperline = 0;
+	pix_format->sizeimage = max3(pix_format->sizeimage,
+				     min(pix_format->width * pix_format->height *
+					 3 / 2, (u32)SZ_8M),
+				     (u32)SZ_64K);
+
+	cedrus_jpeg_colorimetry(pix_format);
+
+	return 0;
+}
+
+/* Visible part of the picture the stream asks for (G_SELECTION). */
+static void cedrus_jpeg_selection_picture_get(struct cedrus_context *ctx,
+					      struct v4l2_rect *visible)
+{
+	u32 pixelformat = V4L2_PIX_FMT_NV12_32L32;
+	unsigned int width, height;
+
+	cedrus_jpeg_picture_target(ctx, &width, &height, &pixelformat);
+
+	visible->left = 0;
+	visible->top = 0;
+	visible->width = width;
+	visible->height = height;
+}
+
+/*
+ * The engine hook after S_FMT on the picture queue: the visible size jobs
+ * are checked against follows the picture format.
+ */
+void cedrus_jpeg_format_picture_update(struct cedrus_context *ctx)
+{
+	cedrus_jpeg_selection_picture_get(ctx, &ctx->v4l2.selection_picture);
+}
+
+static int cedrus_jpeg_format_picture_prepare(struct cedrus_context *ctx,
+					      struct v4l2_format *format)
+{
+	struct v4l2_pix_format *pix_format = &format->fmt.pix;
+	unsigned int width, height;
+	u32 pixelformat = pix_format->pixelformat;
+
+	/* Once the stream is known, its picture format is the only choice. */
+	cedrus_jpeg_picture_target(ctx, &width, &height, &pixelformat);
+	cedrus_jpeg_picture_fill(ctx, pix_format, width, height, pixelformat);
+
+	return 0;
+}
+
+static int cedrus_jpeg_format_picture_configure(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	/* The JPEG engine takes the chroma layout from the TRIGGER format. */
+	cedrus_write(dev, VE_PRIMARY_OUT_FMT, VE_PRIMARY_OUT_FMT_TILED_32_NV12);
+	cedrus_write(dev, VE_CHROMA_BUF_LEN, VE_SECONDARY_OUT_FMT_TILED_32_NV12);
+
+	return 0;
+}
+
+static void cedrus_jpeg_format_picture_get(struct cedrus_context *ctx,
+					   struct v4l2_format *format)
+{
+	*format = ctx->v4l2.format_picture;
+	cedrus_jpeg_format_picture_prepare(ctx, format);
+}
+
+/*
+ * job_run and queue_setup read format_picture: it follows the announced
+ * format while the picture queue has no buffers, and when the client resumes
+ * after a resolution change (no job runs then).
+ */
+static void cedrus_jpeg_format_picture_adopt(struct cedrus_context *ctx)
+{
+	cedrus_jpeg_format_picture_prepare(ctx, &ctx->v4l2.format_picture);
+	cedrus_jpeg_format_picture_update(ctx);
+}
+
+static void cedrus_jpeg_format_picture_sync(struct cedrus_context *ctx)
+{
+	if (!cedrus_context_queue_busy_check(ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE))
+		cedrus_jpeg_format_picture_adopt(ctx);
+}
+
+static int cedrus_jpeg_format_setup(struct cedrus_context *ctx)
+{
+	struct cedrus_proc *proc = ctx->proc;
+	struct v4l2_format *format = &ctx->v4l2.format_coded;
+	struct v4l2_pix_format *pix_format = &format->fmt.pix;
+	int ret;
+
+	format->type = cedrus_proc_buffer_type(proc, CEDRUS_FORMAT_TYPE_CODED);
+
+	pix_format->pixelformat = ctx->engine->pixelformat;
+	pix_format->width = 1280;
+	pix_format->height = 720;
+
+	ret = cedrus_proc_format_coded_prepare(ctx, format);
+	if (ret)
+		return ret;
+
+	format = &ctx->v4l2.format_picture;
+	format->type =
+		cedrus_proc_buffer_type(proc, CEDRUS_FORMAT_TYPE_PICTURE);
+	format->fmt.pix.pixelformat = V4L2_PIX_FMT_NV12_32L32;
+
+	return cedrus_proc_format_propagate(ctx, CEDRUS_FORMAT_TYPE_CODED);
+}
+
+static int cedrus_jpeg_format_propagate(struct cedrus_context *ctx,
+					unsigned int format_type)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+
+	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
+		return 0;
+
+	/* A new coded format starts a new stream. */
+	jpeg_ctx->announced = false;
+
+	cedrus_jpeg_format_picture_prepare(ctx, &ctx->v4l2.format_picture);
+	cedrus_jpeg_format_picture_update(ctx);
+
+	return 0;
+}
+
+static bool cedrus_jpeg_format_dynamic_check(struct cedrus_context *ctx,
+					     struct v4l2_format *format)
+{
+	return false;
+}
+
+/* Size */
+
+static int cedrus_jpeg_size_picture_enum(struct cedrus_context *ctx,
+					 struct v4l2_frmsizeenum *frmsizeenum)
+{
+	/*
+	 * Decodable picture sizes, not buffer sizes: clients such as GStreamer
+	 * check the visible size (G_SELECTION, the JPEG's own size) against this
+	 * range, while G_FMT reports it aligned to the 32x32 tiles.
+	 */
+	frmsizeenum->stepwise = *ctx->engine->frmsize;
+
+	return 0;
+}
+
+/* Source change */
+
+/* Records the stream's picture format; true if it differs from the last. */
+static bool cedrus_jpeg_announce(struct cedrus_context *ctx,
+				 const struct cedrus_jpeg_hdr *hdr)
+{
+	static const struct v4l2_event event = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+	};
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	u32 pixelformat = cedrus_jpeg_picture_fourcc(hdr->format);
+	unsigned long flags;
+	bool changed;
+
+	spin_lock_irqsave(&jpeg_ctx->lock, flags);
+	changed = !jpeg_ctx->announced || hdr->width != jpeg_ctx->width ||
+		  hdr->height != jpeg_ctx->height ||
+		  pixelformat != jpeg_ctx->pixelformat;
+	jpeg_ctx->announced = true;
+	jpeg_ctx->width = hdr->width;
+	jpeg_ctx->height = hdr->height;
+	jpeg_ctx->pixelformat = pixelformat;
+	spin_unlock_irqrestore(&jpeg_ctx->lock, flags);
+
+	if (changed)
+		v4l2_event_queue_fh(&ctx->v4l2.fh, &event);
+
+	return changed;
+}
+
+/*
+ * A coded buffer is queued (process context, queue lock held). Until the
+ * stream's format is known, frames are checked here: the first good one
+ * announces it, broken ones come back at once (there are no picture buffers
+ * to decode into yet). Later changes are found by the job itself
+ * (cedrus_jpeg_job_hold). Returns true if the buffer was completed here.
+ */
+static bool cedrus_jpeg_buffer_coded_queue(struct cedrus_context *ctx,
+					   struct cedrus_buffer *buffer)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	struct vb2_v4l2_buffer *v4l2_buffer = &buffer->m2m_buffer.vb;
+	struct vb2_buffer *vb2_buffer = &v4l2_buffer->vb2_buf;
+	struct cedrus_jpeg_hdr *hdr = &jpeg_ctx->hdr;
+	void *vaddr = vb2_plane_vaddr(vb2_buffer, 0);
+	unsigned int payload = vb2_get_plane_payload(vb2_buffer, 0);
+	int ret;
+
+	if (jpeg_ctx->announced)
+		return false;
+
+	ret = cedrus_context_coded_cpu_begin(vb2_buffer);
+	if (!ret) {
+		ret = !vaddr || !payload ||
+		      cedrus_jpeg_hdr_parse(vaddr, payload,
+					    CEDRUS_JPEG_WIDTH_MAX,
+					    CEDRUS_JPEG_HEIGHT_MAX, hdr);
+		cedrus_context_coded_cpu_end(vb2_buffer);
+	}
+
+	if (ret) {
+		v4l2_buffer->sequence = jpeg_ctx->sequence++;
+		v4l2_m2m_buf_done(v4l2_buffer, VB2_BUF_STATE_ERROR);
+		return true;
+	}
+
+	cedrus_jpeg_announce(ctx, hdr);
+	cedrus_jpeg_format_picture_sync(ctx);
+
+	return false;
+}
+
+/*
+ * The job's frame (already validated) needs another picture format. The
+ * event goes out only if the stream really changed: after an OUTPUT restart
+ * the frame announced itself when it was queued.
+ */
+static void cedrus_jpeg_job_hold(struct cedrus_context *ctx,
+				 struct vb2_v4l2_buffer *dst)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	struct cedrus_dec_jpeg_job *job = ctx->engine_job;
+
+	cedrus_jpeg_announce(ctx, &job->hdr);
+
+	/* The empty buffer carries the number of the frame that waits. */
+	dst->sequence = jpeg_ctx->sequence;
+}
+
+static void cedrus_jpeg_queue_streaming(struct cedrus_context *ctx,
+					struct vb2_queue *queue, bool start)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	unsigned long flags;
+
+	/* A restarted (e.g. seeking) stream announces its format again. */
+	if (!start && V4L2_TYPE_IS_OUTPUT(queue->type)) {
+		spin_lock_irqsave(&jpeg_ctx->lock, flags);
+		jpeg_ctx->announced = false;
+		spin_unlock_irqrestore(&jpeg_ctx->lock, flags);
+		jpeg_ctx->sequence = 0;
+	}
+}
+
+/* Context */
+
+static int cedrus_jpeg_context_setup(struct cedrus_context *ctx)
+{
+	struct cedrus_jpeg_context *jpeg_ctx;
+
+	jpeg_ctx = kzalloc(sizeof(*jpeg_ctx), GFP_KERNEL);
+	if (!jpeg_ctx)
+		return -ENOMEM;
+
+	spin_lock_init(&jpeg_ctx->lock);
+	ctx->proc_ctx = jpeg_ctx;
+
+	return 0;
+}
+
+static void cedrus_jpeg_context_cleanup(struct cedrus_context *ctx)
+{
+	kfree(ctx->proc_ctx);
+	ctx->proc_ctx = NULL;
+}
+
+/* Engines */
+
+static const struct cedrus_engine *cedrus_jpeg_engines[] = {
+	&cedrus_dec_jpeg,
+	&cedrus_dec_mjpeg,
+};
+
+/* Decoder */
+
+static const struct cedrus_proc_config cedrus_jpeg_config = {
+	.role			= CEDRUS_ROLE_DECODER,
+	.name			= "jpeg",
+	.stateful		= true,
+	.coded_cpu_access	= true,
+
+	.engines		= cedrus_jpeg_engines,
+	.engines_count		= ARRAY_SIZE(cedrus_jpeg_engines),
+
+	.formats		= cedrus_jpeg_formats,
+	.formats_count		= ARRAY_SIZE(cedrus_jpeg_formats),
+};
+
+static const struct cedrus_proc_ops cedrus_jpeg_ops = {
+	.context_setup			= cedrus_jpeg_context_setup,
+	.context_cleanup		= cedrus_jpeg_context_cleanup,
+
+	.format_picture_prepare		= cedrus_jpeg_format_picture_prepare,
+	.format_picture_configure	= cedrus_jpeg_format_picture_configure,
+	.format_picture_get		= cedrus_jpeg_format_picture_get,
+	.selection_picture_get		= cedrus_jpeg_selection_picture_get,
+	.format_picture_sync		= cedrus_jpeg_format_picture_sync,
+
+	.format_setup			= cedrus_jpeg_format_setup,
+	.format_propagate		= cedrus_jpeg_format_propagate,
+	.format_dynamic_check		= cedrus_jpeg_format_dynamic_check,
+
+	.size_picture_enum		= cedrus_jpeg_size_picture_enum,
+
+	.buffer_coded_queue		= cedrus_jpeg_buffer_coded_queue,
+	.queue_streaming		= cedrus_jpeg_queue_streaming,
+
+	.job_hold			= cedrus_jpeg_job_hold,
+	.format_picture_adopt		= cedrus_jpeg_format_picture_adopt,
+};
+
+int cedrus_jpeg_setup(struct cedrus_device *dev)
+{
+	return cedrus_proc_setup(dev, &dev->jpeg, &cedrus_jpeg_ops,
+				 &cedrus_jpeg_config);
+}
+
+void cedrus_jpeg_cleanup(struct cedrus_device *dev)
+{
+	cedrus_proc_cleanup(&dev->jpeg);
+}
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.h b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.h
new file mode 100644
index 000000000..898b0fb8c
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Stateful JPEG decoder node (cedrus-jpeg).
+ */
+
+#ifndef _CEDRUS_JPEG_H_
+#define _CEDRUS_JPEG_H_
+
+#include <linux/spinlock.h>
+#include <linux/videodev2.h>
+
+#include "cedrus_jpeg_hdr.h"
+
+struct cedrus_context;
+struct cedrus_device;
+
+/* Tested up to 4096x4096; the VE's MCU counters are 16 bits wide. */
+#define CEDRUS_JPEG_WIDTH_MAX	4096U
+#define CEDRUS_JPEG_HEIGHT_MAX	4096U
+
+/* Per-context state of the node (cedrus_context.proc_ctx). */
+struct cedrus_jpeg_context {
+	/* Scratch for the header check when a frame is queued. */
+	struct cedrus_jpeg_hdr	hdr;
+
+	/*
+	 * Picture size and fourcc last signalled with SOURCE_CHANGE; written
+	 * from the job too (resolution change), hence the lock.
+	 */
+	spinlock_t		lock;
+	bool			announced;
+	unsigned int		width;
+	unsigned int		height;
+	u32			pixelformat;
+
+	/* Frame counter, reported as v4l2_buffer.sequence on both queues. */
+	u32			sequence;
+};
+
+u32 cedrus_jpeg_picture_fourcc(unsigned int format);
+int cedrus_jpeg_format_coded_prepare(struct cedrus_context *ctx,
+				     struct v4l2_format *format);
+void cedrus_jpeg_format_picture_update(struct cedrus_context *ctx);
+
+int cedrus_jpeg_setup(struct cedrus_device *dev);
+void cedrus_jpeg_cleanup(struct cedrus_device *dev);
+
+#endif
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_hdr.c b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_hdr.c
new file mode 100644
index 000000000..a37569998
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_hdr.c
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * JPEG header checks for the A10/A20 JPEG decoder: everything the VE is
+ * given is validated and copied here, before the first register write.
+ * Register sequence and table layout after Allwinner's libvecore,
+ * mjpeg_hal.c and Jens Kuske's jpeg-test.
+ */
+
+#include <linux/errno.h>
+#include <linux/math.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <media/v4l2-jpeg.h>
+
+#include "cedrus_jpeg_hdr.h"
+
+#define CEDRUS_JPEG_SIZE_MIN	16
+/* Zero bytes tolerated after EOI (the buffer is read uncached). */
+#define CEDRUS_JPEG_PADDING_MAX	4096
+/* Symbols of an 8-bit baseline table: DC categories 0-11, 162 AC codes. */
+#define CEDRUS_JPEG_DC_SYMBOLS_MAX	16
+#define CEDRUS_JPEG_AC_SYMBOLS_MAX	162
+
+/* Sampling factors Yh Yv Cbh Cbv Crh Crv, one nibble each. */
+static int cedrus_jpeg_hdr_format(const struct v4l2_jpeg_frame_header *frame)
+{
+	const struct v4l2_jpeg_frame_component_spec *c = frame->component;
+	u32 key = 0;
+	unsigned int i;
+
+	for (i = 0; i < 3; i++)
+		key |= (c[i].horizontal_sampling_factor << 4 |
+			c[i].vertical_sampling_factor) << (16 - 8 * i);
+
+	/*
+	 * The VE also decodes 4:1:1 (into a layout of its own) and 4:4:0, but
+	 * gray frames leave the picture buffer untouched (J2 probe).
+	 */
+	switch (key) {
+	case 0x221111:
+		return CEDRUS_JPEG_FMT_420;
+	case 0x211111:
+		return CEDRUS_JPEG_FMT_422;
+	case 0x111111:
+		return CEDRUS_JPEG_FMT_444;
+	default:
+		return -EBADMSG;
+	}
+}
+
+static const u8 *cedrus_jpeg_hdr_ref_ht(unsigned int tc, unsigned int th)
+{
+	if (tc)
+		return th ? v4l2_jpeg_ref_table_chroma_ac_ht :
+			    v4l2_jpeg_ref_table_luma_ac_ht;
+
+	return th ? v4l2_jpeg_ref_table_chroma_dc_ht :
+		    v4l2_jpeg_ref_table_luma_dc_ht;
+}
+
+/* Copies Huffman table (tc, th) into a slot; the length must match BITS. */
+static int cedrus_jpeg_hdr_ht(const struct v4l2_jpeg_reference *tables,
+			      unsigned int tc, unsigned int th,
+			      struct cedrus_jpeg_hdr *hdr, unsigned int slot)
+{
+	const struct v4l2_jpeg_reference *ref = &tables[tc << 1 | th];
+	const u8 *bits = ref->start;
+	unsigned int count = 0, code = 0, i;
+
+	/* No DHT: UVC MJPEG relies on the standard tables. */
+	if (!bits)
+		bits = cedrus_jpeg_hdr_ref_ht(tc, th);
+
+	memcpy(hdr->bits[slot], bits, 16);
+	for (i = 0; i < 16; i++) {
+		count += hdr->bits[slot][i];
+		/*
+		 * Kraft: the codes of lengths 1..i+1 must fit in i+1 bits
+		 * (the all-ones code is reserved).
+		 */
+		code = (code << 1) + hdr->bits[slot][i];
+		if (code >= 1U << (i + 1))
+			return -EBADMSG;
+	}
+
+	if (count > (tc ? CEDRUS_JPEG_AC_SYMBOLS_MAX :
+			  CEDRUS_JPEG_DC_SYMBOLS_MAX) ||
+	    (ref->start && ref->length != 16 + count))
+		return -EBADMSG;
+
+	memcpy(hdr->vals[slot], bits + 16, count);
+	hdr->counts[slot] = count;
+
+	return 0;
+}
+
+int cedrus_jpeg_hdr_parse(const void *buf, size_t len,
+			  unsigned int max_width, unsigned int max_height,
+			  struct cedrus_jpeg_hdr *hdr)
+{
+	struct v4l2_jpeg_reference qtables[4] = { 0 };
+	struct v4l2_jpeg_reference htables[4] = { 0 };
+	struct v4l2_jpeg_scan_header scan = { 0 };
+	struct v4l2_jpeg_header h = {
+		.scan			= &scan,
+		.quantization_tables	= qtables,
+		.huffman_tables		= htables,
+	};
+	const struct v4l2_jpeg_frame_component_spec *fc = h.frame.component;
+	const struct v4l2_jpeg_scan_component_spec *sc = scan.component;
+	const u8 *d = buf;
+	size_t end;
+	unsigned int i, j;
+	int ret;
+
+	memset(hdr, 0, sizeof(*hdr));
+
+	/* The parser casts the const away but only reads. */
+	if (v4l2_jpeg_parse_header((void *)buf, len, &h))
+		return -EBADMSG;
+
+	/* SOF0/SOF1 only (the parser rejects the others), 8 bits. */
+	if (!h.sof.start || h.frame.precision != 8)
+		return -EBADMSG;
+
+	/* The VE resynchronises at RSTn markers itself. */
+	hdr->restart_interval = h.restart_interval;
+
+	/* Y, Cb, Cr in one interleaved scan, in frame order (T.81 B.2.3). */
+	if (h.frame.num_components != 3 || scan.num_components != 3 ||
+	    !h.sos.start)
+		return -EBADMSG;
+
+	for (i = 0; i < 3; i++) {
+		if (sc[i].component_selector != fc[i].component_identifier)
+			return -EBADMSG;
+		for (j = 0; j < i; j++)
+			if (fc[j].component_identifier ==
+			    fc[i].component_identifier)
+				return -EBADMSG;
+		if (fc[i].quantization_table_selector > 3 ||
+		    sc[i].dc_entropy_coding_table_selector > 1 ||
+		    sc[i].ac_entropy_coding_table_selector > 1)
+			return -EBADMSG;
+	}
+
+	/* One chroma Q table and Huffman set in the VE. */
+	if (fc[1].quantization_table_selector !=
+	    fc[2].quantization_table_selector ||
+	    sc[1].dc_entropy_coding_table_selector !=
+	    sc[2].dc_entropy_coding_table_selector ||
+	    sc[1].ac_entropy_coding_table_selector !=
+	    sc[2].ac_entropy_coding_table_selector)
+		return -EBADMSG;
+
+	ret = cedrus_jpeg_hdr_format(&h.frame);
+	if (ret < 0)
+		return ret;
+	hdr->format = ret;
+
+	if (h.frame.width < CEDRUS_JPEG_SIZE_MIN ||
+	    h.frame.height < CEDRUS_JPEG_SIZE_MIN ||
+	    h.frame.width > max_width || h.frame.height > max_height)
+		return -EBADMSG;
+	hdr->width = h.frame.width;
+	hdr->height = h.frame.height;
+
+	/* MCU: 8 x the luma factors (Cb and Cr are 1x1); Y blocks + 2. */
+	hdr->mcu_width = DIV_ROUND_UP(hdr->width,
+				      8 * fc[0].horizontal_sampling_factor);
+	hdr->mcu_height = DIV_ROUND_UP(hdr->height,
+				       8 * fc[0].vertical_sampling_factor);
+	hdr->mcu_blocks = fc[0].horizontal_sampling_factor *
+			  fc[0].vertical_sampling_factor + 2;
+
+	if (h.ecs_offset >= len)
+		return -EBADMSG;
+	hdr->ecs_offset = h.ecs_offset;
+
+	/*
+	 * The scan must end with EOI (a little zero padding after it is fine):
+	 * when the data runs out without one, the VE waits for more and never
+	 * finishes.
+	 */
+	for (end = len; end > h.ecs_offset + 2 && !d[end - 1] &&
+	     len - end < CEDRUS_JPEG_PADDING_MAX; end--)
+		;
+	if (end < h.ecs_offset + 2 || d[end - 2] != 0xff || d[end - 1] != 0xd9)
+		return -EBADMSG;
+
+	/* 8-bit tables: luma from component 0, chroma from component 1. */
+	for (i = 0; i < 2; i++) {
+		const struct v4l2_jpeg_reference *qt =
+			&qtables[fc[i].quantization_table_selector];
+
+		if (!qt->start || qt->length != 64)
+			return -EBADMSG;
+		memcpy(hdr->qt[i], qt->start, 64);
+	}
+
+	for (i = 0; i < 2; i++) {
+		ret = cedrus_jpeg_hdr_ht(htables, 0,
+					 sc[i].dc_entropy_coding_table_selector,
+					 hdr, 2 * i);
+		if (!ret)
+			ret = cedrus_jpeg_hdr_ht(htables, 1,
+						 sc[i].ac_entropy_coding_table_selector,
+						 hdr, 2 * i + 1);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Huffman SRAM image, slot s: u16 [32s + 0..15] first canonical code of each
+ * length (0xffff after the last used length), bytes [64s + 32..47] number of
+ * symbols with shorter codes, bytes [1024 + 256s ...] HUFFVAL.
+ */
+void cedrus_jpeg_hdr_sram(const struct cedrus_jpeg_hdr *hdr,
+			  u8 img[CEDRUS_JPEG_SRAM_WORDS * 4])
+{
+	unsigned int slot, len;
+
+	memset(img, 0, CEDRUS_JPEG_SRAM_WORDS * 4);
+
+	for (slot = 0; slot < CEDRUS_JPEG_HT_SLOTS; slot++) {
+		const u8 *bits = hdr->bits[slot];
+		unsigned int code = 0, count = 0, last = 0;
+
+		for (len = 0; len < 16; len++) {
+			img[2 * (32 * slot + len)] = code & 0xff;
+			img[2 * (32 * slot + len) + 1] = (code >> 8) & 0xff;
+			img[64 * slot + 32 + len] = count;
+
+			code = (code + bits[len]) << 1;
+			count += bits[len];
+			if (bits[len])
+				last = len;
+		}
+
+		for (len = last + 1; len < 16; len++) {
+			img[2 * (32 * slot + len)] = 0xff;
+			img[2 * (32 * slot + len) + 1] = 0xff;
+		}
+
+		memcpy(img + 1024 + 256 * slot, hdr->vals[slot],
+		       hdr->counts[slot]);
+	}
+}
