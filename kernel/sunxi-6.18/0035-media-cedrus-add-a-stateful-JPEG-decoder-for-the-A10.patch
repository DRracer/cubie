+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus Video Engine Driver
+ *
+ * JPEG header checks for the A10/A20 JPEG decoder. Pure C on top of
+ * v4l2-jpeg, so it can also be built and fuzzed on a host.
+ */
+
+#ifndef _CEDRUS_JPEG_HDR_H_
+#define _CEDRUS_JPEG_HDR_H_
+
+#include <linux/types.h>
+
+/* Chroma format codes of VE_DEC_MPEG_TRIGGER bits 29:27 for JPEG. */
+#define CEDRUS_JPEG_FMT_420		0
+#define CEDRUS_JPEG_FMT_422		2
+#define CEDRUS_JPEG_FMT_444		3
+
+/* Huffman slots of the VE: luma DC/AC, chroma DC/AC. */
+#define CEDRUS_JPEG_HT_SLOTS		4
+
+/* Huffman SRAM image size (VE_DEC_MPEG_SRAM_RW_DATA words). */
+#define CEDRUS_JPEG_SRAM_WORDS		512
+
+/*
+ * A frame the VE can decode, with copies of every table it uses, so nothing
+ * refers back to a buffer userspace may rewrite.
+ */
+struct cedrus_jpeg_hdr {
+	unsigned int	width;
+	unsigned int	height;
+	unsigned int	format;		/* CEDRUS_JPEG_FMT_* */
+	unsigned int	mcu_width;	/* MCUs per row and column */
+	unsigned int	mcu_height;
+	unsigned int	mcu_blocks;	/* 8x8 blocks per MCU */
+	unsigned int	ecs_offset;	/* entropy-coded data, bytes */
+	unsigned int	restart_interval;	/* MCUs, 0 = none */
+
+	u8		qt[2][64];	/* luma, chroma; DQT (zig-zag) order */
+	u8		bits[CEDRUS_JPEG_HT_SLOTS][16];
+	u8		vals[CEDRUS_JPEG_HT_SLOTS][256];
+	unsigned int	counts[CEDRUS_JPEG_HT_SLOTS];
+};
+
+int cedrus_jpeg_hdr_parse(const void *buf, size_t len,
+			  unsigned int max_width, unsigned int max_height,
+			  struct cedrus_jpeg_hdr *hdr);
+void cedrus_jpeg_hdr_sram(const struct cedrus_jpeg_hdr *hdr,
+			  u8 img[CEDRUS_JPEG_SRAM_WORDS * 4]);
+
+#endif
