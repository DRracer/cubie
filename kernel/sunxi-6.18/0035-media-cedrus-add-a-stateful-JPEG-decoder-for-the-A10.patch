 	if (vb2_plane_size(vb2_buffer, 0) < pix_format->sizeimage)
 		return -EINVAL;
 
+	/* The kernel reads the bitstream (cedrus_context_coded_cpu_begin). */
+	if (format_type == CEDRUS_FORMAT_TYPE_CODED &&
