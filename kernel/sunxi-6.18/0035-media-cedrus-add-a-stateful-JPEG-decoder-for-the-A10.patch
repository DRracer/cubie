diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c
new file mode 100644
index 000000000..5c4e51b21
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c
@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * JPEG decoding on the MPEG engine of the A10/A20 VE (baseline 4:2:0, 4:2:2
+ * and 4:4:4, restart intervals). Register sequence after Allwinner's
+ * libvecore (InitJpegHw/JpegHwDec), mjpeg_hal.c and Jens Kuske's jpeg-test,
+ * verified on the A20.
+ */
+
+#include <linux/io.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_dec.h"
+#include "cedrus_dec_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_jpeg.h"
+#include "cedrus_proc.h"
+#include "cedrus_regs.h"
+
+/*
+ * Watchdog base: a stalled VLD (a scan without EOI) must not block the VE
+ * for long; job_configure adds time for the frame size.
+ */
+#define CEDRUS_DEC_JPEG_TIMEOUT_MS	500
+
+/* Job */
+
+static int cedrus_dec_jpeg_job_configure(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_dec_jpeg_job *job = ctx->engine_job;
+	struct cedrus_jpeg_hdr *hdr = &job->hdr;
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+	struct v4l2_rect *visible = &ctx->v4l2.selection_picture;
+	struct vb2_buffer *vb2_buffer = &ctx->job.buffer_coded->vb2_buf;
+	dma_addr_t luma_addr, chroma_addr, coded_addr;
+	unsigned int coded_size, i, k;
+	void *vaddr;
+	int ret;
+
+	/*
+	 * Parse again: userspace may have rewritten the buffer since it was
+	 * queued. Everything is checked and copied before the first register
+	 * write; a bad frame completes with an error and leaves the VE alone.
+	 */
+	vaddr = vb2_plane_vaddr(vb2_buffer, 0);
+	cedrus_job_buffer_coded_dma(ctx, &coded_addr, &coded_size);
+	if (!vaddr || !coded_size)
+		return -EBADMSG;
+
+	ret = cedrus_context_coded_cpu_begin(vb2_buffer);
+	if (ret)
+		return ret;
+	ret = cedrus_jpeg_hdr_parse(vaddr, coded_size, CEDRUS_JPEG_WIDTH_MAX,
+				    CEDRUS_JPEG_HEIGHT_MAX, hdr);
+	cedrus_context_coded_cpu_end(vb2_buffer);
+	if (ret)
+		return -EBADMSG;
+
+	/*
+	 * Frames of another size or chroma format wait until the client has
+	 * picture buffers for them (resolution change, cedrus_jpeg_job_hold).
+	 */
+	if (hdr->width != visible->width || hdr->height != visible->height ||
+	    cedrus_jpeg_picture_fourcc(hdr->format) != pix_format->pixelformat)
+		return -EAGAIN;
+
+	/* VLD_ADDR drops address bits 3:0. */
+	if (coded_addr & 0xf)
+		return -EINVAL;
+
+	/* The picture buffer holds the whole aligned picture (defensive). */
+	if (vb2_plane_size(&ctx->job.buffer_picture->vb2_buf, 0) <
+	    pix_format->sizeimage ||
+	    ALIGN(hdr->width, 32) > pix_format->width ||
+	    ALIGN(hdr->height, 32) > pix_format->height)
+		return -EINVAL;
+
+	cedrus_jpeg_hdr_sram(hdr, job->sram);
+
+	/* Restart interval and chroma format: TRIGGER byte 3. */
+
+	cedrus_write(dev, VE_DEC_MPEG_JPEG_RES_INT, hdr->restart_interval);
+
+	/*
+	 * The TRIGGER bytes are written one at a time, as the Allwinner
+	 * library does: a single 32-bit write decodes garbage.
+	 */
+	writeb(hdr->format << 3 | 3, dev->io_base + VE_DEC_MPEG_TRIGGER + 3);
+
+	/* Quantisation tables in DQT order: luma intra, chroma non-intra. */
+
+	for (i = 0; i < 2; i++)
+		for (k = 0; k < 64; k++)
+			cedrus_write(dev, VE_DEC_MPEG_IQMINPUT,
+				     VE_DEC_MPEG_IQMINPUT_WEIGHT(k, hdr->qt[i][k]) |
+				     (i ? VE_DEC_MPEG_IQMINPUT_FLAG_NON_INTRA :
+					  VE_DEC_MPEG_IQMINPUT_FLAG_INTRA));
+
+	/* Output: MB32-tiled luma and interleaved chroma. */
+
+	cedrus_job_buffer_picture_dma(ctx, &luma_addr, &chroma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, luma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA, chroma_addr);
+
+	cedrus_write(dev, VE_DEC_MPEG_JPEG_SIZE,
+		     VE_DEC_MPEG_JPEG_SIZE_WIDTH(hdr->mcu_width - 1) |
+		     VE_DEC_MPEG_JPEG_SIZE_HEIGHT(hdr->mcu_height - 1));
+
+	cedrus_write(dev, VE_DEC_MPEG_SDROT_CTRL, 0);
+
+	/* Huffman tables. */
+
+	cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_OFFSET, 0);
+	for (i = 0; i < CEDRUS_JPEG_SRAM_WORDS; i++)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA,
+			     le32_to_cpu(((__le32 *)job->sram)[i]));
+
+	/* Bitstream: the whole buffer, decoding starts at the scan data. */
+
+	cedrus_write(dev, VE_DEC_MPEG_VLD_END_ADDR, coded_addr + coded_size - 1);
+
+	/* Written, not OR-ed: MPEG-2 leaves MC_NO_WRITEBACK/MC_CACHE_EN set. */
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, VE_DEC_MPEG_CTRL_JPEG_IRQ_MASK);
+
+	cedrus_write(dev, VE_DEC_MPEG_VLD_OFFSET, hdr->ecs_offset * 8);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_LEN,
+		     (coded_size - hdr->ecs_offset) * 8);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_ADDR,
+		     VE_DEC_MPEG_VLD_ADDR_BASE(coded_addr) |
+		     VE_DEC_MPEG_VLD_ADDR_VALID_PIC_DATA |
+		     VE_DEC_MPEG_VLD_ADDR_LAST_PIC_DATA |
+		     VE_DEC_MPEG_VLD_ADDR_FIRST_PIC_DATA);
+
+	cedrus_write(dev, VE_DEC_MPEG_STATUS, VE_DEC_MPEG_STATUS_JPEG_CLEAR);
+
+	/*
+	 * Photos take ~0.72 us per block, bit-bound frames ~32 ns per byte
+	 * (4096x4096 4:2:0 noise at q100, 33 MB: 1.06 s). Allow ~2 us per
+	 * block plus ~61 ns per byte, i.e. 2.5x or more.
+	 */
+	ctx->job.timeout_ms = CEDRUS_DEC_JPEG_TIMEOUT_MS +
+			      hdr->mcu_width * hdr->mcu_height *
+			      hdr->mcu_blocks / 512 + coded_size / 16384;
+
+	return 0;
+}
+
+static void cedrus_dec_jpeg_job_trigger(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	writeb(VE_DEC_MPEG_TRIGGER_HW_JPEG_VLD,
+	       dev->io_base + VE_DEC_MPEG_TRIGGER);
+}
+
+static int cedrus_dec_jpeg_job_finish(struct cedrus_context *ctx, int state)
+{
+	struct cedrus_jpeg_context *jpeg_ctx = ctx->proc_ctx;
+	u32 sequence = jpeg_ctx->sequence++;
+
+	ctx->job.buffer_coded->sequence = sequence;
+	ctx->job.buffer_picture->sequence = sequence;
+
+	/* The buffer may have been prepared for the format before a change. */
+	vb2_set_plane_payload(&ctx->job.buffer_picture->vb2_buf, 0,
+			      ctx->v4l2.format_picture.fmt.pix.sizeimage);
+
+	return state;
+}
+
+/* IRQ */
+
+static int cedrus_dec_jpeg_irq_status(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 status = cedrus_read(dev, VE_DEC_MPEG_STATUS);
+
+	/* Marker/restart/bit-end errors may come without bits 3:0. */
+	if (!(status & (VE_DEC_MPEG_STATUS_CHECK_MASK |
+			VE_DEC_MPEG_STATUS_ROTATE_SUCCESS |
+			VE_DEC_MPEG_STATUS_JPEG_ERRORS)))
+		return CEDRUS_IRQ_NONE;
+
+	if (status & VE_DEC_MPEG_STATUS_SUCCESS &&
+	    !(status & (VE_DEC_MPEG_STATUS_CHECK_ERROR |
+			VE_DEC_MPEG_STATUS_JPEG_ERRORS)))
+		return CEDRUS_IRQ_SUCCESS;
+
+	dev_dbg_ratelimited(dev->dev, "jpeg: decode error, status %08x\n",
+			    status);
+
+	return CEDRUS_IRQ_ERROR;
+}
+
+static void cedrus_dec_jpeg_irq_clear(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	cedrus_write(dev, VE_DEC_MPEG_STATUS, VE_DEC_MPEG_STATUS_CHECK_MASK |
+		     VE_DEC_MPEG_STATUS_ROTATE_SUCCESS);
+}
+
+static void cedrus_dec_jpeg_irq_disable(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 value;
+
+	value = cedrus_read(dev, VE_DEC_MPEG_CTRL);
+	value &= ~VE_DEC_MPEG_CTRL_JPEG_IRQ_MASK;
+
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, value);
+}
+
+/* Engine */
+
+static const struct cedrus_engine_ops cedrus_dec_jpeg_ops = {
+	.format_prepare		= cedrus_jpeg_format_coded_prepare,
+	.format_configure	= cedrus_dec_format_coded_configure,
+	.format_picture_update	= cedrus_jpeg_format_picture_update,
+
+	.job_configure		= cedrus_dec_jpeg_job_configure,
+	.job_trigger		= cedrus_dec_jpeg_job_trigger,
+	.job_finish		= cedrus_dec_jpeg_job_finish,
+
+	.irq_status		= cedrus_dec_jpeg_irq_status,
+	.irq_clear		= cedrus_dec_jpeg_irq_clear,
+	.irq_disable		= cedrus_dec_jpeg_irq_disable,
+};
+
+static const struct v4l2_frmsize_stepwise cedrus_dec_jpeg_frmsize = {
+	.min_width	= 16,
+	.max_width	= CEDRUS_JPEG_WIDTH_MAX,
+	.step_width	= 1,
+
+	.min_height	= 16,
+	.max_height	= CEDRUS_JPEG_HEIGHT_MAX,
+	.step_height	= 1,
+};
+
+const struct cedrus_engine cedrus_dec_jpeg = {
+	.codec			= CEDRUS_CODEC_JPEG,
+	.role			= CEDRUS_ROLE_DECODER,
+	.capabilities		= CEDRUS_CAPABILITY_JPEG_DEC,
+
+	.ops			= &cedrus_dec_jpeg_ops,
+
+	.pixelformat		= V4L2_PIX_FMT_JPEG,
+	.reset_on_error		= true,
+	.timeout_ms		= CEDRUS_DEC_JPEG_TIMEOUT_MS,
+	.frmsize		= &cedrus_dec_jpeg_frmsize,
+
+	.job_size		= sizeof(struct cedrus_dec_jpeg_job),
+};
+
+/* UVC cameras: the same frames, often without DHT (standard tables). */
+const struct cedrus_engine cedrus_dec_mjpeg = {
+	.codec			= CEDRUS_CODEC_JPEG,
+	.role			= CEDRUS_ROLE_DECODER,
+	.capabilities		= CEDRUS_CAPABILITY_JPEG_DEC,
+
+	.ops			= &cedrus_dec_jpeg_ops,
+
+	.pixelformat		= V4L2_PIX_FMT_MJPEG,
+	.reset_on_error		= true,
+	.timeout_ms		= CEDRUS_DEC_JPEG_TIMEOUT_MS,
+	.frmsize		= &cedrus_dec_jpeg_frmsize,
+
+	.job_size		= sizeof(struct cedrus_dec_jpeg_job),
+};
