From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Fri, 30 Oct 2026 18:42:33 +0100
Subject: [PATCH] ARM: dts: sun4i: mk802: add the AXP209 PMIC, WiFi power
 on PH3, drop the codec

The MK802 has an AXP209 on i2c0 (PB0/PB1) that supplies the CPU
(DCDC2) and the internal logic (DCDC3); without it as cpu-supply,
cpufreq cannot scale the voltage. ACIN and VBUS are shorted on the
PCB, the stick is fed through either. The board has no analog audio
output, so the codec stays disabled.

The internal WiFi (RTL8188EUS on usbc2) of this board revision is
powered from PH3, the common usb2-vbus default: with PH12 (as in the
fex of the original RTL8188CUS boards) it never enumerates, and
pulling PH3 low drops it off the bus. Local patch: the original
revision may well need PH12.

Tested on a Rikomagic MK802 (A10, 1 GiB, RTL8188EUS).

Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/allwinner/sun4i-a10-mk802.dts    | 50 +++++++++++++++++--
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/allwinner/sun4i-a10-mk802.dts b/arch/arm/boot/dts/allwinner/sun4i-a10-mk802.dts
index 059fe9c5d..625d356ef 100644
--- a/arch/arm/boot/dts/allwinner/sun4i-a10-mk802.dts
+++ b/arch/arm/boot/dts/allwinner/sun4i-a10-mk802.dts
@@ -69,8 +69,8 @@ hdmi_con_in: endpoint {
 	};
 };
 
-&codec {
-	status = "okay";
+&cpu0 {
+	cpu-supply = <&reg_dcdc2>;
 };
 
 &de {
@@ -95,6 +95,15 @@ hdmi_out_con: endpoint {
 	};
 };
 
+&i2c0 {
+	status = "okay";
+
+	axp209: pmic@34 {
+		reg = <0x34>;
+		interrupts = <0>;
+	};
+};
+
 &mmc0 {
 	vmmc-supply = <&reg_vcc3v3>;
 	bus-width = <4>;
@@ -110,6 +119,37 @@ &otg_sram {
 	status = "okay";
 };
 
+#include "axp209.dtsi"
+
+&ac_power_supply {
+	status = "okay";
+};
+
+&reg_dcdc2 {
+	regulator-always-on;
+	regulator-min-microvolt = <1000000>;
+	regulator-max-microvolt = <1450000>;
+	regulator-name = "vdd-cpu";
+};
+
+&reg_dcdc3 {
+	regulator-always-on;
+	regulator-min-microvolt = <1000000>;
+	regulator-max-microvolt = <1400000>;
+	regulator-name = "vdd-int-dll";
+};
+
+&reg_ldo1 {
+	regulator-name = "vdd-rtc";
+};
+
+&reg_ldo2 {
+	regulator-always-on;
+	regulator-min-microvolt = <3000000>;
+	regulator-max-microvolt = <3000000>;
+	regulator-name = "avcc";
+};
+
 &reg_usb0_vbus {
 	status = "okay";
 };
@@ -118,8 +158,8 @@ &reg_usb1_vbus {
 	status = "okay";
 };
 
+/* The internal WiFi (RTL8188EUS) is powered from PH3, the common default */
 &reg_usb2_vbus {
-	gpio = <&pio 7 12 GPIO_ACTIVE_HIGH>; /* PH12 */
 	status = "okay";
 };
 
@@ -134,6 +174,10 @@ &usb_otg {
 	status = "okay";
 };
 
+&usb_power_supply {
+	status = "okay";
+};
+
 &usbphy {
 	usb0_id_det-gpios = <&pio 7 4 GPIO_ACTIVE_HIGH>; /* PH4 */
 	usb0_vbus_det-gpios = <&pio 7 5 GPIO_ACTIVE_HIGH>; /* PH5 */
-- 
