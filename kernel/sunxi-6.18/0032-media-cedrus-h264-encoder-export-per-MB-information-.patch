new file mode 100644
index 000000000..4ca75e7e4
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/uapi/cedrus-enc.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: ((GPL-2.0+ WITH Linux-syscall-note) OR MIT) */
+/*
+ * Cedrus Video Engine Driver: encoder controls
+ *
+ * Per-macroblock information of the last dequeued coded (CAPTURE) buffer,
+ * as written by the A20 VE for P-frames: the MB mode and the motion vectors.
+ */
+
+#ifndef _UAPI_CEDRUS_ENC_H_
+#define _UAPI_CEDRUS_ENC_H_
+
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+
+/* Out-of-tree module builds may use headers without the reservation. */
+#ifndef V4L2_CID_USER_CEDRUS_BASE
+#define V4L2_CID_USER_CEDRUS_BASE		(V4L2_CID_USER_BASE + 0x1230)
+#endif
+
+/* Copy the MB information of every encoded frame (boolean, default 0). */
+#define V4L2_CID_CEDRUS_ENC_MB_INFO_ENABLE	(V4L2_CID_USER_CEDRUS_BASE + 0)
+
+/*
+ * MB information of the last dequeued CAPTURE buffer (read-only U32 array).
+ * Read it after each VIDIOC_DQBUF on the CAPTURE queue: the next dequeue
+ * replaces it. The array has CEDRUS_ENC_MB_INFO_ELEMS(mb_w, mb_h) elements
+ * for the current picture format; the dimensions change with the format.
+ *
+ * [0]  CEDRUS_ENC_MB_INFO_MAGIC | CEDRUS_ENC_MB_INFO_VERSION | flags
+ * [1]  sequence of the CAPTURE buffer the data belongs to
+ * [2]  mb_w | mb_h << 16
+ * [3]  reserved, 0
+ * [4]  records: mb_h rows of mb_w MBs, each MB a little-endian 64-bit
+ *      record stored as two U32 (low word first), raster order.
+ *      Valid only if CEDRUS_ENC_MB_INFO_FLAG_VALID is set (P-frames).
+ *
+ * Record bits:
+ *   57..55  MB mode: 0 P16x16, 1 P16x8, 2 P8x16, 3 P8x8, 4 I4x4, 5 I16x16,
+ *           7 P_Skip (the vectors hold the predicted skip vector)
+ *   54..47  signed integer-pel MV x
+ *   46..40  signed integer-pel MV y
+ *   39..0   four signed 5-bit quarter-pel remainder pairs (x, y), one per
+ *           8x8 quadrant in raster order, from bit 39 down:
+ *           mv_qpel[q] = 4 * integer + remainder[q]
+ *   63..58  0
+ */
+#define V4L2_CID_CEDRUS_ENC_MB_INFO		(V4L2_CID_USER_CEDRUS_BASE + 1)
+
+#define CEDRUS_ENC_MB_INFO_MAGIC		(0xceU << 24)
+#define CEDRUS_ENC_MB_INFO_MAGIC_MASK		(0xffU << 24)
+#define CEDRUS_ENC_MB_INFO_VERSION		(1U << 16)
+#define CEDRUS_ENC_MB_INFO_VERSION_MASK		(0xffU << 16)
+#define CEDRUS_ENC_MB_INFO_FLAG_VALID		(1U << 0)
+
+#define CEDRUS_ENC_MB_INFO_HDR_ELEMS		4
+#define CEDRUS_ENC_MB_INFO_ELEMS(mb_w, mb_h) \
+	(CEDRUS_ENC_MB_INFO_HDR_ELEMS + 2 * (mb_w) * (mb_h))
+
+#endif
