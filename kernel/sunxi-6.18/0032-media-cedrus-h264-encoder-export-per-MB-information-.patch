diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
index ec9eac5a0..402432eed 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
@@ -22,6 +22,7 @@
 #include "cedrus_engine.h"
 #include "cedrus_proc.h"
 #include "cedrus_regs.h"
+#include "uapi/cedrus-enc.h"
 
 static int rc_i_qp_offset = 2;
 module_param(rc_i_qp_offset, int, 0644);
@@ -522,6 +523,159 @@ static int cedrus_enc_h264_ctrl_prepare(struct cedrus_context *cedrus_ctx,
 	return 0;
 }
 
+/*
+ * MB information control (V4L2_CID_CEDRUS_ENC_MB_INFO): the VE motion vector
+ * records, unrelated to the hardware MB info buffer (mb_info below).
+ */
+
+static unsigned int cedrus_enc_h264_mb_info_elems(struct cedrus_context *ctx)
+{
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+
+	return CEDRUS_ENC_MB_INFO_ELEMS(DIV_ROUND_UP(pix_format->width, 16),
+					DIV_ROUND_UP(pix_format->height, 16));
+}
+
+/*
+ * Size the array to the MB grid of the picture format. v4l2_ctrl_modify_dimensions
+ * also clears it: forced at stream start, so a header of the previous session
+ * (sequence numbers restart at 0) cannot match a new buffer.
+ */
+static int cedrus_enc_h264_mb_info_resize(struct cedrus_context *ctx, bool clear)
+{
+	struct v4l2_ctrl *ctrl =
+		cedrus_context_ctrl_find(ctx, V4L2_CID_CEDRUS_ENC_MB_INFO);
+	u32 dims[V4L2_CTRL_MAX_DIMS] = { cedrus_enc_h264_mb_info_elems(ctx) };
+
+	if (!ctrl || (!clear && ctrl->elems == dims[0]))
+		return 0;
+
+	return v4l2_ctrl_modify_dimensions(ctrl, dims);
+}
+
+static void cedrus_enc_h264_format_picture_update(struct cedrus_context *ctx)
+{
+	if (cedrus_enc_h264_mb_info_resize(ctx, false))
+		dev_warn(ctx->proc->dev->dev, "failed to resize the MB info control\n");
+}
+
+static int cedrus_enc_h264_buffer_coded_setup(struct cedrus_context *ctx,
+					      struct cedrus_buffer *buffer)
+{
+	struct cedrus_enc_h264_coded_buffer *coded;
+	unsigned int elems = cedrus_enc_h264_mb_info_elems(ctx);
+
+	/*
+	 * Sized for the current format: the encoder refuses format changes
+	 * while buffers are allocated, and job_finish checks the capacity.
+	 */
+	coded = kvzalloc(struct_size(coded, image, elems), GFP_KERNEL);
+	if (!coded)
+		return -ENOMEM;
+
+	coded->capacity = elems;
+	buffer->engine_buffer = coded;
+
+	return 0;
+}
+
+static void cedrus_enc_h264_buffer_coded_cleanup(struct cedrus_context *ctx,
+						 struct cedrus_buffer *buffer)
+{
+	kvfree(buffer->engine_buffer);
+	buffer->engine_buffer = NULL;
+}
+
+static void cedrus_enc_h264_buffer_coded_queue(struct cedrus_context *ctx,
+					       struct cedrus_buffer *buffer)
+{
+	struct cedrus_enc_h264_coded_buffer *coded = buffer->engine_buffer;
+
+	if (coded)
+		coded->filled = false;
+}
+
+/*
+ * Runs from vb2 buf_finish: at VIDIOC_DQBUF, but also when the queue is
+ * cancelled, after stop_streaming freed the engine context. Only the buffer
+ * and the context's controls are used.
+ */
+static void cedrus_enc_h264_buffer_coded_finish(struct cedrus_context *ctx,
+						struct cedrus_buffer *buffer)
+{
+	struct cedrus_enc_h264_coded_buffer *coded = buffer->engine_buffer;
+	struct vb2_buffer *vb2_buffer = &buffer->m2m_buffer.vb.vb2_buf;
+	struct v4l2_ctrl *ctrl;
+	unsigned int mb_w, mb_h;
+
+	if (!coded || !coded->filled)
+		return;
+
+	coded->filled = false;
+
+	/* Nobody reads it after STREAMOFF or at close. */
+	if (vb2_buffer->state != VB2_BUF_STATE_DONE ||
+	    !vb2_is_streaming(vb2_buffer->vb2_queue))
+		return;
+
+	ctrl = cedrus_context_ctrl_find(ctx, V4L2_CID_CEDRUS_ENC_MB_INFO);
+	if (!ctrl)
+		return;
+
+	mb_w = coded->image[2] & 0xffff;
+	mb_h = coded->image[2] >> 16;
+
+	/* The core copies ctrl->elems elements: the image must match. */
+	v4l2_ctrl_lock(ctrl);
+	if (ctrl->elems == CEDRUS_ENC_MB_INFO_ELEMS(mb_w, mb_h))
+		__v4l2_ctrl_s_ctrl_compound(ctrl, V4L2_CTRL_TYPE_U32,
+					    coded->image);
+	v4l2_ctrl_unlock(ctrl);
+}
+
+/*
+ * Called from job_finish (IRQ context), before the next job overwrites the
+ * MV buffer: fill the image of the coded buffer. The VE writes the records
+ * of P-frames only, rows of ALIGN(mb_w, 4) MBs.
+ */
+static void cedrus_enc_h264_mb_info_fill(struct cedrus_context *ctx, int state)
+{
+	struct cedrus_enc_h264_context *h264_ctx = ctx->engine_ctx;
+	struct cedrus_enc_h264_job *job = ctx->engine_job;
+	struct vb2_v4l2_buffer *v4l2_buffer = ctx->job.buffer_coded;
+	struct cedrus_enc_h264_coded_buffer *coded =
+		cedrus_job_buffer_coded(ctx)->engine_buffer;
+	unsigned int mb_w = h264_ctx->width_mbs;
+	unsigned int mb_h = h264_ctx->height_mbs;
+	unsigned int stride = ALIGN(mb_w, 4) * 8;
+	unsigned int row;
+	bool valid;
+
+	if (!coded || !h264_ctx->mb_info_enable ||
+	    !READ_ONCE(h264_ctx->mb_info_enable->cur.val))
+		return;
+
+	if (WARN_ON_ONCE(CEDRUS_ENC_MB_INFO_ELEMS(mb_w, mb_h) > coded->capacity))
+		return;
+
+	valid = state == VB2_BUF_STATE_DONE && h264_ctx->mv &&
+		job->frame_type == CEDRUS_ENC_H264_FRAME_TYPE_P;
+
+	coded->image[0] = CEDRUS_ENC_MB_INFO_MAGIC | CEDRUS_ENC_MB_INFO_VERSION |
+			  (valid ? CEDRUS_ENC_MB_INFO_FLAG_VALID : 0);
+	coded->image[1] = v4l2_buffer->sequence;
+	coded->image[2] = mb_w | mb_h << 16;
+	coded->image[3] = 0;
+
+	if (valid)
+		for (row = 0; row < mb_h; row++)
+			memcpy(&coded->image[CEDRUS_ENC_MB_INFO_HDR_ELEMS +
+					     row * mb_w * 2],
+			       h264_ctx->mv + row * stride, mb_w * 8);
+
+	coded->filled = true;
+}
+
 /* Context */
 
 static void cedrus_enc_h264_ref_free(struct device *dev,
@@ -623,6 +777,12 @@ static int cedrus_enc_h264_setup(struct cedrus_context *cedrus_ctx)
 	h264_ctx->deblk = NULL;
 	h264_ctx->mv = NULL;
 	h264_ctx->sequence = 0;
+	h264_ctx->mb_info_enable =
+		cedrus_context_ctrl_find(cedrus_ctx,
+					 V4L2_CID_CEDRUS_ENC_MB_INFO_ENABLE);
+	ret = cedrus_enc_h264_mb_info_resize(cedrus_ctx, true);
+	if (ret)
+		return ret;
 	memset(h264_ctx->refs, 0, sizeof(h264_ctx->refs));
 
 	/* Macroblock Information Buffer */
@@ -1608,6 +1768,8 @@ static int cedrus_enc_h264_job_finish(struct cedrus_context *ctx, int state)
 	ctx->job.buffer_picture->sequence = h264_ctx->sequence;
 	v4l2_buffer->sequence = h264_ctx->sequence++;
 
+	cedrus_enc_h264_mb_info_fill(ctx, state);
+
 	if (state != VB2_BUF_STATE_DONE) {
 		/*
 		 * The reconstruction of this job is unusable and the decoder
@@ -1700,6 +1862,13 @@ static const struct cedrus_engine_ops cedrus_enc_h264_ops = {
 	.job_trigger		= cedrus_enc_h264_job_trigger,
 	.job_finish		= cedrus_enc_h264_job_finish,
 
+	.buffer_coded_setup	= cedrus_enc_h264_buffer_coded_setup,
+	.buffer_coded_cleanup	= cedrus_enc_h264_buffer_coded_cleanup,
+	.buffer_coded_queue	= cedrus_enc_h264_buffer_coded_queue,
+	.buffer_coded_finish	= cedrus_enc_h264_buffer_coded_finish,
+
+	.format_picture_update	= cedrus_enc_h264_format_picture_update,
+
 	.irq_status		= cedrus_enc_h264_irq_status,
 	.irq_clear		= cedrus_enc_h264_irq_clear,
 	.irq_disable		= cedrus_enc_h264_irq_disable,
@@ -1930,6 +2099,32 @@ static const struct v4l2_ctrl_config cedrus_enc_h264_ctrl_configs[] = {
 		.id		= V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME,
 		.ops		= &cedrus_context_ctrl_ops,
 	},
+
+	/*
+	 * MB information. No ops: the driver sets MB_INFO itself, and the
+	 * engine's validate/prepare must not see it.
+	 */
+	{
+		.id		= V4L2_CID_CEDRUS_ENC_MB_INFO_ENABLE,
+		.name		= "MB Information Enable",
+		.type		= V4L2_CTRL_TYPE_BOOLEAN,
+		.min		= 0,
+		.max		= 1,
+		.step		= 1,
+		.def		= 0,
+	},
+	{
+		.id		= V4L2_CID_CEDRUS_ENC_MB_INFO,
+		.name		= "MB Information",
+		.type		= V4L2_CTRL_TYPE_U32,
+		.flags		= V4L2_CTRL_FLAG_READ_ONLY,
+		.min		= 0,
+		.max		= U32_MAX,
+		.step		= 1,
+		.def		= 0,
+		/* Resized to the MB grid by format_picture_update. */
+		.dims		= { CEDRUS_ENC_MB_INFO_ELEMS(1, 1) },
+	},
 };
 
 static const struct v4l2_frmsize_stepwise cedrus_enc_h264_frmsize = {
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.h
index f0ebdb062..0d30b8221 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.h
@@ -119,6 +119,9 @@ struct cedrus_enc_h264_context {
 	 */
 	u32				sequence;
 
+	/* V4L2_CID_CEDRUS_ENC_MB_INFO_ENABLE, read in job_finish. */
+	struct v4l2_ctrl		*mb_info_enable;
+
 	/*
 	 * Two slots: one is reconstructed by the current job, the other holds
 	 * the reference. The roles swap only after a successful encode, so a
@@ -182,6 +185,17 @@ struct cedrus_enc_h264_context {
 };
 
 
+/*
+ * Per coded (CAPTURE) buffer: the V4L2_CID_CEDRUS_ENC_MB_INFO image of the
+ * frame encoded into it, filled in job_finish and published to the control
+ * when the buffer is dequeued.
+ */
+struct cedrus_enc_h264_coded_buffer {
+	bool		filled;
+	unsigned int	capacity;
+	u32		image[];
+};
+
 extern const struct cedrus_engine cedrus_enc_h264;
 
 static inline u8 cedrus_enc_h264_nalu_header(u8 type, u8 ref_idc)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_engine.c b/drivers/staging/media/sunxi/cedrus/cedrus_engine.c
index a2591597d..54296d9ee 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_engine.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_engine.c
@@ -147,6 +147,69 @@ void cedrus_engine_buffer_cleanup(struct cedrus_context *ctx,
 	engine->ops->buffer_cleanup(ctx, buffer);
 }
 
+int cedrus_engine_buffer_coded_setup(struct cedrus_context *ctx,
+				     struct cedrus_buffer *buffer)
+{
+	const struct cedrus_engine *engine = ctx->engine;
+
+	if (WARN_ON(!engine || !engine->ops))
+		return -ENODEV;
+
+	if (!engine->ops->buffer_coded_setup)
+		return 0;
+
+	return engine->ops->buffer_coded_setup(ctx, buffer);
+}
+
+void cedrus_engine_buffer_coded_cleanup(struct cedrus_context *ctx,
+					struct cedrus_buffer *buffer)
+{
+	const struct cedrus_engine *engine = ctx->engine;
+
+	if (WARN_ON(!engine || !engine->ops) ||
+	    !engine->ops->buffer_coded_cleanup)
+		return;
+
+	engine->ops->buffer_coded_cleanup(ctx, buffer);
+}
+
+void cedrus_engine_buffer_coded_queue(struct cedrus_context *ctx,
+				      struct cedrus_buffer *buffer)
+{
+	const struct cedrus_engine *engine = ctx->engine;
+
+	if (WARN_ON(!engine || !engine->ops) ||
+	    !engine->ops->buffer_coded_queue)
+		return;
+
+	engine->ops->buffer_coded_queue(ctx, buffer);
+}
+
+void cedrus_engine_buffer_coded_finish(struct cedrus_context *ctx,
+				       struct cedrus_buffer *buffer)
+{
+	const struct cedrus_engine *engine = ctx->engine;
+
+	if (WARN_ON(!engine || !engine->ops) ||
+	    !engine->ops->buffer_coded_finish)
+		return;
+
+	engine->ops->buffer_coded_finish(ctx, buffer);
+}
+
+/* Format */
+
+void cedrus_engine_format_picture_update(struct cedrus_context *ctx)
+{
+	const struct cedrus_engine *engine = ctx->engine;
+
+	if (WARN_ON(!engine || !engine->ops) ||
+	    !engine->ops->format_picture_update)
+		return;
+
+	engine->ops->format_picture_update(ctx);
+}
+
 /* Job */
 
 int cedrus_engine_job_prepare(struct cedrus_context *ctx)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_engine.h b/drivers/staging/media/sunxi/cedrus/cedrus_engine.h
index f5d21549a..ccd5e37bd 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_engine.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_engine.h
@@ -32,6 +32,22 @@ struct cedrus_engine_ops {
 	void (*buffer_cleanup)(struct cedrus_context *ctx,
 			       struct cedrus_buffer *buffer);
 
+	/*
+	 * Coded buffers. buffer_coded_finish runs from vb2 buf_finish, also
+	 * after stop_streaming freed the engine context: it must only use the
+	 * buffer and the context's controls.
+	 */
+	int (*buffer_coded_setup)(struct cedrus_context *ctx,
+				  struct cedrus_buffer *buffer);
+	void (*buffer_coded_cleanup)(struct cedrus_context *ctx,
+				     struct cedrus_buffer *buffer);
+	void (*buffer_coded_queue)(struct cedrus_context *ctx,
+				   struct cedrus_buffer *buffer);
+	void (*buffer_coded_finish)(struct cedrus_context *ctx,
+				    struct cedrus_buffer *buffer);
+
+	void (*format_picture_update)(struct cedrus_context *ctx);
+
 	int (*job_prepare)(struct cedrus_context *ctx);
 	int (*job_configure)(struct cedrus_context *ctx);
 	void (*job_trigger)(struct cedrus_context *ctx);
@@ -93,6 +109,15 @@ int cedrus_engine_buffer_setup(struct cedrus_context *ctx,
 			       struct cedrus_buffer *buffer);
 void cedrus_engine_buffer_cleanup(struct cedrus_context *ctx,
 				  struct cedrus_buffer *buffer);
+int cedrus_engine_buffer_coded_setup(struct cedrus_context *ctx,
+				     struct cedrus_buffer *buffer);
+void cedrus_engine_buffer_coded_cleanup(struct cedrus_context *ctx,
+					struct cedrus_buffer *buffer);
+void cedrus_engine_buffer_coded_queue(struct cedrus_context *ctx,
+				      struct cedrus_buffer *buffer);
+void cedrus_engine_buffer_coded_finish(struct cedrus_context *ctx,
+				       struct cedrus_buffer *buffer);
+void cedrus_engine_format_picture_update(struct cedrus_context *ctx);
 
 /* Job */
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_proc.c b/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
index d77804b19..20771f7e6 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
@@ -458,6 +458,8 @@ static int cedrus_proc_s_fmt(struct file *file, void *private,
 		ret = cedrus_context_engine_update(ctx);
 		if (ret)
 			return ret;
+	} else {
+		cedrus_engine_format_picture_update(ctx);
 	}
 
 	return 0;
