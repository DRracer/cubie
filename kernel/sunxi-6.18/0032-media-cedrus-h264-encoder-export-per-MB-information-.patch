diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_context.c b/drivers/staging/media/sunxi/cedrus/cedrus_context.c
index aad81ec4a..39829cabf 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_context.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_context.c
@@ -483,6 +483,9 @@ static int cedrus_context_buffer_init(struct vb2_buffer *vb2_buffer)
 		cedrus_proc_format_type(ctx->proc, vb2_buffer->type);
 	int ret;
 
+	if (format_type == CEDRUS_FORMAT_TYPE_CODED)
+		return cedrus_engine_buffer_coded_setup(ctx, cedrus_buffer);
+
 	if (!engine->buffer_size)
 		return 0;
 
@@ -515,6 +518,11 @@ static void cedrus_context_buffer_cleanup(struct vb2_buffer *vb2_buffer)
 	unsigned int format_type =
 		cedrus_proc_format_type(ctx->proc, vb2_buffer->type);
 
+	if (format_type == CEDRUS_FORMAT_TYPE_CODED) {
+		cedrus_engine_buffer_coded_cleanup(ctx, cedrus_buffer);
+		return;
+	}
+
 	if (format_type == CEDRUS_FORMAT_TYPE_PICTURE &&
 	    cedrus_buffer->engine_buffer) {
 		cedrus_engine_buffer_cleanup(ctx, cedrus_buffer);
@@ -564,6 +572,11 @@ static void cedrus_context_buffer_queue(struct vb2_buffer *vb2_buffer)
 	struct vb2_v4l2_buffer *v4l2_buffer = to_vb2_v4l2_buffer(vb2_buffer);
 	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
 
+	if (cedrus_proc_format_type(ctx->proc, vb2_buffer->type) ==
+	    CEDRUS_FORMAT_TYPE_CODED)
+		cedrus_engine_buffer_coded_queue(ctx,
+						 cedrus_buffer_from_vb2(vb2_buffer));
+
 	if (ctx->proc->role == CEDRUS_ROLE_ENCODER &&
 	    V4L2_TYPE_IS_CAPTURE(vb2_buffer->vb2_queue->type) &&
 	    vb2_is_streaming(vb2_buffer->vb2_queue) &&
@@ -577,6 +590,16 @@ static void cedrus_context_buffer_queue(struct vb2_buffer *vb2_buffer)
 	v4l2_m2m_buf_queue(m2m_ctx, v4l2_buffer);
 }
 
+static void cedrus_context_buffer_finish(struct vb2_buffer *vb2_buffer)
+{
+	struct cedrus_context *ctx = vb2_get_drv_priv(vb2_buffer->vb2_queue);
+
+	if (cedrus_proc_format_type(ctx->proc, vb2_buffer->type) ==
+	    CEDRUS_FORMAT_TYPE_CODED)
+		cedrus_engine_buffer_coded_finish(ctx,
+						  cedrus_buffer_from_vb2(vb2_buffer));
+}
+
 static int cedrus_context_buffer_validate(struct vb2_buffer *vb2_buffer)
 {
 	struct vb2_v4l2_buffer *v4l2_buffer = to_vb2_v4l2_buffer(vb2_buffer);
@@ -705,6 +728,7 @@ static const struct vb2_ops cedrus_context_queue_ops = {
 	.buf_cleanup		= cedrus_context_buffer_cleanup,
 	.buf_prepare		= cedrus_context_buffer_prepare,
 	.buf_queue		= cedrus_context_buffer_queue,
+	.buf_finish		= cedrus_context_buffer_finish,
 	.buf_out_validate	= cedrus_context_buffer_validate,
 	.buf_request_complete	= cedrus_context_buffer_complete,
 	.start_streaming	= cedrus_context_start_streaming,
@@ -801,6 +825,9 @@ int cedrus_context_setup(struct cedrus_proc *proc, struct cedrus_context *ctx,
 	if (ret)
 		goto error_ctrls;
 
+	/* Controls that follow the picture format (default format). */
+	cedrus_engine_format_picture_update(ctx);
+
 	/* V4L2 File Handler */
 
 	v4l2_fh_add(fh, file);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_context.h b/drivers/staging/media/sunxi/cedrus/cedrus_context.h
index ae7f30f4f..4cf78b2cd 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_context.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_context.h
@@ -30,6 +30,7 @@ struct cedrus_job {
 
