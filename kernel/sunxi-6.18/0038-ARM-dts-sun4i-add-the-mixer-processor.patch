From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Fri, 30 Oct 2026 18:49:35 +0100
Subject: [PATCH] ARM: dts: sun4i: add the mixer processor

The A10 has the same mixer processor (2D engine) as the A20, at the
same address and with the same clocks, reset and interrupt line.

Tested on a Rikomagic MK802 (A10, 1 GiB).

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm/boot/dts/allwinner/sun4i-a10.dtsi | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun4i-a10.dtsi b/arch/arm/boot/dts/allwinner/sun4i-a10.dtsi
index 08a8433b5..bcfa73c0e 100644
--- a/arch/arm/boot/dts/allwinner/sun4i-a10.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun4i-a10.dtsi
@@ -1269,5 +1269,18 @@ be0_out_tcon1: endpoint@1 {
 				};
 			};
 		};
+
+		mixer-processor@1e80000 {
+			compatible = "allwinner,sun4i-a10-mixer-processor";
+			reg = <0x01e80000 0x20000>;
+			interrupts = <46>;
+			clocks = <&ccu CLK_AHB_MP>, <&ccu CLK_DE_MP>,
+				 <&ccu CLK_DRAM_MP>;
+			clock-names = "ahb", "mod", "ram";
+			resets = <&ccu RST_DE_MP>;
+			assigned-clocks = <&ccu CLK_DE_MP>;
+			assigned-clock-parents = <&ccu CLK_PLL_DDR_OTHER>;
+			assigned-clock-rates = <240000000>;
+		};
 	};
 };
