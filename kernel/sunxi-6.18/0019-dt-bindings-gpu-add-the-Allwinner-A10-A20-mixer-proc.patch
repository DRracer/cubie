From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Tue, 20 Oct 2026 06:33:29 +0200
Subject: [PATCH] dt-bindings: gpu: add the Allwinner A10/A20 mixer
 processor

The A20 has a 2D engine at 0x01e80000 that the user manual calls the
mixer processor (MP); the vendor kernel called it G2D. It copies, fills,
blends, rotates and scales rectangles in memory and is a DRAM bus (MBUS)
master. It has its own interrupt, AHB and DRAM gates, module clock and
reset line.

The A10 has the same block at the same address. Its manual does not
document it, but the vendor kernel drives both with the same code, and
the driver passes the same tests on the A10. The A20 node lists the A10
compatible as its fallback.

Assisted-by: Claude:claude-opus-5-5
---
 .../allwinner,sun4i-a10-mixer-processor.yaml  | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpu/allwinner,sun4i-a10-mixer-processor.yaml

diff --git a/Documentation/devicetree/bindings/gpu/allwinner,sun4i-a10-mixer-processor.yaml b/Documentation/devicetree/bindings/gpu/allwinner,sun4i-a10-mixer-processor.yaml
new file mode 100644
index 000000000..d0a6e8763
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpu/allwinner,sun4i-a10-mixer-processor.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpu/allwinner,sun4i-a10-mixer-processor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A10/A20 Mixer Processor
+
+maintainers:
+  - D.R.racer <drracer@seznam.cz>
+
+description:
+  The mixer processor (MP, also known as G2D) is a 2D engine. It copies,
+  fills, blends, rotates and scales rectangles between images in memory.
+  It is a master on the DRAM bus (MBUS) and works on physically contiguous
+  buffers only.
+
+properties:
+  compatible:
+    oneOf:
+      - const: allwinner,sun4i-a10-mixer-processor
+      - items:
+          - const: allwinner,sun7i-a20-mixer-processor
+          - const: allwinner,sun4i-a10-mixer-processor
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Bus clock
+      - description: Module clock
+      - description: DRAM clock
+
+  clock-names:
+    items:
+      - const: ahb
+      - const: mod
+      - const: ram
+
+  resets:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun7i-a20-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/sun4i-a10-ccu.h>
+
+    mixer-processor@1e80000 {
+        compatible = "allwinner,sun7i-a20-mixer-processor",
+                     "allwinner,sun4i-a10-mixer-processor";
+        reg = <0x01e80000 0x20000>;
+        interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&ccu CLK_AHB_MP>, <&ccu CLK_DE_MP>, <&ccu CLK_DRAM_MP>;
+        clock-names = "ahb", "mod", "ram";
+        resets = <&ccu RST_DE_MP>;
+        assigned-clocks = <&ccu CLK_DE_MP>;
+        assigned-clock-parents = <&ccu CLK_PLL_DDR_OTHER>;
+        assigned-clock-rates = <240000000>;
+    };
+
+...
