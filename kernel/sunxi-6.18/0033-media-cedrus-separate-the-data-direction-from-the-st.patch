diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index c781651c1..17bea818f 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -164,8 +164,9 @@ static void cedrus_watchdog(struct work_struct *work)
 		return;
 
 	v4l2_err(v4l2_dev, "frame processing timed out! (%s)\n",
-		 ctx->proc->role == CEDRUS_ROLE_ENCODER ? "encoder" : "decoder");
+		 ctx->proc->v4l2.video_dev.name);
 	reset_control_reset(cedrus_dev->reset);
+	cedrus_dev->last_job_engine = NULL;
 
 	cedrus_context_job_finish(ctx, VB2_BUF_STATE_ERROR);
 }
@@ -179,27 +180,24 @@ static void cedrus_irq_disable_clear(struct cedrus_context *ctx)
 
 static void cedrus_irq_spurious(struct cedrus_device *dev)
 {
-	struct cedrus_proc *proc;
+	unsigned int i;
 
-	/* Disable/clear IRQ on the decoder. */
+	/* Disable/clear IRQ on every node that has an active context. */
 
-	proc = &dev->dec;
-	spin_lock(&proc->ctx_active_lock);
+	for (i = 0; i < CEDRUS_PROCS_COUNT; i++) {
+		struct cedrus_proc *proc = dev->procs[i];
 
-	if (proc->ctx_active)
-		cedrus_irq_disable_clear(proc->ctx_active);
+		/* Not set up (no engine on this variant). */
+		if (!proc->engines)
+			continue;
 
-	spin_unlock(&proc->ctx_active_lock);
+		spin_lock(&proc->ctx_active_lock);
 
-	/* Disable/clear IRQ on the encoder. */
+		if (proc->ctx_active)
+			cedrus_irq_disable_clear(proc->ctx_active);
 
-	proc = &dev->enc;
-	spin_lock(&proc->ctx_active_lock);
-
-	if (proc->ctx_active)
-		cedrus_irq_disable_clear(proc->ctx_active);
-
-	spin_unlock(&proc->ctx_active_lock);
+		spin_unlock(&proc->ctx_active_lock);
+	}
 }
 
 static irqreturn_t cedrus_irq(int irq, void *private)
@@ -240,9 +238,11 @@ static irqreturn_t cedrus_irq(int irq, void *private)
 
 	if (status == CEDRUS_IRQ_ERROR) {
 		state = VB2_BUF_STATE_ERROR;
-		/* A stalled encoder may still be busy: reset like the watchdog. */
-		if (ctx->proc->role == CEDRUS_ROLE_ENCODER)
+		/* A stalled engine may still be busy: reset like the watchdog. */
+		if (ctx->engine->reset_on_error) {
 			reset_control_reset(cedrus_dev->reset);
+			cedrus_dev->last_job_engine = NULL;
+		}
 	} else {
 		state = VB2_BUF_STATE_DONE;
 	}
@@ -275,6 +275,7 @@ static int cedrus_resume(struct device *dev)
 		dev_err(dev, "failed to reset\n");
 		return ret;
 	}
+	cedrus_dev->last_job_engine = NULL;
 
 	ret = clk_prepare_enable(cedrus_dev->clock_ahb);
 	if (ret) {
@@ -491,7 +492,8 @@ static int cedrus_probe(struct platform_device *platform_dev)
 	platform_set_drvdata(platform_dev, cedrus_dev);
 
 	INIT_DELAYED_WORK(&cedrus_dev->watchdog_work, cedrus_watchdog);
-	cedrus_dev->last_job_role = -1;
+	cedrus_dev->procs[0] = &cedrus_dev->dec;
+	cedrus_dev->procs[1] = &cedrus_dev->enc;
 
 	ret = cedrus_resources_setup(cedrus_dev, platform_dev);
 	if (ret)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 1b87998ba..0e69919a2 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -71,6 +71,7 @@ enum cedrus_capability {
 };
 
 struct cedrus_context;
+struct cedrus_engine;
 
 /*
  * Encoder hardware generation. The A10/A20 (VE 0x1623/0x1625) AVC encoder
@@ -98,6 +99,9 @@ struct cedrus_format {
 	int		type;
 };
 
+/* Video nodes (procs) of the device, see cedrus_device.procs. */
+#define CEDRUS_PROCS_COUNT	2
+
 struct cedrus_v4l2 {
 	struct v4l2_device	v4l2_dev;
 	struct media_device	media_dev;
@@ -110,6 +114,8 @@ struct cedrus_device {
 	struct cedrus_v4l2	v4l2;
 	struct cedrus_proc	dec;
 	struct cedrus_proc	enc;
+	/* All of the above, for code that handles every node alike. */
+	struct cedrus_proc	*procs[CEDRUS_PROCS_COUNT];
 
 	void __iomem		*io_base;
 	struct clk		*clock_ahb;
@@ -124,8 +130,11 @@ struct cedrus_device {
 	struct delayed_work	watchdog_work;
 	u64			dma_window;
 
-	/* Role of the last job (encoder/decoder), -1 after probe or reset. */
-	int			last_job_role;
+	/*
+	 * Engine of the last job; NULL while the VE is in a known state (after
+	 * probe, runtime resume or a reset), so the next job needs no reset.
+	 */
+	const struct cedrus_engine	*last_job_engine;
 };
 
 /* Capabilities */
