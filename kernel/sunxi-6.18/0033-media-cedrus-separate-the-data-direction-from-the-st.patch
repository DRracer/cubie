+#include <linux/ktime.h>
 #include <linux/reset.h>
 #include <linux/pm_runtime.h>
 #include <linux/videodev2.h>
@@ -112,9 +113,6 @@ static int cedrus_context_ctrls_setup(struct cedrus_context *ctx)
 	for (i = 0; i < proc->engines_count; i++)
 		count += proc->engines[i]->ctrl_configs_count;
 
-	if (WARN_ON(!count))
-		return -ENODEV;
-
 	/* Last entry is a zero sentinel. */
 	size = sizeof(*v4l2->ctrls) * (count + 1);
 
@@ -230,7 +228,7 @@ static void cedrus_context_streaming_update(struct cedrus_context *ctx,
 {
 	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
 
-	if (ctx->proc->role != CEDRUS_ROLE_ENCODER)
+	if (!ctx->proc->stateful)
 		return;
 
 	if (start) {
@@ -256,7 +254,7 @@ void cedrus_context_job_finish(struct cedrus_context *ctx, int state)
 	memset(&ctx->job, 0, sizeof(ctx->job));
 
 	/* Draining: flag the output of the last source buffer and signal EOS. */
-	if (proc->role == CEDRUS_ROLE_ENCODER) {
+	if (proc->stateful) {
 		struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(m2m_ctx);
 		struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(m2m_ctx);
 
@@ -330,12 +328,19 @@ int cedrus_context_job_run(struct cedrus_context *ctx)
 
 	/*
 	 * Decode jobs time out on the A20 when they follow encode jobs
-	 * (interleaved sessions): reset the VE whenever the role changes.
+	 * (interleaved sessions), and engines share state such as VE_MODE:
+	 * reset the VE whenever the engine changes. NULL means the VE is in a
+	 * known state already.
 	 */
-	if (cedrus_dev->last_job_role != ctx->proc->role) {
-		if (cedrus_dev->last_job_role >= 0)
+	if (cedrus_dev->last_job_engine != ctx->engine) {
+		if (cedrus_dev->last_job_engine) {
+			ktime_t start = ktime_get();
+
 			reset_control_reset(cedrus_dev->reset);
-		cedrus_dev->last_job_role = ctx->proc->role;
+			dev_dbg(cedrus_dev->dev, "VE reset took %lld us\n",
+				ktime_us_delta(ktime_get(), start));
+		}
+		cedrus_dev->last_job_engine = ctx->engine;
 	}
 
 	/* Configure coded and picture formats. */
@@ -577,7 +582,7 @@ static void cedrus_context_buffer_queue(struct vb2_buffer *vb2_buffer)
 		cedrus_engine_buffer_coded_queue(ctx,
 						 cedrus_buffer_from_vb2(vb2_buffer));
 
-	if (ctx->proc->role == CEDRUS_ROLE_ENCODER &&
+	if (ctx->proc->stateful &&
 	    V4L2_TYPE_IS_CAPTURE(vb2_buffer->vb2_queue->type) &&
 	    vb2_is_streaming(vb2_buffer->vb2_queue) &&
 	    v4l2_m2m_dst_buf_is_last(m2m_ctx)) {
@@ -750,19 +755,14 @@ static int cedrus_context_queue_init(void *private, struct vb2_queue *src_queue,
 	src_queue->ops = &cedrus_context_queue_ops;
 	src_queue->mem_ops = &vb2_dma_contig_memops;
 	src_queue->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
-	src_queue->supports_requests = true;
+	src_queue->supports_requests = proc->supports_requests;
 	src_queue->lock = &proc->v4l2.lock;
 	src_queue->dev = proc->dev->dev;
 	src_queue->dma_attrs = CEDRUS_HW_BUF_ATTRS;
 	src_queue->drv_priv = ctx;
 
-	/*
-	 * FIXME: The current encoder implementation doesn't particularly rely
-	 * on requests, but it might become necessary for some codecs so this
-	 * should be set dynamically later on.
-	 */
-	if (proc->role == CEDRUS_ROLE_DECODER)
-		src_queue->requires_requests = true;
+	/* Stateless decoding passes every frame's parameters in a request. */
+	src_queue->requires_requests = !proc->stateful;
 
 	ret = vb2_queue_init(src_queue);
 	if (ret)
