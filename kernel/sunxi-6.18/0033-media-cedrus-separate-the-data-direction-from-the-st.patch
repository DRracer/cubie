diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_proc.c b/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
index 20771f7e6..2e9752100 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
@@ -714,16 +714,69 @@ static int cedrus_proc_encoder_cmd(struct file *file, void *private,
 	return 0;
 }
 
+static int cedrus_proc_decoder_cmd(struct file *file, void *private,
+				   struct v4l2_decoder_cmd *decoder_cmd)
+{
+	struct cedrus_context *ctx = cedrus_file2context(file);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
+	bool stopped;
+	int ret;
+
+	if (!ctx->proc->stateful)
+		return v4l2_m2m_ioctl_stateless_decoder_cmd(file, private,
+							    decoder_cmd);
+
+	/* Stateful: drain like the encoder (cedrus_proc_encoder_cmd). */
+
+	stopped = v4l2_m2m_has_stopped(m2m_ctx);
+
+	ret = v4l2_m2m_ioctl_try_decoder_cmd(file, private, decoder_cmd);
+	if (ret)
+		return ret;
+
+	if (!vb2_is_streaming(v4l2_m2m_get_src_vq(m2m_ctx)))
+		return 0;
+
+	ret = v4l2_m2m_ioctl_decoder_cmd(file, private, decoder_cmd);
+	if (ret)
+		return ret;
+
+	if (decoder_cmd->cmd == V4L2_DEC_CMD_STOP &&
+	    v4l2_m2m_has_stopped(m2m_ctx))
+		cedrus_context_eos(ctx);
+
+	if (decoder_cmd->cmd == V4L2_DEC_CMD_START && stopped)
+		vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(m2m_ctx));
+
+	return 0;
+}
+
+static int cedrus_proc_try_decoder_cmd(struct file *file, void *private,
+				       struct v4l2_decoder_cmd *decoder_cmd)
+{
+	struct cedrus_context *ctx = cedrus_file2context(file);
+
+	if (!ctx->proc->stateful)
+		return v4l2_m2m_ioctl_stateless_try_decoder_cmd(file, private,
+								decoder_cmd);
+
+	return v4l2_m2m_ioctl_try_decoder_cmd(file, private, decoder_cmd);
+}
+
 static int cedrus_proc_subscribe_event(struct v4l2_fh *fh,
 				       const struct v4l2_event_subscription *sub)
 {
 	struct cedrus_context *ctx =
 		container_of(fh, struct cedrus_context, v4l2.fh);
+	struct cedrus_proc *proc = ctx->proc;
 
-	if (sub->type == V4L2_EVENT_EOS &&
-	    ctx->proc->role == CEDRUS_ROLE_ENCODER)
+	if (sub->type == V4L2_EVENT_EOS && proc->stateful)
 		return v4l2_event_subscribe(fh, sub, 2, NULL);
 
+	if (sub->type == V4L2_EVENT_SOURCE_CHANGE && proc->stateful &&
+	    proc->role == CEDRUS_ROLE_DECODER)
+		return v4l2_src_change_event_subscribe(fh, sub);
+
 	return v4l2_ctrl_subscribe_event(fh, sub);
 }
 
@@ -760,8 +813,8 @@ static const struct v4l2_ioctl_ops cedrus_proc_ioctl_ops = {
 	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
 	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
 
-	.vidioc_decoder_cmd		= v4l2_m2m_ioctl_stateless_decoder_cmd,
-	.vidioc_try_decoder_cmd		= v4l2_m2m_ioctl_stateless_try_decoder_cmd,
+	.vidioc_decoder_cmd		= cedrus_proc_decoder_cmd,
+	.vidioc_try_decoder_cmd		= cedrus_proc_try_decoder_cmd,
 
 	.vidioc_encoder_cmd		= cedrus_proc_encoder_cmd,
 	.vidioc_try_encoder_cmd		= v4l2_m2m_ioctl_try_encoder_cmd,
@@ -863,7 +916,8 @@ static int cedrus_proc_v4l2_setup_entity(struct cedrus_proc *proc,
 	return 0;
 }
 
-static int cedrus_proc_v4l2_setup(struct cedrus_proc *proc)
+static int cedrus_proc_v4l2_setup(struct cedrus_proc *proc,
+				  const char *name)
 {
 	struct cedrus_proc_v4l2 *v4l2 = &proc->v4l2;
 	struct v4l2_device *v4l2_dev = &proc->dev->v4l2.v4l2_dev;
@@ -871,20 +925,14 @@ static int cedrus_proc_v4l2_setup(struct cedrus_proc *proc)
 	struct video_device *video_dev = &v4l2->video_dev;
 	struct media_link *link;
 	unsigned int function;
-	const char *suffix;
 	int ret;
 
 	mutex_init(&v4l2->lock);
 
 	/* Video Device */
 
-	if (proc->role == CEDRUS_ROLE_DECODER)
-		suffix = "dec";
-	else
-		suffix = "enc";
-
 	snprintf(video_dev->name, sizeof(video_dev->name), CEDRUS_NAME "-%s",
-		 suffix);
+		 name);
 	video_dev->device_caps = V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING;
 	video_dev->vfl_dir = VFL_DIR_M2M;
 	video_dev->release = video_device_release_empty;
@@ -897,7 +945,9 @@ static int cedrus_proc_v4l2_setup(struct cedrus_proc *proc)
 
 	if (proc->role == CEDRUS_ROLE_DECODER) {
 		v4l2_disable_ioctl(video_dev, VIDIOC_ENUM_FRAMEINTERVALS);
-		v4l2_disable_ioctl(video_dev, VIDIOC_G_SELECTION);
+		/* Stateful decoders report the visible area as compose. */
+		if (!proc->stateful)
+			v4l2_disable_ioctl(video_dev, VIDIOC_G_SELECTION);
 		v4l2_disable_ioctl(video_dev, VIDIOC_S_SELECTION);
 		v4l2_disable_ioctl(video_dev, VIDIOC_G_PARM);
 		v4l2_disable_ioctl(video_dev, VIDIOC_S_PARM);
@@ -1045,6 +1095,8 @@ int cedrus_proc_setup(struct cedrus_device *dev, struct cedrus_proc *proc,
 	proc->dev = dev;
 	proc->ops = ops;
 	proc->role = config->role;
+	proc->stateful = config->stateful;
+	proc->supports_requests = config->supports_requests;
 
 	spin_lock_init(&proc->ctx_active_lock);
 
@@ -1058,7 +1110,7 @@ int cedrus_proc_setup(struct cedrus_device *dev, struct cedrus_proc *proc,
 	if (ret)
 		return ret;
 
-	ret = cedrus_proc_v4l2_setup(proc);
+	ret = cedrus_proc_v4l2_setup(proc, config->name);
 	if (ret)
 		return ret;
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_proc.h b/drivers/staging/media/sunxi/cedrus/cedrus_proc.h
