+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Baseline JPEG encoding on the A10/A20 H.264 encoder block.
+ */
+
+#ifndef _CEDRUS_ENC_JPEG_H_
+#define _CEDRUS_ENC_JPEG_H_
+
+#include <linux/types.h>
+
+struct v4l2_ctrl;
+
+/* The A20 ISP's stride limit (cedrus_enc_stride_max) bounds the width. */
+#define CEDRUS_ENC_JPEG_WIDTH_MAX	4080
+#define CEDRUS_ENC_JPEG_HEIGHT_MAX	4096
+
+struct cedrus_enc_jpeg_context {
+	struct v4l2_ctrl	*quality;
+	u32			sequence;
+};
+
+struct cedrus_enc_jpeg_job {
+	u8		qt[2][64];
+	/* 623 bytes plus up to 3 fill bytes. */
+	u8		header[640];
+	unsigned int	header_len;
+};
+
+extern const struct cedrus_engine cedrus_enc_jpeg;
+
+#endif
