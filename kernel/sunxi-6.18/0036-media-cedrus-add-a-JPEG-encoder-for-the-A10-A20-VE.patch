diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
new file mode 100644
index 000000000..551bc847a
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Baseline JPEG encoding (4:2:0) on the A10/A20 H.264 encoder block in JPEG
+ * mode. The kernel writes the headers and EOI; the VE quantises with the
+ * tables uploaded to its SRAM and codes the scan with the standard (Annex K)
+ * Huffman tables, which it has built in.
+ *
+ * Found on the A20 (Cubietruck) and kept by this engine:
+ * - The VE's bit writer latches its position when the stream addresses are
+ *   written: VLE_OFFSET must be written before START/END/MAX, or the scan
+ *   overwrites the header from the buffer start. It also merges a partial last
+ *   header word wrongly, so the header is padded to a multiple of 4 bytes with
+ *   0xff fill bytes before SOS (ITU-T T.81 B.1.1.2).
+ * - The DC level shift is an integer bias 0x400 / Qdc subtracted after
+ *   quantisation, exact only if Qdc divides 1024: both DC quantisers are
+ *   rounded down to a power of two (the DQT carries them).
+ * - The quantiser multiplies by a 16-bit reciprocal; for Q = 1 (0xffff) every
+ *   level would come out one too low, so its rounding term is 1, not Q / 2.
+ * - The scan is padded with 0-bits to a byte boundary; the length register is
+ *   in bits.
+ */
+
+#include <linux/dma-direction.h>
+#include <linux/log2.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-jpeg.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_enc.h"
+#include "cedrus_enc_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_regs.h"
+
+/* Format */
+
+static int cedrus_enc_jpeg_format_coded_prepare(struct cedrus_context *ctx,
+						struct v4l2_format *format)
+{
+	struct v4l2_pix_format *pix_format = &format->fmt.pix;
+	struct v4l2_pix_format *picture = &ctx->v4l2.format_picture.fmt.pix;
+	int ret;
+
+	ret = cedrus_enc_format_coded_prepare(ctx, format);
+	if (ret)
+		return ret;
+
+	/*
+	 * Photos at quality 100 fit in 12 bits per pixel plus the header; noise
+	 * does not, and comes back as an error (the client then allocates
+	 * bigger buffers). The VE is given at most 256 MiB.
+	 */
+	pix_format->sizeimage = ALIGN(clamp_t(u32, pix_format->sizeimage,
+					      picture->width * picture->height *
+					      3 / 2 + SZ_4K, SZ_256M), SZ_8K);
+
+	/* The shorthand for the picture's sRGB, 601, full range. */
+	pix_format->colorspace = V4L2_COLORSPACE_JPEG;
+	pix_format->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+	pix_format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix_format->quantization = V4L2_QUANTIZATION_DEFAULT;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_format_coded_configure(struct cedrus_context *ctx)
+{
+	cedrus_write(ctx->proc->dev, VE_MODE_REG, VE_MODE_ENC_A20);
+
+	return 0;
+}
+
+/* Tables and header */
+
+/* libjpeg jpeg_set_quality(force_baseline), natural order, DC as the VE needs. */
+static void cedrus_enc_jpeg_qtables(unsigned int quality, u8 qt[2][64])
+{
+	static const u8 *const base[2] = {
+		v4l2_jpeg_ref_table_luma_qt, v4l2_jpeg_ref_table_chroma_qt,
+	};
+	unsigned int scale, t, i;
+
+	quality = clamp(quality, 1U, 100U);
+	scale = quality < 50 ? 5000 / quality : 200 - 2 * quality;
+
+	for (t = 0; t < 2; t++) {
+		for (i = 0; i < 64; i++)
+			qt[t][i] = clamp((base[t][i] * scale + 50) / 100, 1U,
+					 255U);
+		qt[t][0] = rounddown_pow_of_two(qt[t][0]);
+	}
+}
+
+static unsigned int cedrus_enc_jpeg_seg(u8 *p, u8 marker, unsigned int len)
+{
+	p[0] = 0xff;
+	p[1] = marker;
+	p[2] = (len + 2) >> 8;
+	p[3] = (len + 2) & 0xff;
+
+	return 4;
+}
+
+/* SOI, APP0 (JFIF 1.01), DQT, SOF0, DHT, fill bytes, SOS; returns its size. */
+static unsigned int cedrus_enc_jpeg_header(u8 *p, unsigned int width,
+					   unsigned int height,
+					   const u8 qt[2][64])
+{
+	static const u8 app0[] = {
+		'J', 'F', 'I', 'F', 0, 1, 1, 0, 0, 1, 0, 1, 0, 0,
+	};
+	static const u8 sof[] = {
+		3, 1, 0x22, 0, 2, 0x11, 1, 3, 0x11, 1,
+	};
+	static const u8 sos[] = {
+		3, 1, 0x00, 2, 0x11, 3, 0x11, 0, 63, 0,
+	};
+	static const struct {
+		u8		tc_th;
+		const u8	*table;
+		unsigned int	len;
+	} dht[] = {
+		{ 0x00, v4l2_jpeg_ref_table_luma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ 0x10, v4l2_jpeg_ref_table_luma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+		{ 0x01, v4l2_jpeg_ref_table_chroma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ 0x11, v4l2_jpeg_ref_table_chroma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+	};
+	unsigned int n = 0, t, i;
+
+	p[n++] = 0xff;
+	p[n++] = 0xd8;
+
+	n += cedrus_enc_jpeg_seg(p + n, 0xe0, sizeof(app0));
+	memcpy(p + n, app0, sizeof(app0));
+	n += sizeof(app0);
+
+	for (t = 0; t < 2; t++) {
+		n += cedrus_enc_jpeg_seg(p + n, 0xdb, 65);
+		p[n++] = t;
+		for (i = 0; i < 64; i++)
+			p[n++] = qt[t][v4l2_jpeg_zigzag_scan_index[i]];
+	}
+
+	n += cedrus_enc_jpeg_seg(p + n, 0xc0, 5 + sizeof(sof));
+	p[n++] = 8;
+	p[n++] = height >> 8;
+	p[n++] = height & 0xff;
+	p[n++] = width >> 8;
+	p[n++] = width & 0xff;
+	memcpy(p + n, sof, sizeof(sof));
+	n += sizeof(sof);
+
+	for (t = 0; t < ARRAY_SIZE(dht); t++) {
+		n += cedrus_enc_jpeg_seg(p + n, 0xc4, 1 + dht[t].len);
+		p[n++] = dht[t].tc_th;
+		memcpy(p + n, dht[t].table, dht[t].len);
+		n += dht[t].len;
+	}
+
+	/* The scan starts at a word boundary. */
+	while ((n + 4 + sizeof(sos)) % 4)
+		p[n++] = 0xff;
+
+	n += cedrus_enc_jpeg_seg(p + n, 0xda, sizeof(sos));
+	memcpy(p + n, sos, sizeof(sos));
+	n += sizeof(sos);
+
+	return n;
+}
+
+/* Job */
+
+static void cedrus_enc_jpeg_stream_set(struct cedrus_device *dev,
+				       unsigned int offset_bits, dma_addr_t addr,
+				       unsigned int size)
+{
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_OFFSET_REG, offset_bits);
+	cedrus_write(dev, VE_ENC_AVC_STM_START_ADDR_REG, addr);
+	cedrus_write(dev, VE_ENC_AVC_STM_END_ADDR_REG, addr + size - 1);
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_MAX_REG, (size - 2) * 8);
+}
+
+/* Context */
+
+static int cedrus_enc_jpeg_setup(struct cedrus_context *ctx)
+{
+	struct cedrus_enc_jpeg_context *jpeg_ctx = ctx->engine_ctx;
+
+	jpeg_ctx->quality =
+		cedrus_context_ctrl_find(ctx, V4L2_CID_JPEG_COMPRESSION_QUALITY);
+	if (WARN_ON(!jpeg_ctx->quality))
+		return -ENODEV;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_job_configure(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_enc_jpeg_context *jpeg_ctx = ctx->engine_ctx;
+	struct cedrus_enc_jpeg_job *job = ctx->engine_job;
+	struct vb2_buffer *vb2_buffer = &ctx->job.buffer_coded->vb2_buf;
+	struct v4l2_rect *visible = &ctx->v4l2.selection_picture;
+	unsigned int size, t, i;
+	dma_addr_t addr;
+	u8 *vaddr;
+	int ret;
+
+	/* SOI 2, APP0 18, DQT 138, SOF0 19, DHT 432, SOS 14, fill <= 3. */
+	BUILD_BUG_ON(sizeof(job->header) < 626);
+
+	/* One snapshot of the control feeds both the DQT and the SRAM. */
+	cedrus_enc_jpeg_qtables(READ_ONCE(jpeg_ctx->quality->cur.val), job->qt);
+	job->header_len = cedrus_enc_jpeg_header(job->header, visible->width,
+						 visible->height, job->qt);
+
+	cedrus_job_buffer_coded_dma(ctx, &addr, &size);
+	vaddr = vb2_plane_vaddr(vb2_buffer, 0);
+	/*
+	 * The VE may handle the stream limit in 8 KiB units (the size of the
+	 * buffers it was seen to stop in): never let it reach past the buffer.
+	 */
+	size = round_down(min_t(unsigned int, size, SZ_256M), SZ_8K);
+	/* Room for the header, some scan and EOI. */
+	if (!vaddr || size < job->header_len + SZ_1K)
+		return -EINVAL;
+
+	ret = cedrus_context_coded_cpu_begin(vb2_buffer, DMA_TO_DEVICE);
+	if (ret)
+		return ret;
+	memcpy(vaddr, job->header, job->header_len);
+	cedrus_context_coded_cpu_end(vb2_buffer, DMA_TO_DEVICE);
+	/* The mapping is uncached: order the header before the trigger. */
+	wmb();
+
+	/* ISP: NV12 without the thumbnail write-back (bit 19) the blob uses. */
+	cedrus_write(dev, VE_ISP_CTRL_REG, VE_ISP_CTRL_FORMAT_YUV420SP |
+		     VE_ISP_CTRL_ROTATION_0 | VE_ISP_CTRL_COLORSPACE_BT601);
+	cedrus_write(dev, VE_ISP_OUTPUT_LUMA_ADDR_REG, 0);
+	cedrus_write(dev, VE_ISP_OUTPUT_CHROMA_ADDR_REG, 0);
+
+	/*
+	 * The register sequence of the blob and of the hardware tests: JPEG
+	 * mode first, status cleared, the stream set up empty, then again
+	 * with the header length. The bit writer takes its position from
+	 * VLE_OFFSET when the addresses are written.
+	 */
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG_REG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG);
+	cedrus_write(dev, VE_ENC_AVC_STATUS_REG,
+		     cedrus_read(dev, VE_ENC_AVC_STATUS_REG) | 0x7);
+
+	/* Two bytes stay free for EOI. */
+	cedrus_enc_jpeg_stream_set(dev, 0, addr, size);
+	cedrus_write(dev, VE_ENC_AVC_PARA0_REG, VE_ENC_AVC_PARA0_EPTB_DIS);
+	/* The scan follows the header. */
+	cedrus_enc_jpeg_stream_set(dev, job->header_len * 8, addr, size);
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0_REG,
+		     VE_ENC_AVC_PARA0_EPTB_DIS |
+		     VE_ENC_AVC_PARA0_STUFF_ZERO_AFTER_FF_EN |
+		     (0x400 / job->qt[0][0]) |
+		     (0x400 / job->qt[1][0]) << 16);
+
+	/* Rounding term and reciprocal per coefficient, luma then chroma. */
+	cedrus_write(dev, VE_ENC_AVC_SRAM_INDEX_REG, 0);
+	for (t = 0; t < 2; t++)
+		for (i = 0; i < 64; i++) {
+			unsigned int q = job->qt[t][i];
+
+			cedrus_write(dev, VE_ENC_AVC_SRAM_DATA_REG,
+				     max(q >> 1, 1U) << 16 |
+				     min(0x10000 / q + 1, 0xffffU));
+		}
+
+	return 0;
+}
+
+static void cedrus_enc_jpeg_job_trigger(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	cedrus_write(dev, VE_ENC_AVC_INT_EN_REG, VE_ENC_AVC_INT_EN_VALUE);
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG_REG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG |
+		     VE_ENC_AVC_STARTTRIG_TYPE_ENC_START);
+}
+
+static int cedrus_enc_jpeg_job_finish(struct cedrus_context *ctx, int state)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_enc_jpeg_context *jpeg_ctx = ctx->engine_ctx;
+	struct cedrus_enc_jpeg_job *job = ctx->engine_job;
+	struct vb2_v4l2_buffer *v4l2_buffer = ctx->job.buffer_coded;
+	struct vb2_buffer *vb2_buffer = &v4l2_buffer->vb2_buf;
+	unsigned int size = round_down(min_t(unsigned long,
+					     vb2_plane_size(vb2_buffer, 0),
+					     SZ_256M), SZ_8K);
+	u32 bits = cedrus_read(dev, VE_ENC_AVC_STM_BIT_LEN_REG);
+
+	ctx->job.buffer_picture->sequence = jpeg_ctx->sequence;
+	v4l2_buffer->sequence = jpeg_ctx->sequence++;
+
+	/*
+	 * The length counts from the buffer start, header included, and the
+	 * scan ends on a byte boundary. EOI goes right after it, stored at
+	 * DQBUF (cedrus_enc_jpeg_buffer_coded_finish): this is IRQ context.
+	 */
+	if (state == VB2_BUF_STATE_DONE &&
+	    (bits % 8 || bits <= job->header_len * 8 || bits / 8 + 2 > size)) {
+		dev_err_ratelimited(dev->dev, "jpeg: bad stream length %u bits\n",
+				    bits);
+		state = VB2_BUF_STATE_ERROR;
+	}
+
+	if (state != VB2_BUF_STATE_DONE) {
+		vb2_set_plane_payload(vb2_buffer, 0, 0);
+		return state;
+	}
+
+	vb2_set_plane_payload(vb2_buffer, 0, bits / 8 + 2);
+	v4l2_buffer->flags |= V4L2_BUF_FLAG_KEYFRAME;
+
+	return state;
+}
+
+/*
+ * Runs from vb2 buf_finish (process context): at VIDIOC_DQBUF, but also when
+ * the queue is cancelled, after stop_streaming freed the engine context. Only
+ * the buffer is used.
+ */
+static void cedrus_enc_jpeg_buffer_coded_finish(struct cedrus_context *ctx,
+						struct cedrus_buffer *buffer)
+{
+	struct vb2_buffer *vb2_buffer = &buffer->m2m_buffer.vb.vb2_buf;
+	unsigned int payload = vb2_get_plane_payload(vb2_buffer, 0);
+	u8 *vaddr = vb2_plane_vaddr(vb2_buffer, 0);
+
+	if (vb2_buffer->state != VB2_BUF_STATE_DONE ||
+	    !vb2_is_streaming(vb2_buffer->vb2_queue) || payload < 2 || !vaddr)
+		return;
+
+	if (cedrus_context_coded_cpu_begin(vb2_buffer, DMA_BIDIRECTIONAL))
+		return;
+	vaddr[payload - 2] = 0xff;
+	vaddr[payload - 1] = 0xd9;
+	cedrus_context_coded_cpu_end(vb2_buffer, DMA_BIDIRECTIONAL);
+}
+
+/* IRQ */
+
+static int cedrus_enc_jpeg_irq_status(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 status = cedrus_read(dev, VE_ENC_AVC_STATUS_REG);
+
+	if (!(status & VE_ENC_AVC_STATUS_MASK))
+		return CEDRUS_IRQ_NONE;
+
+	/*
+	 * A full stream buffer raises another bit, without FINISH. INT_EN is
+	 * the blob's 0xf, tested with that overflow (0x3 only without).
+	 */
+	if (status & VE_ENC_AVC_STATUS_FINISH)
+		return CEDRUS_IRQ_SUCCESS;
+
+	return CEDRUS_IRQ_ERROR;
+}
+
+static void cedrus_enc_jpeg_irq_clear(struct cedrus_context *ctx)
+{
+	cedrus_write(ctx->proc->dev, VE_ENC_AVC_STATUS_REG,
+		     VE_ENC_AVC_STATUS_MASK);
+}
+
+static void cedrus_enc_jpeg_irq_disable(struct cedrus_context *ctx)
+{
+	cedrus_write(ctx->proc->dev, VE_ENC_AVC_INT_EN_REG, 0);
+}
+
+/* Engine */
+
+static const struct cedrus_engine_ops cedrus_enc_jpeg_ops = {
+	.format_prepare		= cedrus_enc_jpeg_format_coded_prepare,
+	.format_configure	= cedrus_enc_jpeg_format_coded_configure,
+
+	.setup			= cedrus_enc_jpeg_setup,
+
+	.buffer_coded_finish	= cedrus_enc_jpeg_buffer_coded_finish,
+
+	.job_configure		= cedrus_enc_jpeg_job_configure,
+	.job_trigger		= cedrus_enc_jpeg_job_trigger,
+	.job_finish		= cedrus_enc_jpeg_job_finish,
+
+	.irq_status		= cedrus_enc_jpeg_irq_status,
+	.irq_clear		= cedrus_enc_jpeg_irq_clear,
+	.irq_disable		= cedrus_enc_jpeg_irq_disable,
+};
+
+static const struct v4l2_ctrl_config cedrus_enc_jpeg_ctrl_configs[] = {
+	{
+		.id		= V4L2_CID_JPEG_COMPRESSION_QUALITY,
+		.min		= 1,
+		.max		= 100,
+		.step		= 1,
+		.def		= 75,
+	},
+};
+
+/* Picture sizes are whole macroblocks; the crop sets the image size. */
+static const struct v4l2_frmsize_stepwise cedrus_enc_jpeg_frmsize = {
+	.min_width	= 16,
+	.max_width	= CEDRUS_ENC_JPEG_WIDTH_MAX,
+	.step_width	= 16,
+
+	.min_height	= 16,
+	.max_height	= CEDRUS_ENC_JPEG_HEIGHT_MAX,
+	.step_height	= 16,
+};
+
+const struct cedrus_engine cedrus_enc_jpeg = {
+	.codec			= CEDRUS_CODEC_JPEG,
+	.role			= CEDRUS_ROLE_ENCODER,
+	.capabilities		= CEDRUS_CAPABILITY_JPEG_ENC,
+
+	.ops			= &cedrus_enc_jpeg_ops,
+
+	.pixelformat		= V4L2_PIX_FMT_JPEG,
+	.reset_on_error		= true,
+
+	.ctrl_configs		= cedrus_enc_jpeg_ctrl_configs,
+	.ctrl_configs_count	= ARRAY_SIZE(cedrus_enc_jpeg_ctrl_configs),
+
+	.frmsize		= &cedrus_enc_jpeg_frmsize,
+
+	.ctx_size		= sizeof(struct cedrus_enc_jpeg_context),
+	.job_size		= sizeof(struct cedrus_enc_jpeg_job),
+};
