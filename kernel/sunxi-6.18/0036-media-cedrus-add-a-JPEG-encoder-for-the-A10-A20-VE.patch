diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_enc.c b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_enc.c
new file mode 100644
index 000000000..85bc15d66
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_jpeg_enc.c
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Stateful JPEG encoder node (cedrus-jpeg-enc), following
+ * Documentation/userspace-api/media/v4l/dev-encoder.rst: linear NV12 pictures
+ * on OUTPUT, one baseline JFIF image per CAPTURE buffer. The OUTPUT format is
+ * macroblock-aligned; the image size is the OUTPUT crop (S_SELECTION, at the
+ * top-left corner, any size), and the client fills the padding (replicating
+ * the edge pixels avoids visible artefacts at the borders).
+ */
+
+#include <linux/minmax.h>
+#include <linux/videodev2.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_enc.h"
+#include "cedrus_enc_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_jpeg_enc.h"
+#include "cedrus_proc.h"
+
+/* Format */
+
+static const struct cedrus_format cedrus_jpeg_enc_formats[] = {
+	{
+		.pixelformat	= V4L2_PIX_FMT_NV12,
+		.type		= CEDRUS_FORMAT_TYPE_PICTURE,
+	},
+};
+
+static int cedrus_jpeg_enc_format_picture_prepare(struct cedrus_context *ctx,
+						  struct v4l2_format *format)
+{
+	struct v4l2_pix_format *pix_format = &format->fmt.pix;
+	int ret;
+
+	/*
+	 * The ISP reads whole macroblocks: a picture that ends inside one would
+	 * have its last rows read from the chroma plane. Round up, so the
+	 * requested size stays visible through the crop.
+	 */
+	pix_format->width = ALIGN(min(pix_format->width,
+				      CEDRUS_ENC_JPEG_WIDTH_MAX), 16);
+	pix_format->height = ALIGN(min(pix_format->height,
+				       CEDRUS_ENC_JPEG_HEIGHT_MAX), 16);
+
+	ret = cedrus_enc_format_picture_fill(ctx, format,
+					     cedrus_enc_stride_max(ctx->proc->dev));
+	if (ret)
+		return ret;
+
+	/*
+	 * JFIF: sRGB primaries, BT.601 full-range YCbCr. The VE does not
+	 * convert, so this is what the samples must be.
+	 */
+	pix_format->colorspace = V4L2_COLORSPACE_SRGB;
+	pix_format->xfer_func = V4L2_XFER_FUNC_SRGB;
+	pix_format->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix_format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+
+	return 0;
+}
+
+/*
+ * The image is the top-left part of the picture (SOF has no offset), of any
+ * size (JPEG has no even-size rule) within the last macroblock: the VE codes
+ * every macroblock of the picture, and SOF must describe the same MCU grid.
+ */
+static void cedrus_jpeg_enc_selection_picture_adjust(struct cedrus_context *ctx,
+						     struct v4l2_rect *crop)
+{
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = clamp(crop->width, pix_format->width - 15,
+			    pix_format->width);
+	crop->height = clamp(crop->height, pix_format->height - 15,
+			     pix_format->height);
+}
+
+/* Engines */
+
+static const struct cedrus_engine *cedrus_jpeg_enc_engines[] = {
+	&cedrus_enc_jpeg,
+};
+
+/* Encoder */
+
+static const struct cedrus_proc_config cedrus_jpeg_enc_config = {
+	.role			= CEDRUS_ROLE_ENCODER,
+	.name			= "jpeg-enc",
+	.stateful		= true,
+	/* The kernel writes the header and EOI. */
+	.coded_cpu_access	= true,
+	.still_images		= true,
+
+	.engines		= cedrus_jpeg_enc_engines,
+	.engines_count		= ARRAY_SIZE(cedrus_jpeg_enc_engines),
+
+	.formats		= cedrus_jpeg_enc_formats,
+	.formats_count		= ARRAY_SIZE(cedrus_jpeg_enc_formats),
+};
+
+static const struct cedrus_proc_ops cedrus_jpeg_enc_ops = {
+	.format_picture_prepare		= cedrus_jpeg_enc_format_picture_prepare,
+	.format_picture_configure	= cedrus_enc_format_picture_configure,
+	.selection_picture_adjust	= cedrus_jpeg_enc_selection_picture_adjust,
+
+	.format_setup			= cedrus_enc_format_setup,
+	.format_propagate		= cedrus_enc_format_propagate,
+	.format_dynamic_check		= cedrus_enc_format_dynamic_check,
+
+	.size_picture_enum		= cedrus_enc_size_picture_enum,
+};
+
+int cedrus_jpeg_enc_setup(struct cedrus_device *dev)
+{
+	return cedrus_proc_setup(dev, &dev->jpeg_enc, &cedrus_jpeg_enc_ops,
+				 &cedrus_jpeg_enc_config);
+}
+
+void cedrus_jpeg_enc_cleanup(struct cedrus_device *dev)
+{
+	cedrus_proc_cleanup(&dev->jpeg_enc);
+}
