@@ -187,6 +189,16 @@ static void cedrus_irq_spurious(struct cedrus_device *dev)
 		cedrus_irq_disable_clear(proc->ctx_active);
 
 	spin_unlock(&proc->ctx_active_lock);
+
+	/* Disable/clear IRQ on the encoder. */
