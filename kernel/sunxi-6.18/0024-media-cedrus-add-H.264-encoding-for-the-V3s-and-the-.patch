 }
 
 static irqreturn_t cedrus_irq(int irq, void *private)
@@ -216,15 +228,23 @@ static irqreturn_t cedrus_irq(int irq, void *private)
 	}
 
 	status = cedrus_engine_irq_status(ctx);
-	if (status == CEDRUS_IRQ_NONE)
