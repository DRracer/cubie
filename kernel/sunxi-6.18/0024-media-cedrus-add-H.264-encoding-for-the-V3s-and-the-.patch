 		state = VB2_BUF_STATE_ERROR;
-	else
+		/* A stalled encoder may still be busy: reset like the watchdog. */
+		if (ctx->proc->role == CEDRUS_ROLE_ENCODER)
+			reset_control_reset(cedrus_dev->reset);
+	} else {
 		state = VB2_BUF_STATE_DONE;
+	}
 
 	cedrus_context_job_finish(ctx, state);
 
@@ -307,6 +327,7 @@ static int cedrus_resources_setup(struct cedrus_device *cedrus_dev,
