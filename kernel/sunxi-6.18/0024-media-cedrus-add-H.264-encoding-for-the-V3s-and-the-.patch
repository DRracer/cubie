diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 3b9682546..99df6072a 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -51,13 +51,27 @@ enum cedrus_capability {
 	CEDRUS_CAPABILITY_H265_DEC	= BIT(3),
 	CEDRUS_CAPABILITY_H265_10_DEC	= BIT(4),
 	CEDRUS_CAPABILITY_VP8_DEC	= BIT(5),
+	CEDRUS_CAPABILITY_H264_ENC	= BIT(6),
 };
 
 struct cedrus_context;
 
+/*
+ * Encoder hardware generation. The A10/A20 (VE 0x1623/0x1625) AVC encoder
+ * shares most registers with the V3s one but selects the engine through the
+ * VE_MODE mode field, packs the QP register differently, needs extra line
+ * buffers and lacks several V3s-only registers.
+ * Established from Allwinner's A20 encoder library and tests on the A20.
+ */
+enum cedrus_enc_gen {
+	CEDRUS_ENC_GEN_V3S = 0,
+	CEDRUS_ENC_GEN_A20,
+};
+
 struct cedrus_variant {
-	unsigned int	capabilities;
-	unsigned int	clock_mod_rate;
+	unsigned int		capabilities;
+	unsigned int		clock_mod_rate;
+	enum cedrus_enc_gen	enc_gen;
 };
 
 struct cedrus_format {
@@ -77,6 +91,7 @@ struct cedrus_device {
 
 	struct cedrus_v4l2	v4l2;
 	struct cedrus_proc	dec;
+	struct cedrus_proc	enc;
 
 	void __iomem		*io_base;
 	struct clk		*clock_ahb;
@@ -85,8 +100,12 @@ struct cedrus_device {
 	struct reset_control	*reset;
 
 	unsigned int		capabilities;
+	enum cedrus_enc_gen	enc_gen;
 
 	struct delayed_work	watchdog_work;
+
+	/* Role of the last job (encoder/decoder), -1 after probe or reset. */
+	int			last_job_role;
 };
 
 /* Capabilities */
@@ -97,6 +116,11 @@ static inline bool cedrus_capabilities_check(struct cedrus_device *dev,
 	return (dev->capabilities & capabilities) == capabilities;
 }
 
+static inline bool cedrus_enc_gen_a20(struct cedrus_device *dev)
+{
+	return dev->enc_gen == CEDRUS_ENC_GEN_A20;
+}
+
 /* I/O */
 
 static inline void cedrus_write(struct cedrus_device *dev, u32 reg, u32 val)
@@ -117,6 +141,14 @@ static inline int cedrus_poll(struct cedrus_device *dev, u32 reg, u32 bits)
 					 (value & bits) == bits, 10, 1000);
 }
 
+static inline int cedrus_poll_nonzero(struct cedrus_device *dev, u32 reg)
+{
+	u32 value;
+
+	return readl_poll_timeout_atomic(dev->io_base + reg, value, value,
+					 10, 1000);
+}
+
 static inline int cedrus_poll_cleared(struct cedrus_device *dev, u32 reg,
 				      u32 bits)
 {
@@ -156,7 +188,15 @@ static inline void cedrus_buffer_coded_dma(struct cedrus_context *ctx,
 	struct vb2_buffer *vb2_buffer = &cedrus_buffer->m2m_buffer.vb.vb2_buf;
 
 	*addr = vb2_dma_contig_plane_dma_addr(vb2_buffer, 0);
-	*size = vb2_get_plane_payload(vb2_buffer, 0);
+
+	/*
+	 * Use the payload size when decoding (provided by user) and the full
+	 * buffer size when encoding.
+	 */
+	if (ctx->proc->role == CEDRUS_ROLE_DECODER)
+		*size = vb2_get_plane_payload(vb2_buffer, 0);
+	else
+		*size = vb2_plane_size(vb2_buffer, 0);
 }
 
 static inline struct cedrus_buffer *
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_context.c b/drivers/staging/media/sunxi/cedrus/cedrus_context.c
index 24121b887..f4c7eb29c 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_context.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_context.c
@@ -8,11 +8,13 @@
  * Author: Paul Kocialkowski <paul.kocialkowski@bootlin.com>
  */
 
+#include <linux/reset.h>
 #include <linux/pm_runtime.h>
 #include <linux/videodev2.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-fh.h>
+#include <media/v4l2-event.h>
 #include <media/v4l2-mem2mem.h>
 #include <media/videobuf2-v4l2.h>
 #include <media/videobuf2-dma-contig.h>
@@ -211,6 +213,37 @@ int cedrus_context_selection_picture_reset(struct cedrus_context *ctx)
 	return 0;
 }
 
+/* End of stream (stateful encoder drain) */
+
+void cedrus_context_eos(struct cedrus_context *ctx)
+{
+	static const struct v4l2_event eos_event = {
+		.type = V4L2_EVENT_EOS,
+	};
+
+	v4l2_event_queue_fh(&ctx->v4l2.fh, &eos_event);
+}
+
+static void cedrus_context_streaming_update(struct cedrus_context *ctx,
+					    struct vb2_queue *queue,
+					    bool start)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
+
+	if (ctx->proc->role != CEDRUS_ROLE_ENCODER)
+		return;
+
+	if (start) {
+		v4l2_m2m_update_start_streaming_state(m2m_ctx, queue);
+		return;
+	}
+
+	v4l2_m2m_update_stop_streaming_state(m2m_ctx, queue);
+
+	if (V4L2_TYPE_IS_OUTPUT(queue->type) && v4l2_m2m_has_stopped(m2m_ctx))
+		cedrus_context_eos(ctx);
+}
+
 /* Job */
 
 void cedrus_context_job_finish(struct cedrus_context *ctx, int state)
@@ -219,9 +252,22 @@ void cedrus_context_job_finish(struct cedrus_context *ctx, int state)
 	struct v4l2_m2m_dev *m2m_dev = proc->dev->v4l2.m2m_dev;
 	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
 
-	cedrus_engine_job_finish(ctx, state);
+	state = cedrus_engine_job_finish(ctx, state);
 	memset(&ctx->job, 0, sizeof(ctx->job));
 
+	/* Draining: flag the output of the last source buffer and signal EOS. */
+	if (proc->role == CEDRUS_ROLE_ENCODER) {
+		struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(m2m_ctx);
+		struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(m2m_ctx);
+
+		if (src && dst &&
+		    v4l2_m2m_is_last_draining_src_buf(m2m_ctx, src)) {
+			dst->flags |= V4L2_BUF_FLAG_LAST;
+			cedrus_context_eos(ctx);
+			v4l2_m2m_mark_stopped(m2m_ctx);
+		}
+	}
+
 	v4l2_m2m_buf_done_and_job_finish(m2m_dev, m2m_ctx, state);
 }
 
@@ -252,10 +298,17 @@ int cedrus_context_job_run(struct cedrus_context *ctx)
 	buffer_src = v4l2_m2m_next_src_buf(m2m_ctx);
 	buffer_dst = v4l2_m2m_next_dst_buf(m2m_ctx);
 
-	job->queue_coded = queue_src;
-	job->queue_picture = queue_dst;
-	job->buffer_coded = buffer_src;
-	job->buffer_picture = buffer_dst;
+	if (proc->role == CEDRUS_ROLE_DECODER) {
+		job->queue_coded = queue_src;
+		job->queue_picture = queue_dst;
+		job->buffer_coded = buffer_src;
+		job->buffer_picture = buffer_dst;
+	} else {
+		job->queue_coded = queue_dst;
+		job->queue_picture = queue_src;
+		job->buffer_coded = buffer_dst;
+		job->buffer_picture = buffer_src;
+	}
 
 	/* Setup request controls. */
 
@@ -275,6 +328,16 @@ int cedrus_context_job_run(struct cedrus_context *ctx)
 		goto error_ctrl;
 	}
 
+	/*
+	 * Decode jobs time out on the A20 when they follow encode jobs
+	 * (interleaved sessions): reset the VE whenever the role changes.
+	 */
+	if (cedrus_dev->last_job_role != ctx->proc->role) {
+		if (cedrus_dev->last_job_role >= 0)
+			reset_control_reset(cedrus_dev->reset);
+		cedrus_dev->last_job_role = ctx->proc->role;
+	}
+
 	/* Configure coded and picture formats. */
 
 	ret = cedrus_engine_format_configure(ctx);
@@ -490,8 +553,19 @@ static void cedrus_context_buffer_queue(struct vb2_buffer *vb2_buffer)
 {
 	struct cedrus_context *ctx = vb2_get_drv_priv(vb2_buffer->vb2_queue);
 	struct vb2_v4l2_buffer *v4l2_buffer = to_vb2_v4l2_buffer(vb2_buffer);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
+
+	if (ctx->proc->role == CEDRUS_ROLE_ENCODER &&
+	    V4L2_TYPE_IS_CAPTURE(vb2_buffer->vb2_queue->type) &&
+	    vb2_is_streaming(vb2_buffer->vb2_queue) &&
+	    v4l2_m2m_dst_buf_is_last(m2m_ctx)) {
+		vb2_set_plane_payload(vb2_buffer, 0, 0);
+		v4l2_m2m_last_buffer_done(m2m_ctx, v4l2_buffer);
+		cedrus_context_eos(ctx);
+		return;
+	}
 
-	v4l2_m2m_buf_queue(ctx->v4l2.fh.m2m_ctx, v4l2_buffer);
+	v4l2_m2m_buf_queue(m2m_ctx, v4l2_buffer);
 }
 
 static int cedrus_context_buffer_validate(struct vb2_buffer *vb2_buffer)
@@ -524,6 +598,8 @@ static int cedrus_context_start_streaming(struct vb2_queue *queue,
 	if (WARN_ON(!engine))
 		return -ENODEV;
 
+	cedrus_context_streaming_update(ctx, queue, true);
+
 	/* Only start the engine from the coded queue. */
 	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
 		return 0;
@@ -586,9 +662,15 @@ static void cedrus_context_stop_streaming(struct vb2_queue *queue)
 	if (WARN_ON(!engine))
 		return;
 
-	/* Only stop the engine from the coded queue. */
-	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
+	/*
+	 * Only stop the engine from the coded queue, but always give the
+	 * queued buffers back (vb2 warns about buffers left in active state).
+	 */
+	if (format_type != CEDRUS_FORMAT_TYPE_CODED) {
+		cedrus_context_queue_cleanup(queue, true);
+		cedrus_context_streaming_update(ctx, queue, false);
 		return;
+	}
 
 	cedrus_engine_cleanup(ctx);
 
@@ -603,6 +685,7 @@ static void cedrus_context_stop_streaming(struct vb2_queue *queue)
 	}
 
 	cedrus_context_queue_cleanup(queue, true);
+	cedrus_context_streaming_update(ctx, queue, false);
 
 	pm_runtime_put(dev);
 }
@@ -635,12 +718,19 @@ static int cedrus_context_queue_init(void *private, struct vb2_queue *src_queue,
 	src_queue->mem_ops = &vb2_dma_contig_memops;
 	src_queue->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
 	src_queue->supports_requests = true;
-	src_queue->requires_requests = true;
 	src_queue->lock = &proc->v4l2.lock;
 	src_queue->dev = proc->dev->dev;
 	src_queue->dma_attrs = DMA_ATTR_NO_KERNEL_MAPPING;
 	src_queue->drv_priv = ctx;
 
+	/*
+	 * FIXME: The current encoder implementation doesn't particularly rely
+	 * on requests, but it might become necessary for some codecs so this
+	 * should be set dynamically later on.
+	 */
+	if (proc->role == CEDRUS_ROLE_DECODER)
+		src_queue->requires_requests = true;
+
 	ret = vb2_queue_init(src_queue);
 	if (ret)
 		return ret;
