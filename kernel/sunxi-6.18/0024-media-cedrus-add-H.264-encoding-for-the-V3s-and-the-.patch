diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc_num.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc_num.h
new file mode 100644
index 000000000..38e75e6ae
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc_num.h
@@ -0,0 +1,249 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus VPU driver — integer-only floating-point emulation for the H.264
+ * encoder rate control (no FPU use in the kernel).
+ *
+ * A value is m * 2^e with a normalised mantissa 2^61 <= |m| < 2^62 (or
+ * m == 0). That gives 61-62 bits of precision (more than a double) and an
+ * exponent range far beyond what the rate control needs, so the quadratic
+ * model regressions cannot overflow.
+ */
+
+#ifndef _CEDRUS_ENC_RC_NUM_H_
+#define _CEDRUS_ENC_RC_NUM_H_
+
+#ifdef __KERNEL__
+#include <linux/bitops.h>
+#include <linux/minmax.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#else
+#include "rc_compat.h"
+#endif
+
+struct rcn {
+	s64	m;
+	int	e;
+};
+
+#define RCN_LO		(1ULL << 61)
+#define RCN_HI		(1ULL << 62)
+
+static inline struct rcn rcn_make(s64 m, int e)
+{
+	struct rcn r = { 0, 0 };
+	u64 a;
+	int msb;
+
+	if (!m)
+		return r;
+
+	a = m < 0 ? -(u64)m : (u64)m;
+	msb = fls64(a) - 1;		/* bit index of the leading one */
+	if (msb > 61) {
+		a >>= msb - 61;
+		e += msb - 61;
+	} else if (msb < 61) {
+		a <<= 61 - msb;
+		e -= 61 - msb;
+	}
+
+	r.m = m < 0 ? -(s64)a : (s64)a;
+	r.e = e;
+	return r;
+}
+
+static inline struct rcn rcn_int(s64 v)
+{
+	return rcn_make(v, 0);
+}
+
+/* v * 2^shift (exact for the power-of-two scaled constants we use) */
+static inline struct rcn rcn_ldexp(struct rcn a, int shift)
+{
+	if (a.m)
+		a.e += shift;
+	return a;
+}
+
+static inline struct rcn rcn_neg(struct rcn a)
+{
+	a.m = -a.m;
+	return a;
+}
+
+static inline bool rcn_is_zero(struct rcn a)
+{
+	return !a.m;
+}
+
+static inline bool rcn_is_neg(struct rcn a)
+{
+	return a.m < 0;
+}
+
+static inline struct rcn rcn_add(struct rcn a, struct rcn b)
+{
+	int d;
+
+	if (!a.m)
+		return b;
+	if (!b.m)
+		return a;
+	if (a.e < b.e) {
+		struct rcn t = a;
+
+		a = b;
+		b = t;
+	}
+
+	d = a.e - b.e;
+	if (d > 62)
+		return a;
+
+	/* |a.m|, |b.m| < 2^62, so the sum fits in s64. */
+	return rcn_make(a.m + (b.m >> d), a.e);
+}
+
+static inline struct rcn rcn_sub(struct rcn a, struct rcn b)
+{
+	return rcn_add(a, rcn_neg(b));
+}
+
+/* 64 x 64 -> 128 bit unsigned multiplication. */
+static inline void rcn_umul128(u64 a, u64 b, u64 *hi, u64 *lo)
+{
+	u64 al = (u32)a, ah = a >> 32, bl = (u32)b, bh = b >> 32;
+	u64 ll = al * bl, lh = al * bh, hl = ah * bl, hh = ah * bh;
+	u64 mid = (ll >> 32) + (u32)lh + (u32)hl;
+
+	*lo = (mid << 32) | (u32)ll;
+	*hi = hh + (lh >> 32) + (hl >> 32) + (mid >> 32);
+}
+
+static inline struct rcn rcn_mul(struct rcn a, struct rcn b)
+{
+	u64 ua, ub, hi, lo, p;
+	bool neg;
+
+	if (!a.m || !b.m)
+		return rcn_int(0);
+
+	neg = (a.m < 0) != (b.m < 0);
+	ua = a.m < 0 ? -(u64)a.m : (u64)a.m;
+	ub = b.m < 0 ? -(u64)b.m : (u64)b.m;
+
+	/* The product is below 2^124; keep its top bits (>> 62). */
+	rcn_umul128(ua, ub, &hi, &lo);
+	p = (hi << 2) | (lo >> 62);
+
+	return rcn_make(neg ? -(s64)p : (s64)p, a.e + b.e + 62);
+}
+
+/* a / b; division by zero yields 0 (callers guard against it). */
+static inline struct rcn rcn_div(struct rcn a, struct rcn b)
+{
+	u64 ua, ub, r, q = 0;
+	bool neg;
+	int i;
+
+	if (!a.m || !b.m)
+		return rcn_int(0);
+
+	neg = (a.m < 0) != (b.m < 0);
+	ua = a.m < 0 ? -(u64)a.m : (u64)a.m;
+	ub = b.m < 0 ? -(u64)b.m : (u64)b.m;
+
+	/* Restoring division: q = floor(ua / ub * 2^61), ua / ub in (1/2, 2). */
+	r = ua;
+	for (i = 0; i < 62; i++) {
+		q <<= 1;
+		if (r >= ub) {
+			r -= ub;
+			q |= 1;
+		}
+		r <<= 1;
+	}
+
+	return rcn_make(neg ? -(s64)q : (s64)q, a.e - b.e - 61);
+}
+
+static inline int rcn_cmp(struct rcn a, struct rcn b)
+{
+	struct rcn d = rcn_sub(a, b);
+
+	return d.m < 0 ? -1 : d.m > 0;
+}
+
+/* Conversion towards zero, like a C (int) cast. Saturates at +-2^62. */
+static inline s64 rcn_trunc(struct rcn a)
+{
+	u64 u;
+
+	if (!a.m || a.e <= -63)
+		return 0;
+
+	u = a.m < 0 ? -(u64)a.m : (u64)a.m;
+	if (a.e >= 0)
+		u = a.e > 0 ? ~0ULL >> 2 : u;	/* only values < 2^62 occur */
+	else
+		u >>= -a.e;
+
+	return a.m < 0 ? -(s64)u : (s64)u;
+}
+
+/* The blob's floor idiom: x >= 0 ? (int)x : (int)(x - 1.0). */
+static inline s64 rcn_dfloor(struct rcn a)
+{
+	if (!rcn_is_neg(a))
+		return rcn_trunc(a);
+
+	return rcn_trunc(rcn_sub(a, rcn_int(1)));
+}
+
+static inline u64 rcn_isqrt64(u64 x)
+{
+	u64 r = 0, bit = 1ULL << 62;
+
+	while (bit > x)
+		bit >>= 2;
+
+	while (bit) {
+		if (x >= r + bit) {
+			x -= r + bit;
+			r = (r >> 1) + bit;
+		} else {
+			r >>= 1;
+		}
+		bit >>= 2;
+	}
+
+	return r;
+}
+
+/* Square root of a non-negative value (negative input yields 0). */
+static inline struct rcn rcn_sqrt(struct rcn a)
+{
+	struct rcn x;
+	u64 u;
+	int e, i;
+
+	if (a.m <= 0)
+		return rcn_int(0);
+
+	u = (u64)a.m;
+	e = a.e;
+	if (e & 1) {
+		u <<= 1;		/* still below 2^63 */
+		e -= 1;
+	}
+
+	/* ~31-bit initial estimate, refined by Newton-Raphson. */
+	x = rcn_make((s64)rcn_isqrt64(u), e / 2);
+	for (i = 0; i < 3; i++)
+		x = rcn_ldexp(rcn_add(x, rcn_div(a, x)), -1);
+
+	return x;
+}
+
+#endif /* _CEDRUS_ENC_RC_NUM_H_ */
