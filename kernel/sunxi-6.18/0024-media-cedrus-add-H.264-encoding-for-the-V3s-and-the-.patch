+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Copyright 2023 Bootlin
+ * Author: Paul Kocialkowski <paul.kocialkowski@bootlin.com>
+ */
+
+#ifndef _CEDRUS_ENC_H264_H_
+#define _CEDRUS_ENC_H264_H_
+
+#include <media/v4l2-ctrls.h>
+
+#include "cedrus_enc_rc.h"
+
+#define CENDRUS_ENC_H264_NALU_TYPE_SLICE_NON_IDR	1
+#define CENDRUS_ENC_H264_NALU_TYPE_SLICE_IDR		5
+#define CENDRUS_ENC_H264_NALU_TYPE_SPS			7
+#define CENDRUS_ENC_H264_NALU_TYPE_PPS			8
+#define CENDRUS_ENC_H264_NALU_TYPE_AUD			9
+
+#define CEDRUS_ENC_H264_SLICE_TYPE_I		2
+#define CEDRUS_ENC_H264_SLICE_TYPE_B		1
+#define CEDRUS_ENC_H264_SLICE_TYPE_P		0
+
+#define CEDRUS_ENC_H264_CONSTRAINT_SET0_FLAG	BIT(7)
+#define CEDRUS_ENC_H264_CONSTRAINT_SET1_FLAG	BIT(6)
+#define CEDRUS_ENC_H264_CONSTRAINT_SET2_FLAG	BIT(5)
+#define CEDRUS_ENC_H264_CONSTRAINT_SET3_FLAG	BIT(4)
+#define CEDRUS_ENC_H264_CONSTRAINT_SET4_FLAG	BIT(3)
+#define CEDRUS_ENC_H264_CONSTRAINT_SET5_FLAG	BIT(2)
+
+enum cedrus_enc_h264_frame_type {
+	CEDRUS_ENC_H264_FRAME_TYPE_IDR,
+	CEDRUS_ENC_H264_FRAME_TYPE_I,
+	CEDRUS_ENC_H264_FRAME_TYPE_P,
+	CEDRUS_ENC_H264_FRAME_TYPE_B,
+};
+
+enum cedrus_enc_h264_step {
+	CEDRUS_ENC_H264_STEP_START,
+	CEDRUS_ENC_H264_STEP_SPS,
+	CEDRUS_ENC_H264_STEP_PPS,
+	CEDRUS_ENC_H264_STEP_SLICE,
+};
+
+struct cedrus_enc_h264_job {
+	unsigned int	nal_ref_idc;
+	unsigned int	frame_type;
+	unsigned int	frame_num;
+	unsigned int	pic_order_cnt_lsb;
+	unsigned int	qp;
+
+	unsigned int	seq_parameter_set_id;
+	unsigned int	pic_parameter_set_id;
+	unsigned int	idr_pic_id;
+
+	unsigned int	profile_idc;
+	unsigned int	level_idc;
+	unsigned int	constraint_set_flags;
+	unsigned int	entropy_coding_mode_flag;
+	unsigned int	chroma_qp_index_offset;
+	unsigned int	disable_deblocking_filter_idc;
+	int		slice_alpha_c0_offset_div2;
+	int		slice_beta_offset_div2;
+
+	unsigned int	cabac_init_idc;
+};
+
+struct cedrus_enc_h264_state {
+	unsigned int	step;
+
+	unsigned int	gop_index;
+	unsigned int	frame_num;
+	unsigned int	pic_order_cnt_lsb;
+	unsigned int	idr_pic_id;
+
+	unsigned int	qp_init;
+};
+
+/* Reconstruction + sub-pixel buffers of one reference slot. */
+struct cedrus_enc_h264_buffer {
+	void		*rec;
+	dma_addr_t	rec_dma;
+	unsigned int	rec_size;
+	unsigned int	rec_luma_size;
+	unsigned int	rec_chroma_size;
+
+	void		*subpix;
+	dma_addr_t	subpix_dma;
+	unsigned int	subpix_size;
+};
+
+struct cedrus_enc_h264_context {
+	struct cedrus_enc_h264_state	state;
+
+	void				*mb_info;
+	dma_addr_t			mb_info_dma;
+	unsigned int			mb_info_size;
+
+	/* A20 only: second line buffer, programmed into VE_ENC_AVC_DEBLK_ADDR. */
+	void				*deblk;
+	dma_addr_t			deblk_dma;
+	unsigned int			deblk_size;
+
+	/*
+	 * A20 only: target for VE_ENC_AVC_MV_BUF_ADDR. The blob never programs
+	 * it on the A20, but Jens Kuske's A20 encoder does; a P-frame encode with the
+	 * register left at its reset value hard-hung the board. Kernel-mapped so
+	 * the a20_mv_canary parameter can tell whether the VE writes to it.
+	 */
+	void				*mv;
+	dma_addr_t			mv_dma;
+	unsigned int			mv_size;
+
+	/*
+	 * Two slots: one is reconstructed by the current job, the other holds
+	 * the reference. The roles swap only after a successful encode, so a
+	 * failed job never becomes a reference (A20 blob uses the same scheme).
+	 */
+	struct cedrus_enc_h264_buffer	refs[2];
+	unsigned int			ref_cur;
+	bool				ref_valid;
+
+	/* Set from IRQ context after a failed job, consumed by job_prepare. */
+	bool				need_idr;
+	/* QP raise after failed (overflowed) jobs, 0 after a good frame. */
+	unsigned int			overflow_qp_bump;
+	unsigned int			overflow_good_frames;
+
+	/* Frame-level rate control (V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE). */
+	bool				rc_enable;
+	u32				bitrate;
+	bool				rc_started;
+	struct cedrus_enc_rc		rc;
+	/* Statistics of the last frame, latched in IRQ context by job_finish. */
+	struct {
+		bool	valid;
+		bool	intra;
+		int	qp;
+		u32	bits;
+		u32	texture_bits;
+		u32	header_bits;
+		u32	mad_sum;
+	} rc_frame;
+
+	unsigned int			width_mbs;
+	unsigned int			height_mbs;
+
+	unsigned int			pic_order_cnt_type;
+	unsigned int			log2_max_pic_order_cnt_lsb;
+	unsigned int			log2_max_frame_num;
+
+	int				prepend_sps_pps_idr;
+	int				profile;
+	int				level;
+	int				vui_sar_enable;
+	int				vui_sar_idc;
+	int				vui_ext_sar_width;
+	int				vui_ext_sar_height;
+	int				entropy_mode;
+	int				chroma_qp_index_offset;
+	int				loop_filter_mode;
+	int				loop_filter_alpha;
+	int				loop_filter_beta;
+	int				qp_min;
+	int				qp_max;
+	int				qp_i;
+	int				qp_p;
+	int				gop_closure;
+	int				gop_size;
+	int				gop_open_i_period;
+	bool				force_key_frame;
+
+	struct v4l2_ctrl		*entropy_mode_ctrl;
+};
+
+
+extern const struct cedrus_engine cedrus_enc_h264;
+
+static inline u8 cedrus_enc_h264_nalu_header(u8 type, u8 ref_idc)
+{
+	return (type & GENMASK(4, 0)) | ((ref_idc << 5) & GENMASK(6, 5));
+}
+#endif
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.c
new file mode 100644
index 000000000..cd89832fc
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.c
@@ -0,0 +1,651 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver — H.264 encoder frame-level rate control.
+ *
+ * Port of the rate control found in Allwinner's A20 libvencoder: the H.264
+ * JM reference encoder's quadratic model (RC mode 2, frame layer) with
+ * Allwinner's changes (I frames reuse the last P QP, +-max_qp_change per P
+ * frame, buffer fullness clamped to one second, carried budget clamped to
+ * twice the new allocation). Operation order follows the blob so decisions
+ * match a bit-exact model of it.
+ *
+ * Deliberate differences from the blob: the frame rate is not truncated to
+ * an integer, and with gop == 0 a budget window is allocated on I frames
+ * (I + 7 P) and when the planned P frames are used up (8 P) — the blob
+ * allocated twice after the first I frame and let the P count reach zero.
+ * B frames and the blob's undocumented "rc_mode" are not supported.
+ *
+ * All arithmetic is integer (see cedrus_enc_rc_num.h).
+ */
+
+#include <linux/math64.h>
+#include "cedrus_enc_rc.h"
+
+#define RC_WINDOW_MAX	20
+
+static struct rcn rc_half(void)
+{
+	return rcn_ldexp(rcn_int(1), -1);
+}
+
+/* 0.9f as the blob uses it: 15099494 / 2^24 exactly. */
+static struct rcn rc_0_9f(void)
+{
+	return rcn_ldexp(rcn_int(15099494), -24);
+}
+
+static struct rcn rc_qp2qstep(int qp)
+{
+	/* 0.625, 0.6875, 0.8125, 0.875, 1, 1.125 in 1/16 units */
+	static const int qstep16[6] = { 10, 11, 13, 14, 16, 18 };
+
+	return rcn_ldexp(rcn_int(qstep16[qp % 6]), qp / 6 - 4);
+}
+
+static int rc_qstep2qp(struct rcn q)
+{
+	/* 0.65625, 0.75, 0.84375, 0.9375, 1.0625 in 1/32 units */
+	static const int thr32[5] = { 21, 24, 27, 30, 34 };
+	int per = 0, rem;
+
+	if (rcn_cmp(rc_qp2qstep(0), q) > 0)
+		return 0;
+	if (rcn_cmp(rc_qp2qstep(51), q) < 0)
+		return 51;
+
+	while (rcn_cmp(rc_qp2qstep(5), q) < 0) {
+		q = rcn_ldexp(q, -1);
+		per++;
+	}
+
+	for (rem = 0; rem < 5; rem++)
+		if (rcn_cmp(q, rcn_ldexp(rcn_int(thr32[rem]), -5)) <= 0)
+			break;
+
+	return rem + per * 6;
+}
+
+static int rc_clip3(int lo, int hi, int x)
+{
+	if (x < lo)
+		x = lo;
+	if (x >= hi)
+		x = hi;
+	return x;
+}
+
+static s64 rc_clamp_carry(s64 r, int a)
+{
+	s64 a2 = 2 * (s64)a;
+
+	if (r > a2)
+		return a2;
+	if (r < -a2)
+		return -a2;
+	return r;
+}
+
+/* Least-squares fit of R = X1 / Q + X2 / Q^2 over the window. */
+static void rc_model_estimator(struct cedrus_enc_rc *rc, int n,
+			       const bool *rej)
+{
+	struct rcn one_q = rcn_int(0), a00, a01, a11, b0, b1, mv, eps;
+	int nreal = n, i;
+	bool est2 = false;
+
+	rc->m_x1 = rcn_int(0);
+	rc->m_x2 = rcn_int(0);
+	if (n < 1)
+		goto out;
+
+	for (i = 0; i < n; i++)
+		if (rej[i])
+			nreal--;
+	for (i = 0; i < n; i++)
+		if (!rej[i])
+			one_q = rc->m_rg_qp[i];
+	for (i = 0; i < n; i++) {
+		if (rej[i])
+			continue;
+		if (rcn_cmp(rc->m_rg_qp[i], one_q))
+			est2 = true;
+		rc->m_x1 = rcn_add(rc->m_x1,
+				   rcn_div(rcn_mul(rc->m_rg_qp[i], rc->m_rg_rp[i]),
+					   rcn_int(nreal)));
+	}
+	if (nreal < 1 || !est2)
+		goto out;
+
+	a00 = a01 = a11 = b0 = b1 = rcn_int(0);
+	for (i = 0; i < n; i++) {
+		struct rcn q = rc->m_rg_qp[i];
+
+		if (rej[i])
+			continue;
+		a00 = rcn_add(a00, rcn_int(1));
+		a01 = rcn_add(a01, rcn_div(rcn_int(1), q));
+		a11 = rcn_add(a11, rcn_div(rcn_int(1), rcn_mul(q, q)));
+		b0 = rcn_add(b0, rcn_mul(q, rc->m_rg_rp[i]));
+		b1 = rcn_add(b1, rc->m_rg_rp[i]);
+	}
+
+	mv = rcn_sub(rcn_mul(a11, a00), rcn_mul(a01, a01));
+	eps = rcn_div(rcn_int(1), rcn_int(1000000));
+	if (rcn_cmp(mv, eps) > 0 || rcn_cmp(mv, rcn_neg(eps)) < 0) {
+		rc->m_x1 = rcn_div(rcn_sub(rcn_mul(b0, a11), rcn_mul(b1, a01)), mv);
+		rc->m_x2 = rcn_div(rcn_sub(rcn_mul(b1, a00), rcn_mul(b0, a01)), mv);
+	} else {
+		rc->m_x1 = rcn_div(b0, a00);
+	}
+out:
+	rc->pm_x1 = rc->m_x1;
+	rc->pm_x2 = rc->m_x2;
+}
+
+/* Linear MAD prediction: MAD = C1 * reference MAD + C2. */
+static void rc_mad_estimator(struct cedrus_enc_rc *rc, int n, const bool *rej)
+{
+	struct rcn one_m = rcn_int(0), a00, a01, a11, b0, b1, mv, eps;
+	int nreal = n, i;
+	bool est2 = false;
+
+	rc->mad_c1 = rcn_int(0);
+	rc->mad_c2 = rcn_int(0);
+	if (n < 1)
+		goto out;
+
+	for (i = 0; i < n; i++)
+		if (rej[i])
+			nreal--;
+	for (i = 0; i < n; i++)
+		if (!rej[i])
+			one_m = rc->picture_mad[i];
+	for (i = 0; i < n; i++) {
+		if (rej[i])
+			continue;
+		if (rcn_cmp(rc->picture_mad[i], one_m))
+			est2 = true;
+		rc->mad_c1 = rcn_add(rc->mad_c1,
+				     rcn_div(rc->picture_mad[i],
+					     rcn_mul(rcn_int(nreal),
+						     rc->reference_mad[i])));
+	}
+	if (nreal < 1 || !est2)
+		goto out;
+
+	a00 = a01 = a11 = b0 = b1 = rcn_int(0);
+	for (i = 0; i < n; i++) {
+		struct rcn r = rc->reference_mad[i], m = rc->picture_mad[i];
+
+		if (rej[i])
+			continue;
+		a00 = rcn_add(a00, rcn_int(1));
+		a01 = rcn_add(a01, r);
+		a11 = rcn_add(a11, rcn_mul(r, r));
+		b0 = rcn_add(b0, m);
+		b1 = rcn_add(b1, rcn_mul(r, m));
+	}
+
+	mv = rcn_sub(rcn_mul(a11, a00), rcn_mul(a01, a01));
+	eps = rcn_div(rcn_int(1), rcn_int(1000000));
+	if (rcn_cmp(mv, eps) > 0 || rcn_cmp(mv, rcn_neg(eps)) < 0) {
+		rc->mad_c2 = rcn_div(rcn_sub(rcn_mul(b0, a11), rcn_mul(b1, a01)), mv);
+		rc->mad_c1 = rcn_div(rcn_sub(rcn_mul(b1, a00), rcn_mul(b0, a01)), mv);
+	} else {
+		/* JM (and the blob) divide by a01 here, not a00. */
+		rc->mad_c1 = rcn_div(b0, a01);
+	}
+out:
+	rc->p_mad_c1 = rc->mad_c1;
+	rc->p_mad_c2 = rc->mad_c2;
+}
+
+/* Window size from the MAD ratio of the last two frames (1..20). */
+static int rc_window(struct rcn cur, struct rcn prev, bool ratio_first)
+{
+	struct rcn r;
+
+	if (rcn_cmp(cur, prev) > 0)
+		r = ratio_first ? rcn_mul(rcn_div(prev, cur), rcn_int(20)) :
+				  rcn_div(rcn_mul(prev, rcn_int(20)), cur);
+	else
+		r = ratio_first ? rcn_mul(rcn_div(cur, prev), rcn_int(20)) :
+				  rcn_div(rcn_mul(cur, rcn_int(20)), prev);
+
+	return (int)rcn_trunc(r);
+}
+
+static void rc_update_mad_model(struct cedrus_enc_rc *rc)
+{
+	struct rcn err[RC_WINDOW_MAX], std = rcn_int(0), thr2;
+	bool rej[RC_WINDOW_MAX] = { false };
+	int nc = rc->coded_p_frames, i, w, lim;
+
+	if (nc < 1)
+		return;
+
+	for (i = CEDRUS_RC_HIST - 2; i > 0; i--) {
+		rc->p_picture_mad[i] = rc->p_picture_mad[i - 1];
+		rc->picture_mad[i] = rc->p_picture_mad[i];
+		rc->reference_mad[i] = rc->reference_mad[i - 1];
+	}
+	rc->picture_mad[0] = rc->current_frame_mad;
+	rc->reference_mad[0] = rc->picture_mad[1];
+	rc->mad_c1 = rc->p_mad_c1;
+	rc->p_picture_mad[0] = rc->current_frame_mad;
+	rc->mad_c2 = rc->p_mad_c2;
+
+	w = rc_window(rc->current_frame_mad, rc->previous_frame_mad, false);
+	if (w < 1)
+		w = 1;
+	if (nc - 1 <= w)
+		w = nc - 1;
+	lim = rc->mad_window_size < RC_WINDOW_MAX ? rc->mad_window_size + 1 :
+						    RC_WINDOW_MAX;
+	if (lim <= w)
+		w = lim;
+	rc->mad_window_size = w;
+
+	rc->previous_frame_mad = rc->current_frame_mad;
+	rc_mad_estimator(rc, w, rej);
+	if (w >= 1) {
+		for (i = 0; i < w; i++) {
+			err[i] = rcn_sub(rcn_add(rcn_mul(rc->mad_c1,
+							 rc->reference_mad[i]),
+						 rc->mad_c2),
+					 rc->picture_mad[i]);
+			std = rcn_add(std, rcn_mul(err[i], err[i]));
+		}
+		/* The blob compares squared errors, no square root. */
+		/*
+		 * JM rejects every point with a non-zero error when the window
+		 * holds two points. A two-point fit is exact, so in the blob's
+		 * double arithmetic the outcome depends on rounding noise;
+		 * reject deterministically (point 0 is always kept below).
+		 */
+		thr2 = w == 2 ? rcn_int(0) : rcn_div(std, rcn_int(w));
+		for (i = 0; i < w; i++)
+			if (w == 2 || rcn_cmp(thr2, rcn_mul(err[i], err[i])) < 0)
+				rej[i] = true;
+	}
+	rej[0] = false;
+	rc_mad_estimator(rc, w, rej);
+}
+
+static void rc_update_model(struct cedrus_enc_rc *rc)
+{
+	struct rcn err[RC_WINDOW_MAX], std = rcn_int(0), thr2, q;
+	bool rej[RC_WINDOW_MAX] = { false };
+	int nc = rc->coded_p_frames, i, w;
+
+	rc->p_pre_header = rc->header_bits;
+	for (i = CEDRUS_RC_HIST - 2; i > 0; i--) {
+		rc->pm_rg_qp[i] = rc->pm_rg_qp[i - 1];
+		rc->m_rg_qp[i] = rc->pm_rg_qp[i];
+		rc->pm_rg_rp[i] = rc->pm_rg_rp[i - 1];
+		rc->m_rg_rp[i] = rc->pm_rg_rp[i];
+	}
+	rc->pm_rg_qp[0] = rc_qp2qstep(rc->m_qc);
+	rc->pm_rg_rp[0] = rcn_div(rcn_int(rc->texture_bits),
+				  rc->current_frame_mad);
+	rc->m_rg_qp[0] = rc->pm_rg_qp[0];
+	rc->m_rg_rp[0] = rc->pm_rg_rp[0];
+	rc->m_x1 = rc->pm_x1;
+	rc->m_x2 = rc->pm_x2;
+
+	w = rc_window(rc->current_frame_mad, rc->previous_frame_mad, true);
+	if (w < 1)
+		w = 1;
+	if (nc <= w)
+		w = nc;
+	if (rc->window_size < w)
+		w = rc->window_size + 1;
+	if (w > RC_WINDOW_MAX - 1)
+		w = RC_WINDOW_MAX;
+	rc->window_size = w;
+
+	rc_model_estimator(rc, w, rej);
+	w = rc->window_size;
+	if (w >= 1) {
+		for (i = 0; i < w; i++) {
+			q = rc->m_rg_qp[i];
+			err[i] = rcn_sub(rcn_add(rcn_div(rc->m_x1, q),
+						 rcn_div(rc->m_x2, rcn_mul(q, q))),
+					 rc->m_rg_rp[i]);
+			std = rcn_add(std, rcn_mul(err[i], err[i]));
+		}
+		/*
+		 * JM rejects every point with a non-zero error when the window
+		 * holds two points. A two-point fit is exact, so in the blob's
+		 * double arithmetic the outcome depends on rounding noise;
+		 * reject deterministically (point 0 is always kept below).
+		 */
+		thr2 = w == 2 ? rcn_int(0) : rcn_div(std, rcn_int(w));
+		for (i = 0; i < w; i++)
+			if (w == 2 || rcn_cmp(thr2, rcn_mul(err[i], err[i])) < 0)
+				rej[i] = true;
+	}
+	rej[0] = false;
+	rc_model_estimator(rc, w, rej);
+
+	if (rc->coded_p_frames < 2)
+		rc->p_picture_mad[0] = rc->current_frame_mad;
+	else
+		rc_update_mad_model(rc);
+}
+
+/* QP from the quadratic model for a bit budget. */
+static void rc_update_model_qp(struct cedrus_enc_rc *rc, int bits)
+{
+	struct rcn mad = rc->current_frame_mad, x1 = rc->m_x1, x2 = rc->m_x2;
+	struct rcn madx1 = rcn_mul(mad, x1), db = rcn_int(bits), dtmp, s, qstep;
+
+	if (rcn_is_zero(x2))
+		goto first;
+
+	dtmp = rcn_add(rcn_mul(x1, rcn_mul(mad, madx1)),
+		       rcn_mul(rcn_mul(rcn_mul(x2, rcn_int(4)), mad), db));
+	if (rcn_is_neg(dtmp))
+		goto first;
+
+	s = rcn_sqrt(dtmp);
+	if (rcn_cmp(s, rcn_mul(mad, x1)) <= 0)
+		goto first;
+
+	qstep = rcn_div(rcn_mul(mad, rcn_add(x2, x2)),
+			rcn_sub(s, rcn_mul(x1, mad)));
+	goto done;
+first:
+	qstep = rcn_div(madx1, db);
+done:
+	rc->m_qc = rc_qstep2qp(qstep);
+}
+
+static int rc_update_qp(struct cedrus_enc_rc *rc, bool intra)
+{
+	int qmin = rc->cfg.qp_min, qmax = rc->cfg.qp_max, q;
+
+	if (rc->first_frame) {
+		q = rc->cfg.init_qp;
+		rc->my_initial_qp = q;
+		rc->m_qc = q;
+		rc->curr_last_qp = q - 1;
+		rc->first_frame = false;
+		return q;
+	}
+
+	if (intra) {
+		/*
+		 * Allwinner: intra frames reuse the QP of the last P frame, so
+		 * an I frame after a brief complex scene inherits a high QP and
+		 * the GOP starts blurry. JM-style instead: the mean P QP of the
+		 * previous GOP, a little lower (I frames are referenced by the
+		 * whole GOP). The P-frame QP chain continues unchanged.
+		 */
+		q = rc->curr_last_qp;
+		if (rc->cfg.i_qp_offset >= 0 && rc->gop_p_count) {
+			q = rc_clip3(qmin, qmax,
+				     DIV_ROUND_CLOSEST(rc->gop_p_qp_sum,
+						       rc->gop_p_count) -
+				     rc->cfg.i_qp_offset);
+		} else if (!rc->gop_p_count) {
+			/*
+			 * No P frame since the last I frame (all-intra): nothing
+			 * else would ever move the QP, so follow the buffer
+			 * fullness in units of one frame's budget.
+			 */
+			int per = max_t(int, 1, (int)rcn_trunc(rcn_div(rc->bit_rate,
+							       rc->frame_rate)));
+			int dq = (int)div_s64(rc->buffer_fullness, per);
+
+			dq = rc_clip3(-rc->cfg.max_qp_change,
+				      rc->cfg.max_qp_change, dq);
+			q = rc_clip3(qmin, qmax, rc->curr_last_qp + dq);
+			rc->curr_last_qp = q;
+		}
+		rc->gop_p_qp_sum = 0;
+		rc->gop_p_count = 0;
+		rc->m_qc = q;
+		return q;
+	}
+
+	if (rc->p_pictures == 0) {
+		q = rc->curr_last_qp;
+		rc->m_qc = q;
+	} else {
+		int dq = rc->cfg.max_qp_change, mqp = rc->pm_qp;
+
+		rc->m_x1 = rc->pm_x1;
+		rc->m_x2 = rc->pm_x2;
+		rc->mad_c1 = rc->p_mad_c1;
+		rc->mad_c2 = rc->p_mad_c2;
+		rc->previous_picture_mad = rc->p_picture_mad[0];
+		rc->current_frame_mad = rcn_add(rcn_mul(rc->p_mad_c1,
+							rc->p_picture_mad[0]),
+						rc->p_mad_c2);
+
+		if (rc->target < 0) {
+			q = rc_clip3(qmin, qmax, mqp + dq);
+		} else {
+			int bits = rc->target - rc->p_pre_header;
+			int minb = (int)rcn_trunc(rcn_div(rc->bit_rate,
+						rcn_mul(rc->frame_rate, rcn_int(4))));
+
+			rc_update_model_qp(rc, bits >= minb ? bits : minb);
+			q = rc_clip3(qmin, qmax, rc->m_qc);
+			q = rc_clip3(mqp - dq, mqp + dq, q);
+		}
+		rc->m_qc = q;
+	}
+
+	rc->prev_last_qp = rc->curr_last_qp;
+	rc->curr_last_qp = q;
+	rc->pm_qp = q;
+	rc->gop_p_qp_sum += q;
+	rc->gop_p_count++;
+	return q;
+}
+
+static struct rcn rc_cfg_frame_rate(const struct cedrus_enc_rc_config *cfg)
+{
+	return rcn_div(rcn_int(cfg->fps_num), rcn_int(cfg->fps_den));
+}
+
+/* New budget window of np P frames (+ the I frame if intra). */
+static void rc_allocate(struct cedrus_enc_rc *rc, int frames, int np)
+{
+	struct rcn per_frame;
+	int a;
+
+	rc->lower_bound = (int)rcn_trunc(rcn_add(rcn_int(rc->remaining_bits),
+						 rcn_div(rc->bit_rate,
+							 rc->frame_rate)));
+	rc->upper_bound1 = (int)rcn_trunc(rcn_add(rcn_int(rc->remaining_bits),
+						  rcn_mul(rc->bit_rate,
+							  rcn_div(rcn_int(2048),
+								  rcn_int(1000)))));
+
+	/* Rate changes take effect at the next allocation. */
+	rc->bit_rate = rcn_int(rc->cfg.bitrate);
+	rc->frame_rate = rc_cfg_frame_rate(&rc->cfg);
+
+	per_frame = rcn_div(rcn_mul(rcn_int(frames), rc->bit_rate),
+			    rc->frame_rate);
+	a = (int)rcn_dfloor(rcn_add(per_frame, rc_half()));
+
+	rc->remaining_bits = rc_clamp_carry(rc->remaining_bits, a) + a;
+	rc->np = np;
+	rc->total_p_frames = np;
+	rc->p_pictures = 0;
+}
+
+int cedrus_enc_rc_frame_qp(struct cedrus_enc_rc *rc, bool intra)
+{
+	int q;
+
+	if (rc->cfg.gop == 0) {
+		/* "Virtual GOP" of 8 frames without periodic I frames. */
+		if (intra)
+			rc_allocate(rc, 8, 7);
+		else if (rc->np <= 0)
+			rc_allocate(rc, 8, 8);
+	} else if (intra) {
+		int np = rc->cfg.gop - 1;
+
+		rc_allocate(rc, rc->cfg.gop, np);
+	}
+
+	if (!intra) {
+		struct rcn brfr, t;
+		int target, tmp;
+
+		if (rc->p_pictures == 1) {
+			/* s64 division, truncating like the blob */
+			rc->delta_p = rcn_int(rc->total_p_frames > 1 ?
+					      div_s64(rc->buffer_fullness,
+						      rc->total_p_frames - 1) : 0);
+			rc->target_buffer_level =
+				rcn_sub(rcn_int(rc->buffer_fullness),
+					rc->delta_p);
+		} else if (rc->p_pictures > 1) {
+			rc->target_buffer_level =
+				rcn_sub(rc->target_buffer_level, rc->delta_p);
+		}
+
+		brfr = rcn_div(rc->bit_rate, rc->frame_rate);
+		target = (int)rcn_dfloor(rcn_add(
+			rcn_div(rcn_mul(rcn_int(rc->remaining_bits), rc->wp),
+				rcn_mul(rcn_int(max_t(int, rc->np, 1)), rc->wp)),
+			rc_half()));
+		t = rcn_add(rcn_sub(brfr,
+				    rcn_mul(rcn_sub(rcn_int(rc->buffer_fullness),
+						    rc->target_buffer_level),
+					    rc->gammap)),
+			    rc_half());
+		tmp = (int)rcn_dfloor(t);
+		if (tmp < 0)
+			tmp = 0;
+		target = (int)rcn_dfloor(rcn_add(rcn_add(rcn_int(tmp),
+				rcn_mul(rcn_int((s64)target - tmp), rc->betap)),
+				rc_half()));
+		rc->target = rc_clip3(rc->lower_bound, rc->upper_bound2, target);
+	}
+
+	rc->header_bits = 0;
+	rc->texture_bits = 0;
+
+	q = rc_update_qp(rc, intra);
+	return rc_clip3(rc->cfg.qp_min, rc->cfg.qp_max, q);
+}
+
+void cedrus_enc_rc_frame_done(struct cedrus_enc_rc *rc, bool intra, int qp,
+			      u32 frame_bits, u32 texture_bits,
+			      u32 header_bits, u32 mad_sum)
+{
+	struct rcn f;
+	int avg, delta;
+
+	/* The model must learn from the QP that was really used. */
+	rc->m_qc = qp;
+
+	rc->header_bits = header_bits;
+	rc->texture_bits = texture_bits;
+	rc->current_frame_mad = rcn_div(rcn_int(mad_sum),
+					rcn_int((s64)rc->cfg.width *
+						rc->cfg.height));
+
+	if (!intra) {
+		rc->wp = rcn_int(rcn_dfloor(rcn_add(rcn_int((s64)rc->m_qc *
+							    frame_bits),
+						    rc_half())));
+		rc->np--;
+		rc->coded_p_frames++;
+		rc->p_pictures++;
+	}
+
+	avg = (int)rcn_dfloor(rcn_add(rcn_div(rc->bit_rate, rc->frame_rate),
+				      rc_half()));
+	delta = (int)frame_bits - avg;
+	rc->remaining_bits -= frame_bits;
+	rc->buffer_fullness += delta;
+
+	/* Buffer fullness is clamped to one second of bits (Allwinner). */
+	f = rcn_int(rc->buffer_fullness);
+	if (rcn_cmp(f, rcn_neg(rc->bit_rate)) < 0)
+		rc->buffer_fullness = -rcn_trunc(rc->bit_rate);
+	else if (rcn_cmp(rc->bit_rate, f) < 0)
+		rc->buffer_fullness = rcn_trunc(rc->bit_rate);
+
+	rc->lower_bound -= delta;
+	rc->upper_bound1 -= delta;
+	rc->upper_bound2 = (int)rcn_trunc(rcn_mul(rcn_int(rc->upper_bound1),
+						  rc_0_9f()));
+
+	if (!intra)
+		rc_update_model(rc);
+}
+
+void cedrus_enc_rc_set_config(struct cedrus_enc_rc *rc,
+			      const struct cedrus_enc_rc_config *cfg)
+{
+	rc->cfg = *cfg;
+}
+
+int cedrus_enc_rc_init(struct cedrus_enc_rc *rc,
+		       const struct cedrus_enc_rc_config *cfg)
+{
+	int i;
+
+	memset(rc, 0, sizeof(*rc));
+	rc->cfg = *cfg;
+	if (!rc->cfg.fps_num || !rc->cfg.fps_den) {
+		rc->cfg.fps_num = 30;
+		rc->cfg.fps_den = 1;
+	}
+
+	rc->previous_frame_mad = rcn_int(1);
+	rc->current_frame_mad = rcn_int(1);
+	rc->upper_bound1 = 0x7fffffff;
+	rc->upper_bound2 = 0x7fffffff;
+	rc->bit_rate = rcn_int(cfg->bitrate);
+	rc->frame_rate = rc_cfg_frame_rate(&rc->cfg);
+	rc->gammap = rc_half();
+	rc->betap = rc_half();
+	rc->pm_x1 = rc->bit_rate;
+	rc->pm_x2 = rcn_int(0);
+	rc->p_mad_c1 = rcn_int(1);
+	rc->p_mad_c2 = rcn_int(0);
+	for (i = 0; i < CEDRUS_RC_HIST; i++) {
+		rc->pm_rg_qp[i] = rcn_int(0);
+		rc->pm_rg_rp[i] = rcn_int(0);
+		rc->p_picture_mad[i] = rcn_int(0);
+	}
+
+	if (!rc->cfg.init_qp) {
+		struct rcn bpp = rcn_div(rc->bit_rate,
+					 rcn_mul(rcn_mul(rcn_int(cfg->width),
+							 rc->frame_rate),
+						 rcn_int(cfg->height)));
+		struct rcn bpp100 = rcn_mul(bpp, rcn_int(100));
+		int qp;
+
+		/* thresholds 0.05 / 0.3 / 0.6 bits per pixel */
+		if (rcn_cmp(bpp100, rcn_int(5)) <= 0)
+			qp = 35;
+		else if (rcn_cmp(bpp100, rcn_int(30)) <= 0)
+			qp = (int)rcn_trunc(rcn_sub(rcn_int(35),
+				/* (bpp - 0.05) * 40 = (bpp100 - 5) * 0.4 */
+				rcn_mul(rcn_sub(bpp100, rcn_int(5)),
+					rcn_div(rcn_int(4), rcn_int(10)))));
+		else if (rcn_cmp(bpp100, rcn_int(60)) <= 0)
+			qp = 20;
+		else
+			qp = 10;
+		rc->cfg.init_qp = qp;
+	}
+
+	rc->cfg.init_qp = rc_clip3(rc->cfg.qp_min, rc->cfg.qp_max,
+				   rc->cfg.init_qp);
+	rc->first_frame = true;
+	return rc->cfg.init_qp;
+}
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.h
new file mode 100644
index 000000000..bb36379b9
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_rc.h
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus VPU driver — H.264 encoder frame-level rate control.
+ *
+ * Port of the rate control in Allwinner's A20 libvencoder (the H.264 JM
+ * quadratic model, RC mode 2, frame layer, with Allwinner's clamps), with
+ * three software bugs fixed: integer frame rate, and the double budget
+ * allocation / exhausted P-frame count of the GOP = 0 "virtual GOP".
+ * Validated off-board against a bit-exact model of the blob's rate
+ * control.
+ */
+
+#ifndef _CEDRUS_ENC_RC_H_
+#define _CEDRUS_ENC_RC_H_
+
+#include "cedrus_enc_rc_num.h"
+
+#define CEDRUS_RC_HIST	21
+
+struct cedrus_enc_rc_config {
+	u32	bitrate;		/* bit/s */
+	u32	fps_num;		/* frame rate = fps_num / fps_den */
+	u32	fps_den;
+	u32	gop;			/* I-frame period, 0 = only the first */
+	u32	width;			/* 16-aligned picture size */
+	u32	height;
+	int	qp_min;
+	int	qp_max;
