[Unit]
Description=Cubietruck AP6210 Bluetooth bring-up, gated on the 32 kHz crystal
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=exec
Restart=on-failure
RestartSec=30
ExecStart=/usr/local/sbin/cubietruck-bt

[Install]
WantedBy=multi-user.target
